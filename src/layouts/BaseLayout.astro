---
import '../styles/global.css';
import { getCanonicalUrl, SITE_NAME, DEFAULT_OG_IMAGE } from '../lib/seo';
import { getHreflangLinks, LOCALE_CONFIG, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  path: string;
  locale?: Locale;
  jsonLd?: object[];
  robots?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  path,
  locale = 'en',
  jsonLd = [],
  robots = 'index, follow',
  ogType = 'website',
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = title || 'YouTube Banner Maker — Correct on Every Device',
} = Astro.props;

const canonicalUrl = getCanonicalUrl(path);
const hreflangLinks = getHreflangLinks(path);
const locConfig = LOCALE_CONFIG[locale] || LOCALE_CONFIG.en;
const is404 = path === '/404' || path.endsWith('/404');
---

<!doctype html>
<html lang={locConfig.htmlLang} data-theme="light" data-palette="pearl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script id="theme-boot" is:inline>
      (function () {
        try {
          var t = localStorage.getItem('ytbm-theme');
          var isDark = t === 'dark';
          if (isDark) {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
          }
          var p = localStorage.getItem('ytbm-palette') || 'pearl';
          if (p) {
            document.documentElement.setAttribute('data-palette', p);
          }
        } catch (e) {}

        if (typeof document !== 'undefined') {
          document.addEventListener('DOMContentLoaded', function () {
            try {
              var isCurrentlyDark = document.documentElement.getAttribute('data-theme') === 'dark' || document.documentElement.classList.contains('dark');
              document.querySelectorAll('.theme-toggle-input').forEach(function (toggle) {
                toggle.checked = isCurrentlyDark;
              });
              var activePal = localStorage.getItem('ytbm-palette') || 'pearl';
              if (document.body && activePal) {
                document.body.setAttribute('data-palette', activePal);
              }
              var btn = document.querySelector('button[data-palette-id="' + activePal + '"]');
              if (btn) {
                var color = btn.getAttribute('data-palette-color');
                var name = btn.getAttribute('data-palette-name');
                if (color) {
                  document.querySelectorAll('.palette-active-dot').forEach(function (d) { d.style.backgroundColor = color; });
                }
                if (name) {
                  document.querySelectorAll('.palette-label').forEach(function (l) { l.textContent = name; });
                }
                document.querySelectorAll('.palette-check').forEach(function (c) {
                  var m = c.getAttribute('data-check') === activePal;
                  c.classList.toggle('opacity-100', m);
                  c.classList.toggle('opacity-0', !m);
                });
              }
            } catch (e) {}
          });

          document.addEventListener('click', function (e) {
            document.querySelectorAll('.palette-dropdown[open]').forEach(function (det) {
              if (!det.contains(e.target)) {
                det.removeAttribute('open');
              }
            });
          });
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {!is404 && <link rel="canonical" href={canonicalUrl} />}
    {
      hreflangLinks.map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.href} />
      ))
    }
    <meta name="robots" content={robots} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={locConfig.ogLocale} />
    {!is404 && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    {!is404 && <meta name="twitter:url" content={canonicalUrl} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Sora, Inter, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data -->
    {
      jsonLd.map((schema) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col bg-surface-0 text-ink-950 antialiased selection:bg-accent/10 selection:text-accent relative">
    <!-- Ambient Artisanal Gradient Background Animation (Zero-JS, 60fps GPU) -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
      <div class="oklch-gradient-bg absolute inset-0 w-full h-full" />
      <div class="craft-orb craft-orb-1 absolute -top-24 -left-20 w-[500px] h-[500px] rounded-full blur-[90px] opacity-50 dark:opacity-40" />
      <div class="craft-orb craft-orb-2 absolute top-1/4 -right-24 w-[550px] h-[550px] rounded-full blur-[90px] opacity-45 dark:opacity-35" />
      <div class="craft-orb craft-orb-3 absolute -bottom-24 left-1/3 w-[600px] h-[600px] rounded-full blur-[90px] opacity-40 dark:opacity-35" />
    </div>

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-5 focus:py-2.5 focus:bg-ink-950 focus:text-surface-0 focus:rounded-full focus:shadow-md focus:text-sm focus:font-medium transition-all"
    >
      Skip to content
    </a>

    <div class="relative z-1 flex flex-col flex-1">
      <slot />
    </div>
  </body>
</html>
