---
import { PALETTES } from '../lib/palette';
---

<div class="relative inline-block text-left palette-picker-wrapper">
  <details class="palette-dropdown group relative">
    <summary
      class="min-h-[38px] px-2.5 xl:px-3 py-1.5 rounded-full border border-line-200 hover:border-ink-500 bg-surface-0 hover:bg-surface-50 text-ink-800 flex items-center gap-1.5 xl:gap-2 text-xs font-medium transition-all focus-visible:outline-accent cursor-pointer list-none select-none shadow-2xs active:scale-[0.98]"
      aria-label="Select color palette"
    >
      <svg class="w-3.5 h-3.5 text-ink-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4 5 5 0 014-4h4a4 4 0 014 4 5 5 0 01-4 4H7z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3a9 9 0 019 9 4.5 4.5 0 01-4.5 4.5h-1a2.5 2.5 0 00-2.5 2.5 1 1 0 01-2 0 4.5 4.5 0 014.5-4.5h1A2.5 2.5 0 0019 12a7 7 0 10-14 0c0 1.05.21 2.05.6 2.96" />
      </svg>
      <span class="palette-active-dot w-2.5 h-2.5 rounded-full bg-accent border border-black/10 shrink-0 transition-colors" style="background-color: #F62440"></span>
      <span class="palette-label hidden 2xl:inline text-ink-800">Warm Pearl</span>
      <svg class="w-3 h-3 text-ink-400 transition-transform duration-150 group-open:rotate-180 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>

    <div
      class="absolute right-0 mt-1.5 w-56 rounded-2xl bg-surface-0 border border-line-200 shadow-overlay p-1.5 z-50 focus:outline-none"
      role="menu"
      aria-orientation="vertical"
      tabindex="-1"
    >
      <div class="px-2.5 py-1.5 border-b border-line-100 mb-1 flex items-center justify-between">
        <p class="text-[11px] font-semibold tracking-wider uppercase text-ink-400">Color Palette</p>
        <span class="text-[10px] font-mono text-ink-500 tabular-nums">{PALETTES.length} Curated</span>
      </div>
      <div class="space-y-0.5" role="none">
        {
          PALETTES.map((p) => {
            const clickHandler = `document.documentElement.setAttribute('data-palette','${p.id}');document.body.setAttribute('data-palette','${p.id}');document.documentElement.style.setProperty('--color-accent','${p.accentColor}','important');document.documentElement.style.setProperty('--color-accent-hover','${p.accentHover}','important');document.documentElement.style.setProperty('--color-accent-light','${p.accentLight}','important');document.body.style.setProperty('--color-accent','${p.accentColor}','important');document.body.style.setProperty('--color-accent-hover','${p.accentHover}','important');document.body.style.setProperty('--color-accent-light','${p.accentLight}','important');try{localStorage.setItem('ytbm-palette','${p.id}')}catch(e){}document.querySelectorAll('.palette-active-dot').forEach(function(d){d.style.backgroundColor='${p.accentColor}'});document.querySelectorAll('.palette-label').forEach(function(l){l.textContent='${p.name}'});document.querySelectorAll('.palette-check').forEach(function(c){var m=c.getAttribute('data-check')==='${p.id}';c.classList.toggle('opacity-100',m);c.classList.toggle('opacity-0',!m)});this.closest('details')?.removeAttribute('open');window.dispatchEvent(new CustomEvent('ytbm-palette-change',{detail:{palette:'${p.id}'}}));`;
            return (
              <button
                type="button"
                class="palette-item w-full flex items-center justify-between px-3 py-1.5 rounded-xl text-xs font-medium text-ink-800 hover:bg-surface-50 transition-all text-left cursor-pointer group/item select-none active:scale-[0.98]"
                role="menuitem"
                data-palette-id={p.id}
                data-palette-color={p.accentColor}
                data-palette-name={p.name}
                onclick={clickHandler}
              >
                <div class="flex items-center gap-2.5">
                  <span
                    class="w-3.5 h-3.5 rounded-full shrink-0 border border-black/15 shadow-2xs transition-transform group-hover/item:scale-110"
                    style={`background-color: ${p.accentColor}`}
                  />
                  <div>
                    <div class="font-medium text-ink-950 flex items-center gap-1">
                      <span>{p.name}</span>
                      {p.isDark && <span class="text-[9px] px-1 py-0.2 rounded bg-ink-950 text-surface-0">Dark</span>}
                    </div>
                    <div class="text-[10px] text-ink-500">{p.description}</div>
                  </div>
                </div>
                <svg
                  class:list={['palette-check w-3.5 h-3.5 text-accent transition-opacity', p.id === 'pearl' ? 'opacity-100' : 'opacity-0']}
                  data-check={p.id}
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </button>
            );
          })
        }
      </div>
    </div>
  </details>
</div>
