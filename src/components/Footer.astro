---
import { CANVAS, SAFE_PX, MAX_UPLOAD_BYTES } from '../lib/spec';

const maxUploadMb = Math.round(MAX_UPLOAD_BYTES / (1024 * 1024));
---

<footer class="w-full border-t border-line-200 bg-surface-50 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <h2 class="sr-only">Site Navigation &amp; Directory</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-8">
      <!-- Brand & Trust -->
      <div class="sm:col-span-2 lg:col-span-1 space-y-3">
        <div class="flex items-center gap-2 text-ink-950 font-semibold tracking-tight">
          <div class="w-6 h-6 rounded bg-ink-950 text-surface-0 flex items-center justify-center font-bold text-xs">
            YT
          </div>
          <span class="text-sm font-semibold">YouTube Banner Maker</span>
        </div>
        <p class="text-xs text-ink-600 leading-relaxed measure-prose">
          Browser-first channel art utility. Resizing, crop verification, and safe-area diagnostics powered entirely by local HTML5 Canvas.
        </p>
        <div class="pt-2">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-medium text-success bg-surface-0 border border-line-200 px-2.5 py-1 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
            100% Client-Side Privacy
          </span>
        </div>
      </div>

      <!-- Column 1: Tools -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">Tools</h3>
        <ul class="space-y-1 text-xs">
          <li>
            <a href="/tools/youtube-banner-resizer" class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              Banner Resizer (Fix Door)
            </a>
          </li>
          <li>
            <a href="/tools/youtube-banner-checker" class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              Safe Area Checker (Check Door)
            </a>
          </li>
          <li>
            <a href="/tools/youtube-banner-maker" class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              Banner Generator (Create Door)
            </a>
          </li>
          <li>
            <a href="/templates" class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              Curated Template Gallery
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 2: Guides -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">Guides</h3>
        <ul class="space-y-1 text-xs">
          <li>
            <a href="/guides/youtube-banner-size" class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              YouTube Banner Size & Specs
            </a>
          </li>
          <li>
            <a href="/guides/youtube-banner-safe-area" class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              Safe Area Math & Crop Rules
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Trust & Legal -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">Trust & Legal</h3>
        <ul class="space-y-1 text-xs">
          <li>
            <a href="/about" class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              About & Methodology
            </a>
          </li>
          <li>
            <a href="/contact" class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              Contact & Support
            </a>
          </li>
          <li>
            <a href="/privacy" class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms" class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              Terms of Service
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Specs at a Glance -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">Key Specifications</h3>
        <dl class="space-y-1.5 text-xs">
          <div class="flex justify-between py-0.5 border-b border-line-100">
            <dt class="text-ink-500">Recommended</dt>
            <dd class="font-mono text-ink-800">{CANVAS.width} × {CANVAS.height} px</dd>
          </div>
          <div class="flex justify-between py-0.5 border-b border-line-100">
            <dt class="text-ink-500">Safe Area (Mobile)</dt>
            <dd class="font-mono text-ink-800">{SAFE_PX.full.width} × {SAFE_PX.full.height} px</dd>
          </div>
          <div class="flex justify-between py-0.5 border-b border-line-100">
            <dt class="text-ink-500">Max File Size</dt>
            <dd class="font-mono text-ink-800">{maxUploadMb} MB</dd>
          </div>
          <div class="flex justify-between py-0.5">
            <dt class="text-ink-500">Aspect Ratio</dt>
            <dd class="font-mono text-ink-800">16:9</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-line-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-ink-500">
      <p>
        Zero image bytes transmitted over network. No watermark. No account required.
      </p>
      <p>
        YouTube is a registered trademark of Google LLC. This tool is independently built.
      </p>
    </div>
  </div>
</footer>
