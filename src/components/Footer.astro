---
import { CANVAS, SAFE_PX, MAX_UPLOAD_BYTES } from '../lib/spec';
import { LOCALES, LOCALE_CONFIG, getLocalizedUrl, getTranslations, type Locale } from '../i18n';

interface Props {
  currentPath?: string;
  locale?: Locale;
}

const { currentPath = '/', locale = 'en' } = Astro.props;
const maxUploadMb = Math.round(MAX_UPLOAD_BYTES / (1024 * 1024));
const dict = getTranslations(locale);
---

<footer class="w-full border-t border-line-200 bg-surface-50 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <h2 class="sr-only">{dict.footer.navTitle}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-8">
      <!-- Brand & Trust -->
      <div class="sm:col-span-2 lg:col-span-1 space-y-3">
        <a href={getLocalizedUrl('/', locale)} class="flex items-center gap-2 text-ink-950 font-semibold tracking-tight hover:opacity-90 transition-opacity">
          <img src="/favicon-96x96.png" alt="YouTubeBannerMaker logo" width="24" height="24" class="w-6 h-6 rounded object-contain" />
          <span class="text-sm font-semibold">{dict.common.brandName}</span>
        </a>
        <p class="text-xs text-ink-600 leading-relaxed measure-prose">
          {dict.footer.brandDesc}
        </p>
        <div class="pt-2">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-medium text-success bg-surface-0 border border-line-200 px-2.5 py-1 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
            {dict.common.privacyBadge}
          </span>
        </div>
      </div>

      <!-- Column 1: Tools -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">{dict.footer.colTools}</h3>
        <ul class="space-y-1 text-xs">
          <li>
            <a href={getLocalizedUrl('/tools/youtube-banner-resizer', locale)} class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              {dict.footer.resizer}
            </a>
          </li>
          <li>
            <a href={getLocalizedUrl('/tools/youtube-banner-checker', locale)} class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              {dict.footer.checker}
            </a>
          </li>
          <li>
            <a href={getLocalizedUrl('/tools/youtube-banner-maker', locale)} class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              {dict.footer.generator}
            </a>
          </li>
          <li>
            <a href={getLocalizedUrl('/templates', locale)} class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              {dict.footer.templateGallery}
            </a>
          </li>
          <li>
            <a href={getLocalizedUrl('/backgrounds', locale)} class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              {dict.footer.backgroundsGallery}
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 2: Guides -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">{dict.footer.colGuides}</h3>
        <ul class="space-y-1 text-xs">
          <li>
            <a href={getLocalizedUrl('/guides/how-to-make-a-youtube-banner', locale)} class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              {dict.footer.guideHowToMake}
            </a>
          </li>
          <li>
            <a href={getLocalizedUrl('/guides/how-to-choose-a-youtube-banner-template', locale)} class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              {dict.footer.guideBestTemplates}
            </a>
          </li>
          <li>
            <a href={getLocalizedUrl('/guides/youtube-banner-size', locale)} class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              {dict.footer.guideSize}
            </a>
          </li>
          <li>
            <a href={getLocalizedUrl('/guides/youtube-banner-safe-area', locale)} class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              {dict.footer.guideSafeArea}
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Trust & Legal -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">{dict.footer.colTrust}</h3>
        <ul class="space-y-1 text-xs">
          <li>
            <a href={getLocalizedUrl('/about', locale)} class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              {dict.footer.about}
            </a>
          </li>
          <li>
            <a href={getLocalizedUrl('/contact', locale)} class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              {dict.footer.contact}
            </a>
          </li>
          <li>
            <a href={getLocalizedUrl('/privacy', locale)} class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              {dict.footer.privacy}
            </a>
          </li>
          <li>
            <a href={getLocalizedUrl('/terms', locale)} class="inline-flex items-center min-h-[44px] sm:min-h-0 py-1 text-ink-600 hover:text-ink-950 transition-colors">
              {dict.footer.terms}
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Specs at a Glance -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">{dict.footer.colSpecs}</h3>
        <dl class="space-y-1.5 text-xs">
          <div class="flex justify-between py-0.5 border-b border-line-100">
            <dt class="text-ink-500">{dict.footer.specRecommended}</dt>
            <dd class="font-mono text-ink-800 tabular-nums">{CANVAS.width} × {CANVAS.height} px</dd>
          </div>
          <div class="flex justify-between py-0.5 border-b border-line-100">
            <dt class="text-ink-500">{dict.footer.specSafeArea}</dt>
            <dd class="font-mono text-ink-800 tabular-nums">{SAFE_PX.full.width} × {SAFE_PX.full.height} px</dd>
          </div>
          <div class="flex justify-between py-0.5 border-b border-line-100">
            <dt class="text-ink-500">{dict.footer.specMaxFileSize}</dt>
            <dd class="font-mono text-ink-800 tabular-nums">{maxUploadMb} MB</dd>
          </div>
          <div class="flex justify-between py-0.5">
            <dt class="text-ink-500">{dict.footer.specAspectRatio}</dt>
            <dd class="font-mono text-ink-800 tabular-nums">16:9</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Language Cross-Links for Global SEO & User Discovery -->
    <div class="mt-8 pt-6 border-t border-line-100 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-ink-600">
      <span class="text-ink-400 font-semibold uppercase tracking-wider text-[11px]">{dict.common.languages}:</span>
      {
        LOCALES.map((loc) => {
          const cfg = LOCALE_CONFIG[loc];
          const targetUrl = getLocalizedUrl(currentPath, loc);
          const isCurrent = loc === locale;
          return (
            <a
              href={targetUrl}
              hreflang={cfg.hreflang}
              class:list={[
                'hover:text-ink-950 transition-colors inline-flex items-center gap-1',
                isCurrent ? 'font-semibold text-ink-950 underline underline-offset-4 decoration-accent' : 'text-ink-600',
              ]}
              aria-current={isCurrent ? 'true' : undefined}
            >
              <span aria-hidden="true">{cfg.flag}</span>
              <span>{cfg.nativeName}</span>
            </a>
          );
        })
      }
    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 pt-6 border-t border-line-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-ink-500">
      <p>
        {dict.footer.zeroTransmitted}
      </p>
      <p>
        {dict.footer.trademark}
      </p>
    </div>
  </div>
</footer>
