---
import { CANVAS, DEVICES, SAFE_PX, type DeviceKey } from '../lib/spec';

const devices: Array<{
  key: DeviceKey;
  label: string;
  dimensions: string;
  isDefault?: boolean;
}> = [
  {
    key: 'mobile',
    label: 'Mobile Safe Area',
    dimensions: `${SAFE_PX.full.width} × ${SAFE_PX.full.height}`,
    isDefault: true,
  },
  {
    key: 'desktop',
    label: 'Desktop',
    dimensions: `${Math.round(DEVICES.desktop.w * CANVAS.width)} × ${Math.round(DEVICES.desktop.h * CANVAS.height)}`,
  },
  {
    key: 'tablet',
    label: 'Tablet',
    dimensions: `${Math.round(DEVICES.tablet.w * CANVAS.width)} × ${Math.round(DEVICES.tablet.h * CANVAS.height)}`,
  },
  {
    key: 'tv',
    label: 'TV / Base',
    dimensions: `${CANVAS.width} × ${CANVAS.height}`,
  },
];
---

<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 pb-2">
  <div>
    <span class="text-xs font-semibold text-ink-950 uppercase tracking-wider">Device Crop Preview</span>
    <p class="text-[11px] text-ink-500">Select a viewport to inspect safe crops and safe-area boundaries.</p>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <!-- Action controls: Undo, Redo, Shortcuts -->
    <div class="inline-flex items-center p-1 bg-surface-50 border border-line-200 rounded-lg gap-0.5">
      <button
        type="button"
        id="btn-undo"
        title="Undo (Ctrl+Z / Cmd+Z)"
        disabled
        class="min-h-[44px] min-w-[44px] px-3 rounded-md text-xs font-medium text-ink-600 hover:text-ink-950 disabled:opacity-40 disabled:cursor-not-allowed hover:bg-surface-0 transition-all flex items-center justify-center gap-1 cursor-pointer focus-visible:outline-accent"
        aria-label="Undo last action"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a5 5 0 015 5v2m0 0l-4-4m4 4l4-4" />
        </svg>
        <span class="hidden sm:inline">Undo</span>
      </button>

      <button
        type="button"
        id="btn-redo"
        title="Redo (Ctrl+Y / Cmd+Shift+Z)"
        disabled
        class="min-h-[44px] min-w-[44px] px-3 rounded-md text-xs font-medium text-ink-600 hover:text-ink-950 disabled:opacity-40 disabled:cursor-not-allowed hover:bg-surface-0 transition-all flex items-center justify-center gap-1 cursor-pointer focus-visible:outline-accent"
        aria-label="Redo last action"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 10H11a5 5 0 00-5 5v2m0 0l4-4m-4 4l-4-4" />
        </svg>
        <span class="hidden sm:inline">Redo</span>
      </button>

      <button
        type="button"
        id="btn-shortcuts"
        title="Keyboard Shortcuts (?)"
        class="min-h-[44px] min-w-[44px] px-3 rounded-md text-xs font-medium text-ink-600 hover:text-ink-950 hover:bg-surface-0 transition-all flex items-center justify-center gap-1 cursor-pointer focus-visible:outline-accent"
        aria-label="View keyboard shortcuts"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
        </svg>
        <span class="hidden lg:inline">Keys</span>
      </button>
    </div>

    <!-- Device Viewport Tabs -->
    <div
      id="device-tabs"
      role="tablist"
      aria-label="Device Preview Viewports"
      class="inline-flex p-1 bg-surface-50 border border-line-200 rounded-lg max-w-full overflow-x-auto"
    >
      {
        devices.map((d, index) => (
          <button
            type="button"
            role="tab"
            id={`tab-${d.key}`}
            data-device={d.key}
            aria-selected={d.isDefault ? 'true' : 'false'}
            aria-controls="editor-canvas"
            tabindex={d.isDefault ? '0' : '-1'}
            class:list={[
              'relative px-3 py-2 rounded-md text-xs font-medium transition-all inline-flex items-center gap-1.5 whitespace-nowrap min-h-[44px] cursor-pointer focus-visible:ring-2 focus-visible:ring-accent',
              d.isDefault
                ? 'bg-surface-0 text-ink-950 shadow-xs font-semibold'
                : 'text-ink-600 hover:text-ink-950 hover:bg-surface-0/60',
            ]}
          >
            <span>{d.label}</span>
            <kbd class="hidden sm:inline-block px-1 py-0.5 text-[9px] font-mono rounded bg-surface-100/80 border border-line-200/80 text-ink-500">
              {index + 1}
            </kbd>
            <span class="font-mono text-[10px] text-ink-500 hidden xl:inline">
              ({d.dimensions})
            </span>
          </button>
        ))
      }
    </div>
  </div>
</div>
