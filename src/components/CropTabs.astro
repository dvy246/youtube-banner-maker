---
import { CANVAS, DEVICES, SAFE_PX, type DeviceKey } from '../lib/spec';
import { getTranslations, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getTranslations(locale).toolUi.cropTabs;

const devices: Array<{
  key: DeviceKey;
  label: string;
  dimensions: string;
  isDefault?: boolean;
}> = [
  {
    key: 'mobile',
    label: t.mobile,
    dimensions: `${SAFE_PX.full.width} × ${SAFE_PX.full.height}`,
    isDefault: true,
  },
  {
    key: 'desktop',
    label: t.desktop,
    dimensions: `${Math.round(DEVICES.desktop.w * CANVAS.width)} × ${Math.round(DEVICES.desktop.h * CANVAS.height)}`,
  },
  {
    key: 'tablet',
    label: t.tablet,
    dimensions: `${Math.round(DEVICES.tablet.w * CANVAS.width)} × ${Math.round(DEVICES.tablet.h * CANVAS.height)}`,
  },
  {
    key: 'tv',
    label: t.tv,
    dimensions: `${CANVAS.width} × ${CANVAS.height}`,
  },
];
---

<div class="flex flex-wrap items-center gap-2 pb-2">
  <!-- Action controls: Undo, Redo, Shortcuts -->
    <div class="inline-flex items-center p-1 bg-surface-50 border border-line-200 rounded-full gap-0.5">
      <button
        type="button"
        id="btn-undo"
        title="Undo (Ctrl+Z / Cmd+Z)"
        disabled
        class="min-h-[44px] min-w-[44px] px-3.5 rounded-full text-xs font-medium text-ink-600 hover:text-ink-950 disabled:opacity-40 disabled:cursor-not-allowed hover:bg-surface-0 active:scale-[0.98] transition-all flex items-center justify-center gap-1 cursor-pointer focus-visible:outline-accent"
        aria-label={t.undo}
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a5 5 0 015 5v2m0 0l-4-4m4 4l4-4" />
        </svg>
        <span class="hidden sm:inline">{t.undo}</span>
      </button>

      <button
        type="button"
        id="btn-redo"
        title="Redo (Ctrl+Y / Cmd+Shift+Z)"
        disabled
        class="min-h-[44px] min-w-[44px] px-3.5 rounded-full text-xs font-medium text-ink-600 hover:text-ink-950 disabled:opacity-40 disabled:cursor-not-allowed hover:bg-surface-0 active:scale-[0.98] transition-all flex items-center justify-center gap-1 cursor-pointer focus-visible:outline-accent"
        aria-label={t.redo}
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 10H11a5 5 0 00-5 5v2m0 0l4-4m-4 4l-4-4" />
        </svg>
        <span class="hidden sm:inline">{t.redo}</span>
      </button>

      <button
        type="button"
        id="btn-shortcuts"
        title="Keyboard Shortcuts (?)"
        class="min-h-[44px] min-w-[44px] px-3.5 rounded-full text-xs font-medium text-ink-600 hover:text-ink-950 hover:bg-surface-0 active:scale-[0.98] transition-all flex items-center justify-center gap-1 cursor-pointer focus-visible:outline-accent"
        aria-label={t.keys}
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
        </svg>
        <span class="hidden lg:inline">{t.keys}</span>
      </button>

      <a
        href="#tool-sidebar"
        class="lg:hidden min-h-[44px] px-3.5 rounded-full text-xs font-semibold bg-surface-50 hover:bg-surface-0 text-ink-950 border border-line-200 transition-all inline-flex items-center gap-1.5 active:scale-[0.98] shadow-2xs"
        aria-label="Scroll to controls"
      >
        <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
        <span>Controls</span>
      </a>
    </div>

    <!-- Device Viewport Tabs -->
    <div
      id="device-tabs"
      role="tablist"
      aria-label={t.ariaLabel}
      class="inline-flex p-1 bg-surface-50 border border-line-200 rounded-full max-w-full overflow-x-auto"
    >
      {
        devices.map((d, index) => (
          <button
            type="button"
            role="tab"
            id={`tab-${d.key}`}
            data-device={d.key}
            aria-selected={d.isDefault ? 'true' : 'false'}
            aria-controls="editor-canvas"
            tabindex={d.isDefault ? '0' : '-1'}
            class:list={[
              'relative px-3.5 py-2 rounded-full text-xs font-medium transition-all inline-flex items-center gap-1.5 whitespace-nowrap min-h-[44px] cursor-pointer focus-visible:ring-2 focus-visible:ring-accent active:scale-[0.98]',
              d.isDefault
                ? 'bg-surface-0 text-ink-950 shadow-xs font-semibold'
                : 'text-ink-600 hover:text-ink-950 hover:bg-surface-0/60',
            ]}
          >
            <span>{d.label}</span>
            <kbd class="hidden sm:inline-block px-1 py-0.5 text-[9px] font-mono rounded bg-surface-100/80 border border-line-200/80 text-ink-500">
              {index + 1}
            </kbd>
            <span class="font-mono text-[10px] text-ink-500 hidden xl:inline">
              ({d.dimensions})
            </span>
          </button>
        ))
      }
    </div>
</div>

