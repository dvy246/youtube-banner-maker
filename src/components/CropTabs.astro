---
import { CANVAS, DEVICES, SAFE_PX, type DeviceKey } from '../lib/spec';

const devices: Array<{
  key: DeviceKey;
  label: string;
  dimensions: string;
  isDefault?: boolean;
}> = [
  {
    key: 'mobile',
    label: 'Mobile Safe Area',
    dimensions: `${SAFE_PX.full.width} × ${SAFE_PX.full.height}`,
    isDefault: true,
  },
  {
    key: 'desktop',
    label: 'Desktop',
    dimensions: `${Math.round(DEVICES.desktop.w * CANVAS.width)} × ${Math.round(DEVICES.desktop.h * CANVAS.height)}`,
  },
  {
    key: 'tablet',
    label: 'Tablet',
    dimensions: `${Math.round(DEVICES.tablet.w * CANVAS.width)} × ${Math.round(DEVICES.tablet.h * CANVAS.height)}`,
  },
  {
    key: 'tv',
    label: 'TV / Base',
    dimensions: `${CANVAS.width} × ${CANVAS.height}`,
  },
];
---

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 pb-2">
  <div>
    <span class="text-xs font-semibold text-ink-950 uppercase tracking-wider">Device Crop Preview</span>
    <p class="text-[11px] text-ink-500">Select a viewport to inspect safe crops and safe-area boundaries.</p>
  </div>

  <div
    id="device-tabs"
    role="tablist"
    aria-label="Device Preview Viewports"
    class="inline-flex p-1 bg-surface-50 border border-line-200 rounded-lg max-w-full overflow-x-auto"
  >
    {
      devices.map((d) => (
        <button
          type="button"
          role="tab"
          id={`tab-${d.key}`}
          data-device={d.key}
          aria-selected={d.isDefault ? 'true' : 'false'}
          aria-controls="editor-canvas"
          tabindex={d.isDefault ? '0' : '-1'}
          class:list={[
            'relative px-3.5 py-2 rounded-md text-xs font-medium transition-all inline-flex items-center gap-1.5 whitespace-nowrap min-h-[44px] cursor-pointer focus-visible:ring-2 focus-visible:ring-accent',
            d.isDefault
              ? 'bg-surface-0 text-ink-950 shadow-xs font-semibold'
              : 'text-ink-600 hover:text-ink-950 hover:bg-surface-0/60',
          ]}
        >
          <span>{d.label}</span>
          <span class="font-mono text-[10px] text-ink-500 hidden md:inline">
            ({d.dimensions})
          </span>
        </button>
      ))
    }
  </div>
</div>
