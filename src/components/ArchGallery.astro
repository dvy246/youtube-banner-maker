---
import { getLocalizedUrl, getTranslations, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const dict = getTranslations(locale);
const t = dict.archGallery;

interface GalleryBanner {
  id: string;
  name: string;
  niche: string;
  preview: string;
}

const FEATURED_BANNERS: GalleryBanner[] = [
  {
    id: 'podcast-mindful-path',
    name: 'Mindful Path',
    niche: 'Podcast',
    preview: '/previews/podcast-mindful-path.svg',
  },
  {
    id: 'life-fashion-lookbook',
    name: 'Fashion Lookbook',
    niche: 'Lifestyle',
    preview: '/previews/life-fashion-lookbook.svg',
  },
  {
    id: 'biz-entrepreneur-impact',
    name: 'Entrepreneur Impact',
    niche: 'Business',
    preview: '/previews/biz-entrepreneur-impact.svg',
  },
  {
    id: 'biz-finance-glow',
    name: 'Finance Executive Glow',
    niche: 'Business',
    preview: '/previews/biz-finance-glow.svg',
  },
  {
    id: 'food-desi-kitchen',
    name: 'Desi Kitchen Feast',
    niche: 'Food',
    preview: '/previews/food-desi-kitchen.svg',
  },
  {
    id: 'vlog-daily-diaries',
    name: 'Daily Diaries Vlog',
    niche: 'Vlog',
    preview: '/previews/vlog-daily-diaries.svg',
  },
  {
    id: 'podcast-memphis-pop',
    name: 'Memphis Pop Podcast',
    niche: 'Podcast',
    preview: '/previews/podcast-memphis-pop.svg',
  },
];

const total = FEATURED_BANNERS.length;
const mid = Math.floor(total / 2);
---

<div
  class="relative w-full py-6 sm:py-10 flex flex-col items-center justify-center select-none overflow-hidden"
  role="region"
  aria-label="Interactive Studio Banner Arch Gallery"
>
  <!-- Ambient backdrop radial glow -->
  <div
    class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-60 dark:opacity-30 -z-10"
    aria-hidden="true"
  >
    <div class="w-[640px] sm:w-[840px] h-[280px] bg-accent/10 rounded-full blur-3xl"></div>
  </div>

  <!-- Stage container -->
  <div class="arch-stage relative w-full flex items-center justify-center">
    <div class="arch-track relative flex items-center justify-center">
      {FEATURED_BANNERS.map((banner, index) => {
        const offset = index - mid;
        const absOffset = Math.abs(offset);
        const baseZ = total - absOffset;

        return (
          <a
            href={`${getLocalizedUrl('/tools/youtube-banner-maker', locale)}?template=${banner.id}`}
            class="arch-card group"
            style={{
              '--offset': offset,
              '--abs-offset': absOffset,
              '--base-z': baseZ,
            }}
            aria-label={`Open ${banner.name} template in Banner Maker`}
          >
            <!-- Preview Image -->
            <div class="relative w-full h-full bg-surface-100 overflow-hidden">
              <img
                src={banner.preview}
                alt={`${banner.name} YouTube Banner Preview`}
                width="320"
                height="180"
                loading={absOffset <= 1 ? 'eager' : 'lazy'}
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-105"
                draggable="false"
              />

              <!-- Artisanal drafting ticks -->
              <span class="absolute top-1.5 left-2 font-mono text-[8px] text-white/50 group-hover:text-accent transition-colors pointer-events-none" aria-hidden="true">┌</span>
              <span class="absolute top-1.5 right-2 font-mono text-[8px] text-white/50 group-hover:text-accent transition-colors pointer-events-none" aria-hidden="true">┐</span>

              <!-- Category Pill -->
              <div class="absolute top-2 left-2.5 px-2 py-0.5 rounded bg-black/70 backdrop-blur-xs border border-white/15 text-[9px] font-mono font-medium uppercase tracking-wider text-white/90">
                {banner.niche}
              </div>

              <!-- Aspect ratio readout -->
              <div class="absolute bottom-2 left-2.5 px-1.5 py-0.5 rounded bg-black/60 backdrop-blur-xs text-[8px] font-mono text-white/70">
                16:9
              </div>

              <!-- Hover action badge -->
              <div class="absolute inset-0 bg-black/35 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center p-3">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-0/95 text-ink-950 font-semibold text-xs shadow-lg transform translate-y-2 group-hover:translate-y-0 transition-transform duration-200">
                  <span>{t.customize}</span>
                  <span aria-hidden="true">&rarr;</span>
                </span>
              </div>
            </div>

            <!-- Title footer on card -->
            <div class="px-3 py-2 bg-surface-0 dark:bg-surface-50 border-t border-line-200 dark:border-white/10 flex items-center justify-between gap-2">
              <span class="text-xs font-semibold text-ink-950 truncate group-hover:text-accent transition-colors">
                {banner.name}
              </span>
              <span class="text-[10px] font-mono text-ink-500 uppercase shrink-0">
                {t.safeArea}
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>

  <!-- Interactive Hint / Caption -->
  <div class="mt-6 sm:mt-8 flex items-center justify-center gap-2 text-xs text-ink-500 font-mono">
    <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
    <span>{t.hint}</span>
  </div>
</div>

<style>
  .arch-stage {
    --card-w: 280px;
    --card-h: 198px;
    --overlap: 120px;
    --y-step: 14px;
    --rotate-step: 5.2deg;
    height: calc(var(--card-h) + 64px);
  }

  .arch-track {
    width: 100%;
    height: 100%;
  }

  .arch-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--card-w);
    height: var(--card-h);
    margin-left: calc(var(--card-w) / -2);
    margin-top: calc(var(--card-h) / -2);
    border-radius: 14px;
    border: 1.5px solid var(--color-line-200, #e5e7eb);
    overflow: hidden;
    transform-origin: center bottom;
    transform: translate(
        calc(var(--offset) * var(--overlap)),
        calc(var(--abs-offset) * var(--y-step))
      )
      rotate(calc(var(--offset) * var(--rotate-step)))
      scale(1);
    z-index: var(--base-z);
    cursor: pointer;
    box-shadow:
      0 10px 24px -6px rgba(0, 0, 0, 0.12),
      0 2px 6px -2px rgba(0, 0, 0, 0.06);
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 300ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 200ms ease,
      z-index 0ms;
    will-change: transform;
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }

  .arch-card:hover,
  .arch-card:focus-visible {
    transform: translate(
        calc(var(--offset) * var(--overlap)),
        calc(var(--abs-offset) * var(--y-step) - 18px)
      )
      rotate(0deg)
      scale(1.08);
    z-index: 40;
    box-shadow:
      0 22px 38px -10px rgba(0, 0, 0, 0.22),
      0 4px 12px -2px rgba(0, 0, 0, 0.1);
    border-color: var(--color-accent, #2340b8);
    outline: none;
  }

  @media (max-width: 1024px) {
    .arch-stage {
      --card-w: 230px;
      --card-h: 165px;
      --overlap: 96px;
      --y-step: 10px;
      --rotate-step: 4.5deg;
      height: calc(var(--card-h) + 52px);
    }
  }

  @media (max-width: 768px) {
    .arch-stage {
      --card-w: 190px;
      --card-h: 138px;
      --overlap: 72px;
      --y-step: 8px;
      --rotate-step: 3.8deg;
      height: calc(var(--card-h) + 44px);
    }
  }

  @media (max-width: 520px) {
    .arch-stage {
      --card-w: 154px;
      --card-h: 114px;
      --overlap: 48px;
      --y-step: 6px;
      --rotate-step: 3.2deg;
      height: calc(var(--card-h) + 36px);
    }
  }

  @media (max-width: 400px) {
    .arch-stage {
      --card-w: 124px;
      --card-h: 92px;
      --overlap: 34px;
      --y-step: 4px;
      --rotate-step: 2.5deg;
      height: calc(var(--card-h) + 28px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arch-card {
      transition: none;
    }
    .arch-card:hover,
    .arch-card:focus-visible {
      transform: translate(
          calc(var(--offset) * var(--overlap)),
          calc(var(--abs-offset) * var(--y-step))
        )
        rotate(calc(var(--offset) * var(--rotate-step)));
    }
  }
</style>
