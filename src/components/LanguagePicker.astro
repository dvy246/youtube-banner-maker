---
import { LOCALES, LOCALE_CONFIG, getLocalizedUrl, getTranslations, type Locale } from '../i18n';

interface Props {
  currentPath: string;
  currentLocale?: Locale;
}

const { currentPath, currentLocale = 'en' } = Astro.props;
const current = LOCALE_CONFIG[currentLocale] || LOCALE_CONFIG.en;
const dict = getTranslations(currentLocale);
---

<div class="relative inline-block text-left language-picker-wrapper">
  <details class="language-dropdown group relative">
    <summary
      class="min-h-[38px] px-2.5 xl:px-3 py-1.5 rounded-full border border-line-200 hover:border-ink-500 bg-surface-0 hover:bg-surface-50 text-ink-800 flex items-center gap-1.5 text-xs font-medium transition-all focus-visible:outline-accent cursor-pointer list-none select-none shadow-2xs active:scale-[0.98]"
      aria-label={dict.common.selectLanguage}
    >
      <svg class="w-3.5 h-3.5 text-ink-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.5 3a17 17 0 000 18M12.5 3a17 17 0 010 18" />
      </svg>
      <span class="text-xs" aria-hidden="true">{current.flag}</span>
      <span class="language-label hidden 2xl:inline text-ink-800 font-medium">{current.nativeName}</span>
      <svg class="w-3 h-3 text-ink-400 transition-transform duration-150 group-open:rotate-180 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>

    <div
      class="absolute right-0 mt-1.5 w-52 rounded-2xl bg-surface-0 border border-line-200 shadow-overlay p-1.5 z-50 focus:outline-none"
      role="menu"
      aria-orientation="vertical"
      tabindex="-1"
    >
      <div class="px-2.5 py-1.5 border-b border-line-100 mb-1 flex items-center justify-between">
        <p class="text-[10px] font-semibold tracking-wider uppercase text-ink-400">{dict.common.languages}</p>
        <span class="text-[10px] font-mono text-ink-500 tabular-nums">7 Locales</span>
      </div>
      <div class="space-y-0.5" role="none">
        {
          LOCALES.map((loc) => {
            const targetUrl = getLocalizedUrl(currentPath, loc);
            const isCurrent = loc === currentLocale;
            const cfg = LOCALE_CONFIG[loc];
            return (
              <a
                href={targetUrl}
                hreflang={cfg.hreflang}
                class:list={[
                  'w-full flex items-center justify-between px-3 py-1.5 rounded-full text-xs font-medium transition-colors text-left select-none',
                  isCurrent
                    ? 'bg-accent/10 text-accent font-semibold'
                    : 'text-ink-800 hover:bg-surface-50',
                ]}
                role="menuitem"
                aria-current={isCurrent ? 'true' : undefined}
              >
                <div class="flex items-center gap-2">
                  <span class="text-xs" aria-hidden="true">{cfg.flag}</span>
                  <span class="text-ink-950 font-medium">{cfg.nativeName}</span>
                </div>
                {isCurrent && (
                  <svg class="w-3.5 h-3.5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                )}
              </a>
            );
          })
        }
      </div>
    </div>
  </details>
</div>
