---
import type { TemplateManifest } from '../lib/template';

interface Props {
  template: TemplateManifest;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'auto' | 'high' | 'low';
}

const { template, loading = 'lazy', fetchpriority = 'auto' } = Astro.props;

const formatField = (field: string) => {
  if (field === 'title') return 'Title';
  if (field === 'tagline') return 'Tagline';
  if (field === 'background.photo') return 'Photo';
  if (field === 'background.gradient') return 'Gradient';
  if (field === 'background.solid') return 'Color';
  if (field.startsWith('background.')) {
    const sub = field.replace('background.', '');
    return sub.charAt(0).toUpperCase() + sub.slice(1);
  }
  return field.charAt(0).toUpperCase() + field.slice(1);
};
---

<article class="group relative flex flex-col bg-surface-0 rounded-2xl border-2 border-line-200 overflow-hidden cursor-pointer transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1.5 hover:shadow-overlay hover:border-accent/40 active:translate-y-0 active:scale-[0.99] motion-reduce:transform-none">
  <!-- Artisanal sketch frame inner dashed boundary -->
  <div class="absolute inset-1.5 sm:inset-2 rounded-xl border border-dashed border-line-200/80 pointer-events-none transition-colors duration-300 group-hover:border-accent/30 z-10" aria-hidden="true"></div>

  <!-- Corner drafting sketch registration ticks -->
  <span class="absolute top-2 left-2.5 font-mono text-[9px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>
  <span class="absolute top-2 right-2.5 font-mono text-[9px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>
  <span class="absolute bottom-2 left-2.5 font-mono text-[9px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>
  <span class="absolute bottom-2 right-2.5 font-mono text-[9px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>

  <div class="relative w-full aspect-[16/9] bg-surface-50 border-b-2 border-line-200 overflow-hidden">
    <img
      src={template.preview}
      alt={`${template.name} YouTube Banner Template`}
      width="640"
      height="360"
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class="w-full aspect-[16/9] object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
    />
    <!-- Inset sketch mat line around preview image -->
    <div class="absolute inset-2 rounded-md border border-dashed border-white/30 pointer-events-none transition-colors duration-300 group-hover:border-accent/50" aria-hidden="true"></div>
    <!-- Corner brackets inside preview artwork -->
    <span class="absolute top-2.5 left-2.5 text-[10px] font-mono text-white/50 group-hover:text-accent transition-colors pointer-events-none leading-none select-none" aria-hidden="true">┌</span>
    <span class="absolute top-2.5 right-2.5 text-[10px] font-mono text-white/50 group-hover:text-accent transition-colors pointer-events-none leading-none select-none" aria-hidden="true">┐</span>
    <span class="absolute bottom-2.5 left-2.5 text-[10px] font-mono text-white/50 group-hover:text-accent transition-colors pointer-events-none leading-none select-none" aria-hidden="true">└</span>
    <span class="absolute bottom-2.5 right-2.5 text-[10px] font-mono text-white/50 group-hover:text-accent transition-colors pointer-events-none leading-none select-none" aria-hidden="true">┘</span>
    <div class="absolute bottom-2 right-3 px-1.5 py-0.5 rounded bg-black/75 backdrop-blur-xs border border-white/20 text-[8px] font-mono uppercase tracking-widest text-white/90 select-none">
      DRAFT · 16:9
    </div>
  </div>

  <div class="p-5 sm:p-6 flex flex-col flex-1 gap-3.5">
    <div class="flex items-center justify-between gap-2">
      <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono font-semibold tracking-wider uppercase bg-surface-50 text-ink-700 border border-line-200">
        {template.niche}
      </span>
      <span class="text-xs font-mono text-ink-400">Safe-area verified</span>
    </div>

    <div>
      <h3 class="text-lg sm:text-xl font-bold text-ink-950 tracking-tight group-hover:text-accent transition-colors">
        {template.name}
      </h3>
      {template.description && (
        <p class="text-sm text-ink-600 leading-relaxed mt-1.5 line-clamp-2">
          {template.description}
        </p>
      )}
    </div>

    <div class="flex items-center flex-wrap gap-1.5 pt-1">
      <span class="text-xs font-mono text-ink-500">Editable:</span>
      {template.editable.map((field) => (
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-surface-50 text-ink-600 border border-line-200">
          {formatField(field)}
        </span>
      ))}
    </div>

    <div class="mt-auto pt-4 grid grid-cols-2 gap-2">
      <a
        href={`/tools/youtube-banner-maker?template=${template.id}`}
        class="inline-flex items-center justify-center gap-1.5 min-h-[44px] px-3 py-2.5 rounded-xl bg-ink-950 text-surface-0 hover:bg-accent text-xs font-semibold transition-colors focus-visible:outline-accent shadow-2xs"
      >
        <span>Customize</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
      <a
        href={`/tools/youtube-banner-maker?template=${template.id}&download=1`}
        class="inline-flex items-center justify-center gap-1.5 min-h-[44px] px-3 py-2.5 rounded-xl border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-950 text-xs font-semibold transition-colors focus-visible:outline-accent"
        title="Direct free download at official 2560×1440"
      >
        <span>Free PNG ↓</span>
      </a>
    </div>
  </div>
</article>
