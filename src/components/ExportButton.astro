---
import { CANVAS, MAX_UPLOAD_BYTES } from '../lib/spec';
import { getTranslations, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getTranslations(locale).toolUi.exportBtn;
const maxUploadMb = Math.round(MAX_UPLOAD_BYTES / (1024 * 1024));
---

<section id="panel-export" class="p-4 rounded-lg border border-line-200 bg-surface-0 space-y-4">
  <div class="flex items-center justify-between border-b border-line-100 pb-2.5">
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">
        {t.title}
      </h3>
      <p class="text-[11px] text-ink-500">
        {t.subtitle}
      </p>
    </div>
    <span class="text-[10px] font-mono font-medium px-2 py-0.5 rounded-sm bg-surface-50 text-ink-600 border border-line-200">
      {t.srgbBadge}
    </span>
  </div>

  <div class="space-y-3">
    <!-- Preset & Resolution Selection -->
    <div class="space-y-1">
      <label for="export-resolution" class="block text-xs font-medium text-ink-800">
        {t.resolution}
      </label>
      <div class="relative">
        <select
          id="export-resolution"
          class="w-full h-11 min-h-[44px] px-4 pr-8 rounded-full bg-surface-0 border border-line-200 text-ink-950 text-xs font-medium appearance-none focus:outline-hidden cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
        >
          <option value="banner" selected>{t.resBanner2k}</option>
          <option value="4k">{t.resWallpaper4k}</option>
          <option value="thumbnail">{t.resThumbnail}</option>
        </select>
        <div class="absolute right-4 top-3.5 pointer-events-none text-ink-500 text-xs">
          ▼
        </div>
      </div>
    </div>

    <!-- Format Selection -->
    <div class="space-y-1">
      <label for="export-format" class="block text-xs font-medium text-ink-800">
        {t.outputFormat}
      </label>
      <div class="relative">
        <select
          id="export-format"
          class="w-full h-11 min-h-[44px] px-4 pr-8 rounded-full bg-surface-0 border border-line-200 text-ink-950 text-xs font-medium appearance-none focus:outline-hidden cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
        >
          <option value="png" selected>{t.pngLabel}</option>
          <option value="jpeg">{t.jpegLabel.replace('{maxUploadMb}', String(maxUploadMb))}</option>
          <option value="webp">{t.webpLabel}</option>
        </select>
        <div class="absolute right-4 top-3.5 pointer-events-none text-ink-500 text-xs">
          ▼
        </div>
      </div>
    </div>

    <!-- Export Action Button (Rare Accent: <=10% surface) -->
    <button
      type="button"
      id="export-button"
      class="w-full h-11 min-h-[44px] px-6 rounded-full bg-accent text-surface-0 text-[13px] font-semibold hover:bg-accent-hover active:scale-[0.98] transition-all cursor-pointer flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 shadow-xs"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
      </svg>
      <span id="export-button-text">{t.downloadBanner}</span>
    </button>

    <!-- Quick 1-Click Exports Divider & Header -->
    <div class="pt-2 border-t border-line-100 flex items-center justify-between text-[11px] font-medium text-ink-500">
      <span>1-Click Exports</span>
      <span class="text-[10px] text-ink-400 font-mono">4K · 1080p · Profile</span>
    </div>

    <!-- Export 4K Ultra HD Wallpaper Button (3840x2160) -->
    <button
      type="button"
      id="export-4k-button"
      class="w-full h-11 min-h-[44px] px-6 rounded-full bg-surface-50 border border-line-200 text-ink-950 text-[13px] font-semibold hover:bg-surface-100 active:scale-[0.98] transition-all cursor-pointer flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed focus-visible:ring-2 focus-visible:ring-accent"
      title="Export 3840×2160 Ultra HD 4K Wallpaper & TV Art"
    >
      <svg class="w-4 h-4 text-ink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      <span id="export-4k-text">{t.download4k}</span>
    </button>

    <!-- Export Thumbnail Action Button (1920x1080) -->
    <button
      type="button"
      id="export-thumbnail-button"
      class="w-full h-11 min-h-[44px] px-6 rounded-full bg-surface-50 border border-line-200 text-ink-950 text-[13px] font-semibold hover:bg-surface-100 active:scale-[0.98] transition-all cursor-pointer flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed focus-visible:ring-2 focus-visible:ring-accent"
      title={t.thumbnailTitle}
    >
      <svg class="w-4 h-4 text-ink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <span id="export-thumbnail-text">{t.downloadThumbnail}</span>
    </button>

    <!-- Export Matching Avatar Action Button (800x800) -->
    <button
      type="button"
      id="export-avatar-button"
      class="w-full h-11 min-h-[44px] px-6 rounded-full bg-surface-50 border border-line-200 text-ink-950 text-[13px] font-semibold hover:bg-surface-100 active:scale-[0.98] transition-all cursor-pointer flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed focus-visible:ring-2 focus-visible:ring-accent"
      title={t.avatarTitle}
    >
      <svg class="w-4 h-4 text-ink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span id="export-avatar-text">{t.downloadAvatar}</span>
    </button>

    <!-- Copy Image to Clipboard Button -->
    <button
      type="button"
      id="copy-clipboard-button"
      class="w-full h-11 min-h-[44px] px-6 rounded-full bg-surface-0 border border-line-200 text-ink-950 text-[13px] font-semibold hover:bg-surface-50 active:scale-[0.98] transition-all cursor-pointer flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed focus-visible:ring-2 focus-visible:ring-accent"
      title={t.copyTitle}
    >
      <svg class="w-4 h-4 text-ink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
      </svg>
      <span id="copy-clipboard-text">{t.copyClipboard}</span>
    </button>

    <!-- Export Output Specifications & Meta (REQ-026 separate labels) -->
    <div class="p-3 rounded-md bg-surface-50 border border-line-100 space-y-1">
      <div class="flex items-center justify-between text-xs">
        <span class="text-ink-500">{t.dimensions}</span>
        <span id="export-dimensions-readout" class="font-mono font-medium text-ink-950 tabular-nums">{CANVAS.width} × {CANVAS.height} px</span>
      </div>
      <div class="flex items-center justify-between text-xs">
        <span class="text-ink-500">{t.outputSize}</span>
        <span id="export-meta" class="font-mono font-medium text-ink-950 tabular-nums">{t.pending}</span>
      </div>
      <p id="export-note" class="text-[11px] text-ink-600 hidden pt-1 border-t border-line-100"></p>
    </div>
  </div>
</section>
