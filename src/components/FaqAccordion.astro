---
import { CANVAS, SAFE_PX, MAX_UPLOAD_BYTES } from '../lib/spec';

const maxMb = Math.round(MAX_UPLOAD_BYTES / (1024 * 1024));

const faqs = [
  {
    question: 'Why does my YouTube banner get cut off on mobile phones?',
    answer: `YouTube displays different portions of your banner depending on screen size. While smart TVs display the entire ${CANVAS.width} × ${CANVAS.height} px artwork, mobile devices crop away the outer edges and show only the center ${SAFE_PX.full.width} × ${SAFE_PX.full.height} px safe area. If your text, logo, or key visual elements sit outside this central zone, they will be clipped on smartphones.`,
  },
  {
    question: 'What are the required dimensions and file size limits?',
    answer: `YouTube recommends an upload size of ${CANVAS.width} × ${CANVAS.height} px with a 16:9 aspect ratio. The minimum accepted size is 2048 × 1152 px. The maximum file size limit is ${maxMb} MB. The mobile safe area where all essential elements must remain visible is ${SAFE_PX.full.width} × ${SAFE_PX.full.height} px.`,
  },
  {
    question: 'Why does YouTube re-compress my banner after upload?',
    answer: `YouTube serves banner images to millions of viewers on varying network connections. To ensure fast load times, YouTube Studio automatically re-encodes uploaded images down to approximately 134 KB for desktop devices and even smaller packages for mobile devices. Using this tool's re-encode simulation allows you to preview that compression before publishing.`,
  },
  {
    question: 'How does cover-fit resizing prevent image distortion?',
    answer: `Unlike simple stretching tools that squish or elongate your image to fit a 16:9 ratio, cover-fit scaling preserves your image's native aspect ratio. It scales your image to completely cover the ${CANVAS.width} × ${CANVAS.height} canvas without letterboxing, and lets you pan and nudge your subject safely into the mobile safe area without creating transparent borders.`,
  },
  {
    question: 'Why is this tool free with no account and no watermark?',
    answer: `This tool runs 100% in your browser using HTML5 Canvas. Because processing happens locally on your device, there are no server compute or cloud storage costs required to process your image. We believe creators deserve reliable, honest tools without artificial paywalls or watermarks.`,
  },
];
---

<div class="space-y-3" itemscope itemtype="https://schema.org/FAQPage">
  {
    faqs.map((faq, index) => (
      <details
        class="group rounded-xl border border-line-200 bg-surface-0 open:border-line-200 transition-colors"
        id={`faq-${index}`}
        itemscope
        itemprop="mainEntity"
        itemtype="https://schema.org/Question"
      >
        <summary class="flex items-center justify-between p-4 min-h-[44px] text-xs font-semibold text-ink-950 cursor-pointer select-none list-none group-hover:text-accent transition-colors">
          <span itemprop="name">{faq.question}</span>
          <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-line-200 text-ink-600 group-open:rotate-180 transition-transform text-xs" aria-hidden="true">
            ▾
          </span>
        </summary>
        <div
          class="px-4 pb-4 text-xs text-ink-600 leading-relaxed measure-prose border-t border-line-100 pt-3"
          itemscope
          itemprop="acceptedAnswer"
          itemtype="https://schema.org/Answer"
        >
          <div itemprop="text">
            {faq.answer}
          </div>
        </div>
      </details>
    ))
  }
</div>
