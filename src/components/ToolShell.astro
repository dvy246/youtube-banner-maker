---
import CropTabs from './CropTabs.astro';
import CanvasStage from './CanvasStage.astro';
import RepositionControls from './RepositionControls.astro';
import MakeControls from './MakeControls.astro';
import TemplatePickerModal from './TemplatePickerModal.astro';
import VerdictList from './VerdictList.astro';
import ExportButton from './ExportButton.astro';
import ReencodeSimulation from './ReencodeSimulation.astro';
import SpecTable from './SpecTable.astro';

interface Props {
  mode: 'make' | 'fix' | 'check';
  title: string;
  intro: string;
  showControls?: boolean;
  showExport?: boolean;
}

const {
  mode = 'fix',
  title,
  intro,
  showControls = true,
  showExport = true,
} = Astro.props;
---

<div id="tool-root" data-mode={mode} class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
  <!-- Header Title & Intro -->
  <div class="space-y-2 border-b border-line-200 pb-5">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium font-mono uppercase tracking-wider bg-surface-50 text-ink-600 border border-line-200">
        Door: {mode.toUpperCase()}
      </span>
      <span class="text-xs text-ink-500 font-medium">100% Client-Side Engine</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950">
      {title}
    </h1>
    <p class="text-sm text-ink-600 measure-prose leading-relaxed">
      {intro}
    </p>
  </div>

  <!-- <noscript> Accessibility & SEO Fallback (REQ-030) -->
  <noscript>
    <div class="p-4 rounded-lg bg-surface-50 border border-warning/50 text-ink-800 space-y-4">
      <div class="flex items-start gap-2.5">
        <span class="font-bold text-warning text-sm">⚠</span>
        <div>
          <h2 class="text-sm font-semibold text-ink-950">
            Interactive Editor Requires JavaScript
          </h2>
          <p class="text-xs text-ink-600 mt-1">
            This tool processes images entirely inside your browser using HTML5 Canvas to ensure zero image bytes ever reach a server. Because JavaScript is disabled, the interactive canvas cannot run.
          </p>
        </div>
      </div>
      <div class="pt-2">
        <h3 class="text-xs font-semibold text-ink-950 mb-2">Standard YouTube Dimensions</h3>
        <SpecTable />
      </div>
      <p class="text-xs text-ink-600">
        Review our <a href="/guides/youtube-banner-size" class="text-accent underline font-medium">YouTube Banner Size Guide</a> or learn how to calculate safe areas in our <a href="/guides/youtube-banner-safe-area" class="text-accent underline font-medium">Safe Area Guide</a>.
      </p>
    </div>
  </noscript>

  <!-- Interactive Two-Column Editor Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left / Primary Column: Previews & Diagnostics (8 cols on desktop) -->
    <div class="lg:col-span-8 space-y-6">
      <!-- Crop Switcher Tabs -->
      <CropTabs />

      <!-- Canvas Stage (Editor canvas, overlay guides, dropzone, per-device preview strip) -->
      <CanvasStage />

      <!-- Verdict Region (Rendered in left column when NOT check mode) -->
      {mode !== 'check' && <VerdictList />}
    </div>

    <!-- Right Column: Control Panels & Export (4 cols on desktop) -->
    <div class="lg:col-span-4 space-y-4">
      {
        mode === 'check' ? (
          <>
            <VerdictList />
            <div id="check-handoff-action" class="p-4 rounded-lg border border-line-200 bg-surface-0 space-y-3">
              <div class="space-y-1">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">
                  One-Click Fix Handoff
                </h3>
                <p class="text-xs text-ink-600 leading-relaxed measure-prose">
                  Need to reposition your artwork or fix safe area cutoffs? Open your uploaded banner directly in the resizer editor with your image preserved.
                </p>
              </div>
              <button
                id="handoff-fix-btn"
                type="button"
                class="w-full min-h-[44px] px-4 py-2.5 rounded-md bg-surface-0 border border-line-200 text-ink-950 text-xs font-semibold hover:bg-surface-50 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent cursor-pointer transition-colors inline-flex items-center justify-center gap-1.5"
              >
                Fix in Resizer Editor →
              </button>
            </div>
          </>
        ) : mode === 'make' ? (
          <MakeControls />
        ) : (
          <>
            {showControls && <RepositionControls />}
            <ReencodeSimulation />
            {showExport && <ExportButton />}
          </>
        )
      }
    </div>
  </div>

  <!-- Below-the-fold Static Explanatory Copy & Advisories (Server-rendered, crawlable) -->
  <div class="pt-8 border-t border-line-200 space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-4 rounded-lg border border-line-200 bg-surface-50 space-y-2">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">
          YouTube CDN Cache Advisory (REQ-014)
        </h3>
        <p class="text-xs text-ink-600 leading-relaxed measure-prose">
          When you upload your corrected banner to YouTube Studio, changes may take up to 24 hours to appear across all edge networks, caching layers, and mobile apps. If your previous banner appears to linger, clear your browser cache or test in a private browsing window.
        </p>
      </div>

      <div class="p-4 rounded-lg border border-line-200 bg-surface-50 space-y-2">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">
          Understanding YouTube's Automatic Re-Encoding
        </h3>
        <p class="text-xs text-ink-600 leading-relaxed measure-prose">
          YouTube automatically re-compresses every uploaded channel art image down to approximately 134 KB for desktop devices and smaller budgets for mobile screens. This re-encoding cannot be bypassed, which is why testing your banner with our simulation mode helps verify text contrast before uploading.
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-lg border border-line-100 bg-surface-0 text-xs text-ink-600">
      <span>
        Need to verify specific dimension numbers? Check the <a href="/guides/youtube-banner-size" class="text-accent hover:underline font-medium">YouTube Banner Size Guide</a> or explore the <a href="/guides/youtube-banner-safe-area" class="text-accent hover:underline font-medium">Safe Area Calculation Guide</a>.
      </span>
      <a href="/templates" class="text-ink-950 font-medium hover:text-accent transition-colors">
        Browse Safe Templates →
      </a>
    </div>
  </div>

  {mode === 'make' && <TemplatePickerModal />}
</div>

<!-- Mount Client Island Script (The ONLY client JS) -->
<script src="../islands/tool.ts"></script>
