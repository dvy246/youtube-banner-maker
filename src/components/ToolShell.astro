---
import CropTabs from './CropTabs.astro';
import CanvasStage from './CanvasStage.astro';
import RepositionControls from './RepositionControls.astro';
import MakeControls from './MakeControls.astro';
import TemplatePickerModal from './TemplatePickerModal.astro';
import VerdictList from './VerdictList.astro';
import ExportButton from './ExportButton.astro';
import ReencodeSimulation from './ReencodeSimulation.astro';
import SpecTable from './SpecTable.astro';
import { getTranslations, getLocalizedUrl, type Locale } from '../i18n';

interface Props {
  mode: 'make' | 'fix' | 'check';
  title: string;
  intro: string;
  showControls?: boolean;
  showExport?: boolean;
  locale?: Locale;
}

const {
  mode = 'fix',
  title,
  intro,
  showControls = true,
  showExport = true,
  locale = 'en',
} = Astro.props;

const dict = getTranslations(locale);
const t = dict.toolUi;
---

<div id="tool-root" data-mode={mode} class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
  <!-- Compact Tool Toolbar -->
  <div class="flex flex-wrap items-center gap-3 border-b border-line-200 pb-4">
    <span class="inline-flex items-center h-5 px-2 rounded text-[10px] font-mono font-bold uppercase tracking-wider bg-surface-100 text-ink-600 border border-line-200 flex-shrink-0">
      {t.toolbar.door}: {mode.toUpperCase()}
    </span>
    <h1 class="text-base font-bold tracking-tight text-ink-950 flex-1 min-w-0 truncate">
      {title}
    </h1>
    <span class="text-[11px] font-mono text-ink-500 flex-shrink-0 hidden sm:block">{t.toolbar.clientSide}</span>
  </div>
  <!-- Visually-hidden full intro for SEO / screen readers -->
  <p class="sr-only">{intro}</p>

  <!-- <noscript> Accessibility & SEO Fallback (REQ-030) -->
  <noscript>
    <div class="p-4 rounded-lg bg-surface-50 border border-warning/50 text-ink-800 space-y-4">
      <div class="flex items-start gap-2.5">
        <span class="font-bold text-warning text-sm">⚠</span>
        <div>
          <h2 class="text-sm font-semibold text-ink-950">
            {t.toolbar.noscriptTitle}
          </h2>
          <p class="text-xs text-ink-600 mt-1">
            {t.toolbar.noscriptDesc}
          </p>
        </div>
      </div>
      <div class="pt-2">
        <h3 class="text-xs font-semibold text-ink-950 mb-2">{t.toolbar.noscriptDimensions}</h3>
        <SpecTable locale={locale} />
      </div>
      <p class="text-xs text-ink-600">
        {t.toolbar.noscriptReview} <a href={getLocalizedUrl('/guides/youtube-banner-size', locale)} class="text-accent underline font-medium">{t.toolbar.sizeGuide}</a> {t.toolbar.noscriptOr} <a href={getLocalizedUrl('/guides/youtube-banner-safe-area', locale)} class="text-accent underline font-medium">{t.toolbar.safeAreaGuide}</a>.
      </p>
    </div>
  </noscript>

  <!-- Interactive Two-Column Editor Layout: Configurations on Left (4 cols), Banner Preview on Right (8 cols) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Top Stage: Canvas Preview & Crop Tabs (Order 1 on mobile, Col 5-12 Row 1 on desktop) -->
    <div class="lg:col-span-8 lg:col-start-5 lg:row-start-1 space-y-6 order-1">
      <!-- Crop Switcher Tabs -->
      <CropTabs locale={locale} />

      <!-- Canvas Stage (Editor canvas, overlay guides, dropzone, per-device preview strip) -->
      <CanvasStage locale={locale} />
    </div>

    <!-- Tool Controls & Configuration Deck (Order 2 on mobile directly below canvas, Col 1-4 Row 1-2 sticky on desktop) -->
    <aside
      id="tool-sidebar"
      aria-label="Configuration Deck"
      class="lg:col-span-4 lg:col-start-1 lg:row-start-1 lg:row-span-2 space-y-4 lg:sticky lg:top-[4.75rem] self-start order-2 lg:max-h-[calc(100vh-5.5rem)] lg:overflow-y-auto lg:overscroll-contain lg:pr-1.5 transition-all duration-200 [scrollbar-width:thin] [scrollbar-color:var(--color-line-200)_transparent] [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-line-200 hover:[&::-webkit-scrollbar-thumb]:bg-ink-300 dark:[&::-webkit-scrollbar-thumb]:bg-ink-700"
    >
      {
        mode === 'check' ? (
          <>
            <VerdictList locale={locale} />
            <div id="check-handoff-action" class="p-4 rounded-xl border border-line-200 bg-surface-0 space-y-3 shadow-2xs">
              <div class="space-y-1">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">
                  {t.handoff.title}
                </h3>
                <p class="text-xs text-ink-600 leading-relaxed measure-prose">
                  {t.handoff.desc}
                </p>
              </div>
              <button
                id="handoff-fix-btn"
                type="button"
                class="w-full min-h-[44px] px-4 py-2.5 rounded-lg bg-surface-0 border border-line-200 text-ink-950 text-xs font-semibold hover:bg-surface-50 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent cursor-pointer transition-colors inline-flex items-center justify-center gap-1.5 shadow-2xs"
              >
                {t.handoff.fixInEditor}
              </button>
            </div>
          </>
        ) : mode === 'make' ? (
          <MakeControls locale={locale} />
        ) : (
          <>
            {showControls && <RepositionControls locale={locale} />}
            <ReencodeSimulation locale={locale} />
            {showExport && <ExportButton locale={locale} />}
          </>
        )
      }
    </aside>

    <!-- Diagnostics & Explanatory Advisories (Order 3 on mobile beneath controls, Col 5-12 Row 2 on desktop) -->
    <div class="lg:col-span-8 lg:col-start-5 lg:row-start-2 space-y-6 order-3">
      <!-- Verdict Region (Rendered in right column when NOT check mode) -->
      {mode !== 'check' && <VerdictList locale={locale} />}

      <!-- Below-the-fold Static Explanatory Copy & Advisories (Server-rendered, crawlable) -->
      <div class="pt-6 border-t border-line-200 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-4 rounded-xl border border-line-200 bg-surface-50 space-y-2">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">
              {t.advisories.cdnTitle}
            </h3>
            <p class="text-xs text-ink-600 leading-relaxed measure-prose">
              {t.advisories.cdnText}
            </p>
          </div>

          <div class="p-4 rounded-xl border border-line-200 bg-surface-50 space-y-2">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">
              {t.advisories.reencodeTitle}
            </h3>
            <p class="text-xs text-ink-600 leading-relaxed measure-prose">
              {t.advisories.reencodeText}
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-xl border border-line-100 bg-surface-0 text-xs text-ink-600">
          <span>
            {t.advisories.verifyDimensions} <a href={getLocalizedUrl('/guides/youtube-banner-size', locale)} class="text-accent hover:underline font-medium">{t.advisories.sizeGuideLink}</a> {t.advisories.orExplore} <a href={getLocalizedUrl('/guides/youtube-banner-safe-area', locale)} class="text-accent hover:underline font-medium">{t.advisories.safeAreaGuideLink}</a>.
          </span>
          <a href={getLocalizedUrl('/templates', locale)} class="text-ink-950 font-medium hover:text-accent transition-colors">
            {t.advisories.browseTemplates}
          </a>
        </div>
      </div>
    </div>
  </div>

  {mode === 'make' && <TemplatePickerModal locale={locale} />}

  <!-- Embedded Client Island Translations (Zero JS bundle overhead) -->
  <script is:inline id="tool-i18n" type="application/json" set:html={JSON.stringify(t)}></script>
</div>

<!-- Mount Client Island Script (The ONLY client JS) -->
<script src="../islands/tool.ts"></script>
