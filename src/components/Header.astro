---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navItems = [
  { label: 'Fix Banner', href: '/tools/youtube-banner-resizer' },
  { label: 'Checker', href: '/tools/youtube-banner-checker' },
  { label: 'Maker', href: '/tools/youtube-banner-maker' },
  { label: 'Templates', href: '/templates' },
  { label: 'Size Guide', href: '/guides/youtube-banner-size' },
];
---

<header class="sticky top-0 z-40 w-full bg-surface-0/90 backdrop-blur-md border-b border-line-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2.5 text-ink-950 font-semibold tracking-tight hover:opacity-90 transition-opacity">
      <div class="w-7 h-7 rounded-md bg-ink-950 text-surface-0 flex items-center justify-center font-bold text-xs tracking-wider">
        YT
      </div>
      <span class="text-sm font-semibold tracking-tight">YouTube Banner Maker</span>
    </a>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main Navigation">
      {
        navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                'min-h-[44px] px-3.5 rounded-md text-[13px] font-medium transition-colors inline-flex items-center',
                isActive
                  ? 'bg-surface-50 text-ink-950 font-semibold'
                  : 'text-ink-600 hover:text-ink-950 hover:bg-surface-50/60',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Mobile quick link -->
    <div class="flex md:hidden items-center">
      <a
        href="/tools/youtube-banner-resizer"
        class="min-h-[44px] px-3.5 rounded-md bg-ink-950 text-surface-0 text-xs font-medium inline-flex items-center"
      >
        Fix Banner
      </a>
    </div>
  </div>
</header>
