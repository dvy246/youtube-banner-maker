---
import PalettePicker from './PalettePicker.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguagePicker from './LanguagePicker.astro';
import { getLocalizedUrl, getTranslations, type Locale } from '../i18n';

interface Props {
  currentPath?: string;
  locale?: Locale;
}

const { currentPath = '', locale = 'en' } = Astro.props;
const isToolPage = currentPath.includes('/tools');
const dict = getTranslations(locale);

const mainNavItems = [
  { label: dict.nav.fixBanner, href: getLocalizedUrl('/tools/youtube-banner-resizer', locale) },
  { label: dict.nav.checker, href: getLocalizedUrl('/tools/youtube-banner-checker', locale) },
  { label: dict.nav.maker, href: getLocalizedUrl('/tools/youtube-banner-maker', locale) },
  { label: dict.nav.templates, href: getLocalizedUrl('/templates', locale) },
  { label: dict.nav.backgrounds, href: getLocalizedUrl('/backgrounds', locale) },
];

const guideItems = [
  { label: dict.footer.guideHowToMake, href: getLocalizedUrl('/guides/how-to-make-a-youtube-banner', locale) },
  { label: dict.footer.guideBestTemplates, href: getLocalizedUrl('/guides/how-to-choose-a-youtube-banner-template', locale) },
  { label: dict.footer.guideSize, href: getLocalizedUrl('/guides/youtube-banner-size', locale) },
  { label: dict.footer.guideSafeArea, href: getLocalizedUrl('/guides/youtube-banner-safe-area', locale) },
];

const mobileNavItems = [...mainNavItems, ...guideItems];
---

<header class="sticky top-0 z-40 w-full bg-surface-0/80 dark:bg-[#0B0D10]/80 backdrop-blur-xl border-b border-line-200/80 shadow-[0_1px_3px_0_rgba(0,0,0,0.02)]">
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between gap-3 lg:gap-4">
    <!-- Brand -->
    <a
      href={getLocalizedUrl('/', locale)}
      class="flex items-center gap-2.5 sm:gap-3 text-ink-950 hover:opacity-95 transition-opacity shrink-0 group py-1"
      aria-label={`${dict.common.brandName} Home`}
    >
      <div class="relative w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-surface-100 border border-line-200 shadow-2xs flex items-center justify-center shrink-0 p-1 group-hover:scale-105 transition-transform duration-200">
        <img
          src="/favicon-96x96.png"
          alt={`${dict.common.brandName} logo`}
          width="32"
          height="32"
          class="w-full h-full object-contain rounded-lg"
        />
      </div>
      <div class="flex flex-col justify-center shrink-0">
        <div class="flex items-center gap-1.5 leading-none">
          <span class="text-sm sm:text-base font-bold tracking-tight text-ink-950">
            YouTube<span class="text-accent font-extrabold">Banner</span>Maker
          </span>
          <span class="hidden sm:inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-mono font-semibold uppercase tracking-wider bg-accent/10 text-accent border border-accent/20">
            Studio
          </span>
        </div>
        <span class="hidden xl:block text-[10px] font-mono text-ink-500 tracking-tight leading-tight mt-0.5">
          100% Client-Side · Safe-Area Engine
        </span>
      </div>
    </a>

    <!-- Navigation & Desktop Actions -->
    <div class="hidden lg:flex items-center gap-1.5 xl:gap-2.5 shrink-0">
      <nav class="flex items-center gap-0.5 lg:gap-1" aria-label="Main Navigation">
        {
          mainNavItems.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/' && item.href !== `/${locale}` && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class:list={[
                  'relative h-9 px-2 xl:px-2.5 text-xs xl:text-[13px] font-medium transition-colors inline-flex items-center whitespace-nowrap',
                  isActive
                    ? 'text-ink-950 font-semibold'
                    : 'text-ink-600 hover:text-ink-950',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                <span>{item.label}</span>
                {isActive && (
                  <span class="absolute bottom-0 left-2 xl:left-2.5 right-2 xl:right-2.5 h-[2px] bg-accent rounded-full" aria-hidden="true" />
                )}
              </a>
            );
          })
        }
        
        {/* Guides Dropdown */}
        <div class="relative group">
          <button class="relative h-9 px-2 xl:px-2.5 text-xs xl:text-[13px] font-medium transition-colors inline-flex items-center gap-1 text-ink-600 hover:text-ink-950 whitespace-nowrap cursor-pointer">
            <span>{dict.footer.colGuides}</span>
            <svg class="w-3.5 h-3.5 text-ink-500 group-hover:text-ink-950 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
            {currentPath.includes('/guides/') && (
              <span class="absolute bottom-0 left-2 xl:left-2.5 right-2 xl:right-2.5 h-[2px] bg-accent rounded-full" aria-hidden="true" />
            )}
          </button>
          
          <div class="absolute top-full left-0 mt-0 w-64 rounded-xl bg-surface-0 border border-line-200 shadow-overlay p-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 flex flex-col gap-0.5">
            {guideItems.map((item) => {
              const isActive = currentPath === item.href;
              return (
                <a
                  href={item.href}
                  class:list={[
                    'block px-3 py-2.5 rounded-lg text-xs font-medium transition-colors',
                    isActive ? 'bg-surface-100 text-ink-950 font-semibold' : 'text-ink-600 hover:bg-surface-50 hover:text-ink-950'
                  ]}
                >
                  {item.label}
                </a>
              );
            })}
          </div>
        </div>
      </nav>

      <div class="h-4 w-px bg-line-200" aria-hidden="true" />

      <!-- Language Selector (Pure-HTML, Zero JS) -->
      <LanguagePicker currentPath={currentPath} currentLocale={locale} />

      <!-- Dark / White Mode Slider Toggle -->
      <ThemeToggle id="theme-toggle" />

      <!-- Color Palette Picker -->
      <PalettePicker currentPath={currentPath} />

      {!isToolPage && (
        <a
          href={getLocalizedUrl('/tools/youtube-banner-resizer', locale)}
          class="hidden 2xl:inline-flex h-9 px-3.5 rounded-full bg-ink-950 text-surface-0 hover:bg-ink-800 text-xs font-medium items-center gap-1.5 transition-all shadow-xs active:scale-[0.98] border border-white/10 shrink-0"
        >
          <span>{dict.common.launchResizer}</span>
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>

    <!-- Mobile Navigation & Actions -->
    <div class="flex lg:hidden items-center gap-1 sm:gap-1.5 shrink-0">
      <LanguagePicker currentPath={currentPath} currentLocale={locale} />
      <ThemeToggle id="theme-toggle-mobile" />
      <PalettePicker currentPath={currentPath} />
      <details class="palette-dropdown group relative">
        <summary
          class="min-h-[38px] min-w-[38px] p-2 rounded-full border border-line-200 bg-surface-0 hover:bg-surface-50 text-ink-800 flex items-center justify-center cursor-pointer list-none select-none shadow-2xs active:scale-[0.98] focus-visible:outline-accent"
          aria-label={dict.common.openMobileMenu}
        >
          <svg class="w-4 h-4 text-ink-700 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <div
          class="absolute right-0 mt-1.5 w-60 max-h-[70vh] overflow-y-auto rounded-2xl bg-surface-0 border border-line-200 shadow-overlay p-2 z-50 focus:outline-none flex flex-col gap-0.5"
          role="menu"
        >
          {
            mobileNavItems.map((item) => {
              const isActive = currentPath === item.href || (item.href !== '/' && item.href !== `/${locale}` && currentPath.startsWith(item.href));
              return (
                <a
                  href={item.href}
                  class:list={[
                    'block px-3.5 py-2.5 rounded-xl text-xs font-medium transition-colors',
                    isActive ? 'bg-surface-100 text-ink-950 font-semibold' : 'text-ink-600 hover:bg-surface-50 hover:text-ink-950',
                  ]}
                  role="menuitem"
                >
                  {item.label}
                </a>
              );
            })
          }
          <div class="my-1 border-t border-line-200"></div>
          <a
            href={getLocalizedUrl('/contact', locale)}
            class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-xs font-medium text-ink-800 hover:bg-surface-50 transition-colors"
            role="menuitem"
          >
            <svg class="w-4 h-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.516 0c.85.493 1.509 1.333 1.509 2.316V18" />
            </svg>
            <span>{dict.common.suggestATool}</span>
          </a>
          <a
            href="https://ko-fi.com/divyyadav"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-xs font-medium text-[#FF5E5B] hover:bg-[#FF5E5B]/10 transition-colors"
            role="menuitem"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.022 5.86c-2.028 1.942-5.405.86-5.405.86s-.781-3.619 1.139-5.467c1.789-1.724 4.372-.638 4.372-.638s1.084 3.447-.106 5.245zm6.84-2.584c-.456 2.378-2.586 2.378-2.586 2.378V7.808s2.13 0 2.586 2.378z"/>
            </svg>
            <span>{dict.common.buyMeACoffee}</span>
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<!-- Floating Quick-Actions FAB (Bottom-Right) -->
<aside aria-label={dict.common.moreActions} class="fixed bottom-5 sm:bottom-6 right-5 sm:right-6 z-50 select-none">
  <details class="palette-dropdown group relative">
    <summary
      class="w-12 h-12 sm:w-13 sm:h-13 rounded-full bg-ink-950 hover:bg-ink-800 text-surface-0 border border-white/20 shadow-2xl hover:shadow-[0_12px_28px_rgba(0,0,0,0.3)] flex items-center justify-center cursor-pointer list-none transition-all duration-200 active:scale-90 focus-visible:outline-accent"
      aria-label={dict.common.moreActions}
      title={dict.common.moreActions}
    >
      <svg
        class="w-5 h-5 text-white transition-transform duration-200 group-open:rotate-45"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
    </summary>

    <!-- Popover Menu (Upward from Bottom-Right) -->
    <div
      class="absolute bottom-full right-0 mb-3 w-72 max-w-[calc(100vw-2.5rem)] rounded-2xl bg-surface-0/95 dark:bg-[#0B0D10]/95 backdrop-blur-2xl border border-line-200 shadow-2xl p-2 z-50 focus:outline-none flex flex-col gap-1 animate-in fade-in slide-in-from-bottom-2"
      role="menu"
      aria-orientation="vertical"
      tabindex="-1"
    >
      <div class="px-3 py-2 border-b border-line-100 flex items-center justify-between">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          <p class="text-[11px] font-semibold tracking-wider uppercase text-ink-500">{dict.common.moreActions}</p>
        </div>
        <span class="text-[10px] font-mono text-ink-400">YouTubeBannerMaker</span>
      </div>

      <!-- Suggest a Tool -->
      <a
        href={getLocalizedUrl('/contact', locale)}
        class="flex items-center gap-3 p-2.5 rounded-xl text-left hover:bg-surface-50 transition-colors group/item"
        role="menuitem"
      >
        <div class="w-9 h-9 rounded-xl bg-accent/10 text-accent flex items-center justify-center shrink-0 transition-transform group-hover/item:scale-105 border border-accent/20">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.516 0c.85.493 1.509 1.333 1.509 2.316V18" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <div class="text-xs font-semibold text-ink-950 group-hover/item:text-accent transition-colors">
            {dict.common.suggestATool}
          </div>
          <div class="text-[11px] text-ink-500 leading-tight mt-0.5 truncate">{dict.common.suggestAToolDesc}</div>
        </div>
      </a>

      <!-- Buy Me a Coffee -->
      <a
        href="https://ko-fi.com/divyyadav"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 p-2.5 rounded-xl text-left hover:bg-[#FF5E5B]/10 transition-colors group/item"
        role="menuitem"
      >
        <div class="w-9 h-9 rounded-xl bg-[#FF5E5B]/15 text-[#FF5E5B] flex items-center justify-center shrink-0 transition-transform group-hover/item:scale-105 border border-[#FF5E5B]/20">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.022 5.86c-2.028 1.942-5.405.86-5.405.86s-.781-3.619 1.139-5.467c1.789-1.724 4.372-.638 4.372-.638s1.084 3.447-.106 5.245zm6.84-2.584c-.456 2.378-2.586 2.378-2.586 2.378V7.808s2.13 0 2.586 2.378z"/>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <div class="text-xs font-semibold text-ink-950 flex items-center gap-1.5">
            <span class="text-[#FF5E5B]">{dict.common.buyMeACoffee}</span>
            <span class="text-[10px] px-1.5 py-0.2 rounded-full bg-[#FF5E5B]/15 text-[#FF5E5B] font-mono font-medium">Ko-fi</span>
          </div>
          <div class="text-[11px] text-ink-500 leading-tight mt-0.5 truncate">{dict.common.buyMeACoffeeDesc}</div>
        </div>
      </a>
    </div>
  </details>
</aside>
