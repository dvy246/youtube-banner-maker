---
import PalettePicker from './PalettePicker.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguagePicker from './LanguagePicker.astro';
import { getLocalizedUrl, getTranslations, type Locale } from '../i18n';

interface Props {
  currentPath?: string;
  locale?: Locale;
}

const { currentPath = '', locale = 'en' } = Astro.props;
const isToolPage = currentPath.includes('/tools');
const dict = getTranslations(locale);

const mainNavItems = [
  { label: dict.nav.fixBanner, href: getLocalizedUrl('/tools/youtube-banner-resizer', locale) },
  { label: dict.nav.checker, href: getLocalizedUrl('/tools/youtube-banner-checker', locale) },
  { label: dict.nav.maker, href: getLocalizedUrl('/tools/youtube-banner-maker', locale) },
  { label: dict.nav.templates, href: getLocalizedUrl('/templates', locale) },
  { label: dict.nav.backgrounds, href: getLocalizedUrl('/backgrounds', locale) },
];

const guideItems = [
  { label: dict.footer.guideHowToMake, href: getLocalizedUrl('/guides/how-to-make-a-youtube-banner', locale) },
  { label: dict.footer.guideBestTemplates, href: getLocalizedUrl('/guides/how-to-choose-a-youtube-banner-template', locale) },
  { label: dict.footer.guideSize, href: getLocalizedUrl('/guides/youtube-banner-size', locale) },
  { label: dict.footer.guideSafeArea, href: getLocalizedUrl('/guides/youtube-banner-safe-area', locale) },
];

const mobileNavItems = [...mainNavItems, ...guideItems];
---

<header class="sticky top-0 z-40 w-full bg-surface-0/95 backdrop-blur-md border-b border-line-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between gap-3 lg:gap-4">
    <!-- Brand -->
    <a href={getLocalizedUrl('/', locale)} class="flex items-center gap-2.5 sm:gap-3 text-ink-950 hover:opacity-90 transition-opacity min-w-0 shrink">
      <img src="/favicon-96x96.png" alt="YouTubeBannerMaker logo" width="28" height="28" class="w-7 h-7 rounded-sm object-contain shrink-0" />
      <div class="flex items-baseline min-w-0">
        <span class="text-sm font-semibold tracking-tight text-ink-950 truncate max-w-[130px] xs:max-w-[180px] sm:max-w-none">{dict.common.brandName}</span>
      </div>
    </a>

    <!-- Navigation & Desktop Actions -->
    <div class="hidden md:flex items-center gap-2 lg:gap-3 xl:gap-4 shrink-0">
      <nav class="flex items-center gap-0.5 lg:gap-1" aria-label="Main Navigation">
        {
          mainNavItems.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/' && item.href !== `/${locale}` && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class:list={[
                  'relative h-9 px-2 lg:px-2.5 text-xs lg:text-[13px] font-medium transition-colors inline-flex items-center whitespace-nowrap',
                  isActive
                    ? 'text-ink-950 font-semibold'
                    : 'text-ink-600 hover:text-ink-950',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                <span>{item.label}</span>
                {isActive && (
                  <span class="absolute bottom-0 left-2 lg:left-2.5 right-2 lg:right-2.5 h-[2px] bg-accent rounded-full" aria-hidden="true" />
                )}
              </a>
            );
          })
        }
        
        {/* Guides Dropdown */}
        <div class="relative group">
          <button class="relative h-9 px-2 lg:px-2.5 text-xs lg:text-[13px] font-medium transition-colors inline-flex items-center gap-1 text-ink-600 hover:text-ink-950 whitespace-nowrap cursor-pointer">
            <span>{dict.footer.colGuides}</span>
            <svg class="w-3.5 h-3.5 text-ink-500 group-hover:text-ink-950 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
            {currentPath.includes('/guides/') && (
              <span class="absolute bottom-0 left-2 lg:left-2.5 right-2 lg:right-2.5 h-[2px] bg-accent rounded-full" aria-hidden="true" />
            )}
          </button>
          
          <div class="absolute top-full left-0 mt-0 w-64 rounded-xl bg-surface-0 border border-line-200 shadow-overlay p-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 flex flex-col gap-0.5">
            {guideItems.map((item) => {
              const isActive = currentPath === item.href;
              return (
                <a
                  href={item.href}
                  class:list={[
                    'block px-3 py-2.5 rounded-lg text-xs font-medium transition-colors',
                    isActive ? 'bg-surface-100 text-ink-950 font-semibold' : 'text-ink-600 hover:bg-surface-50 hover:text-ink-950'
                  ]}
                >
                  {item.label}
                </a>
              );
            })}
          </div>
        </div>
      </nav>

      <div class="h-4 w-px bg-line-200" aria-hidden="true" />

      <!-- Language Selector (Pure-HTML, Zero JS) -->
      <LanguagePicker currentPath={currentPath} currentLocale={locale} />

      <!-- Dark / White Mode Slider Toggle -->
      <ThemeToggle id="theme-toggle" />

      <!-- Color Palette Picker -->
      <PalettePicker currentPath={currentPath} />

      <a
        href="https://ko-fi.com/divyyadav"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:inline-flex items-center gap-1.5 h-9 px-3 rounded-full text-xs font-medium text-ink-700 hover:text-ink-950 border border-line-200 hover:border-line-300 hover:bg-surface-50 transition-all duration-150 active:scale-[0.98]"
        title="Support on Ko-fi"
      >
        <svg class="w-3.5 h-3.5 text-[#FF5E5B] fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.022 5.86c-2.028 1.942-5.405.86-5.405.86s-.781-3.619 1.139-5.467c1.789-1.724 4.372-.638 4.372-.638s1.084 3.447-.106 5.245zm6.84-2.584c-.456 2.378-2.586 2.378-2.586 2.378V7.808s2.13 0 2.586 2.378z"/>
        </svg>
        <span>{dict.common.buyMeACoffee}</span>
      </a>

      {!isToolPage && (
        <a
          href={getLocalizedUrl('/tools/youtube-banner-resizer', locale)}
          class="hidden xl:inline-flex h-9 px-4 rounded-full bg-ink-950 text-surface-0 hover:bg-ink-800 text-xs font-medium items-center gap-1.5 transition-all shadow-xs active:scale-[0.98] border border-white/10"
        >
          <span>{dict.common.launchResizer}</span>
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>

    <!-- Mobile Navigation & Actions -->
    <div class="flex md:hidden items-center gap-1 sm:gap-1.5 shrink-0">
      <LanguagePicker currentPath={currentPath} currentLocale={locale} />
      <ThemeToggle id="theme-toggle-mobile" />
      <PalettePicker currentPath={currentPath} />
      <details class="palette-dropdown group relative">
        <summary
          class="min-h-[38px] min-w-[38px] p-2 rounded-full border border-line-200 bg-surface-0 hover:bg-surface-50 text-ink-800 flex items-center justify-center cursor-pointer list-none select-none shadow-2xs active:scale-[0.98] focus-visible:outline-accent"
          aria-label={dict.common.openMobileMenu}
        >
          <svg class="w-4 h-4 text-ink-700 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <div
          class="absolute right-0 mt-1.5 w-60 max-h-[70vh] overflow-y-auto rounded-2xl bg-surface-0 border border-line-200 shadow-overlay p-2 z-50 focus:outline-none flex flex-col gap-0.5"
          role="menu"
        >
          {
            mobileNavItems.map((item) => {
              const isActive = currentPath === item.href || (item.href !== '/' && item.href !== `/${locale}` && currentPath.startsWith(item.href));
              return (
                <a
                  href={item.href}
                  class:list={[
                    'block px-3.5 py-2.5 rounded-xl text-xs font-medium transition-colors',
                    isActive ? 'bg-surface-100 text-ink-950 font-semibold' : 'text-ink-600 hover:bg-surface-50 hover:text-ink-950',
                  ]}
                  role="menuitem"
                >
                  {item.label}
                </a>
              );
            })
          }
          <div class="my-1 border-t border-line-200"></div>
          <a
            href="https://ko-fi.com/divyyadav"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-medium text-[#FF5E5B] hover:bg-[#FF5E5B]/10 transition-colors"
            role="menuitem"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.022 5.86c-2.028 1.942-5.405.86-5.405.86s-.781-3.619 1.139-5.467c1.789-1.724 4.372-.638 4.372-.638s1.084 3.447-.106 5.245zm6.84-2.584c-.456 2.378-2.586 2.378-2.586 2.378V7.808s2.13 0 2.586 2.378z"/>
            </svg>
            <span>{dict.common.buyMeACoffee}</span>
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
