---
import { getLocalizedUrl, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

interface GhibliBg {
  id: string;
  name: string;
  mood: string;
  src: string;
}

// 7 hero Ghibli backgrounds for the fan — most visually striking picks
const FEATURED: GhibliBg[] = [
  {
    id: 'ghibli-totoro-rainy-bus-stop',
    name: 'Totoro Bus Stop',
    mood: 'Ghibli Magic',
    src: '/backgrounds/ghibli-totoro-rainy-bus-stop.jpg',
  },
  {
    id: 'ghibli-spirited-away-bathhouse-night',
    name: 'Spirited Away',
    mood: 'Spirit Realm',
    src: '/backgrounds/ghibli-spirited-away-bathhouse-night.jpg',
  },
  {
    id: 'ghibli-sakura-golden-hour-pond',
    name: 'Sakura Pond',
    mood: 'Spring Bloom',
    src: '/backgrounds/ghibli-sakura-golden-hour-pond.jpg',
  },
  {
    id: 'ghibli-ancient-shrine-kodama-forest',
    name: 'Kodama Shrine',
    mood: 'Forest Spirit',
    src: '/backgrounds/ghibli-ancient-shrine-kodama-forest.jpg',
  },
  {
    id: 'ghibli-ocean-pier-dusk-fireflies',
    name: 'Ocean Pier Dusk',
    mood: 'Firefly Nostalgia',
    src: '/backgrounds/ghibli-ocean-pier-dusk-fireflies.jpg',
  },
  {
    id: 'ghibli-kiki-bakery-morning',
    name: "Kiki's Bakery",
    mood: 'Cozy Morning',
    src: '/backgrounds/ghibli-kiki-bakery-morning.jpg',
  },
  {
    id: 'ghibli-ramen-cozy-shop-rain',
    name: 'Rainy Ramen Shop',
    mood: 'Warm & Cozy',
    src: '/backgrounds/ghibli-ramen-cozy-shop-rain.jpg',
  },
];

const total = FEATURED.length;
const mid = Math.floor(total / 2);
---

<div
  class="relative w-full py-6 sm:py-10 flex flex-col items-center justify-center select-none overflow-hidden"
  role="region"
  aria-label="Ghibli Aesthetic Background Gallery"
>
  <!-- Warm ambient glow matching Ghibli palette -->
  <div
    class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-50 dark:opacity-20 -z-10"
    aria-hidden="true"
  >
    <div class="w-[640px] sm:w-[900px] h-[300px] bg-gradient-to-r from-pink-300/30 via-amber-200/25 to-green-300/20 rounded-full blur-3xl"></div>
  </div>

  <!-- Stage container -->
  <div class="bg-arch-stage relative w-full flex items-center justify-center">
    <div class="bg-arch-track relative flex items-center justify-center">
      {FEATURED.map((bg, index) => {
        const offset = index - mid;
        const absOffset = Math.abs(offset);
        const baseZ = total - absOffset;

        return (
          <a
            href={`${getLocalizedUrl('/backgrounds', locale)}?bg=${bg.id}`}
            class="bg-arch-card group"
            style={{
              '--offset': offset,
              '--abs-offset': absOffset,
              '--base-z': baseZ,
            }}
            aria-label={`Explore ${bg.name} Ghibli background`}
          >
            <!-- Photo Preview -->
            <div class="relative w-full h-full overflow-hidden bg-ink-950">
              <img
                src={bg.src}
                alt={`${bg.name} – Ghibli aesthetic background`}
                width="320"
                height="180"
                loading={absOffset <= 1 ? 'eager' : 'lazy'}
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-105"
                draggable="false"
              />

              <!-- Corner ticks -->
              <span class="absolute top-1.5 left-2 font-mono text-[8px] text-white/40 group-hover:text-white/80 transition-colors pointer-events-none" aria-hidden="true">┌</span>
              <span class="absolute top-1.5 right-2 font-mono text-[8px] text-white/40 group-hover:text-white/80 transition-colors pointer-events-none" aria-hidden="true">┐</span>

              <!-- Mood pill -->
              <div class="absolute top-2 left-2.5 px-2 py-0.5 rounded bg-black/60 backdrop-blur-xs border border-white/15 text-[9px] font-mono font-medium uppercase tracking-wider text-white/90">
                {bg.mood}
              </div>

              <!-- Resolution badge -->
              <div class="absolute bottom-2 left-2.5 px-1.5 py-0.5 rounded bg-black/55 backdrop-blur-xs text-[8px] font-mono text-white/70">
                2560×1440
              </div>

              <!-- Hover overlay -->
              <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center p-3">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-0/95 text-ink-950 font-semibold text-xs shadow-lg transform translate-y-2 group-hover:translate-y-0 transition-transform duration-200">
                  <span>Customize Free</span>
                  <span aria-hidden="true">&rarr;</span>
                </span>
              </div>
            </div>

            <!-- Title footer -->
            <div class="px-3 py-2 bg-surface-0 dark:bg-surface-50 border-t border-line-200 dark:border-white/10 flex items-center justify-between gap-2">
              <span class="text-xs font-semibold text-ink-950 truncate group-hover:text-accent transition-colors">
                {bg.name}
              </span>
              <span class="text-[10px] font-mono text-ink-500 uppercase shrink-0">
                Ghibli
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>

  <!-- Hint caption -->
  <div class="mt-6 sm:mt-8 flex items-center justify-center gap-2 text-xs text-ink-500 font-mono">
    <span class="inline-block w-1.5 h-1.5 rounded-full bg-pink-400 animate-pulse"></span>
    <span>Click any background to customize it free in the Banner Maker</span>
  </div>
</div>

<style>
  .bg-arch-stage {
    --card-w: 280px;
    --card-h: 198px;
    --overlap: 120px;
    --y-step: 14px;
    --rotate-step: 5.2deg;
    height: calc(var(--card-h) + 64px);
  }

  .bg-arch-track {
    width: 100%;
    height: 100%;
  }

  .bg-arch-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--card-w);
    height: var(--card-h);
    margin-left: calc(var(--card-w) / -2);
    margin-top: calc(var(--card-h) / -2);
    border-radius: 14px;
    border: 1.5px solid var(--color-line-200, #e5e7eb);
    overflow: hidden;
    transform-origin: center bottom;
    transform:
      translate(
        calc(var(--offset) * var(--overlap)),
        calc(var(--abs-offset) * var(--y-step))
      )
      rotate(calc(var(--offset) * var(--rotate-step)))
      scale(1);
    z-index: var(--base-z);
    cursor: pointer;
    box-shadow:
      0 10px 24px -6px rgba(0, 0, 0, 0.14),
      0 2px 6px -2px rgba(0, 0, 0, 0.07);
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 300ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 200ms ease,
      z-index 0ms;
    will-change: transform;
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }

  .bg-arch-card:hover,
  .bg-arch-card:focus-visible {
    transform:
      translate(
        calc(var(--offset) * var(--overlap)),
        calc(var(--abs-offset) * var(--y-step) - 18px)
      )
      rotate(0deg)
      scale(1.08);
    z-index: 40;
    box-shadow:
      0 22px 38px -10px rgba(0, 0, 0, 0.24),
      0 4px 12px -2px rgba(0, 0, 0, 0.10);
    border-color: var(--color-accent, #2340b8);
    outline: none;
  }

  @media (max-width: 1024px) {
    .bg-arch-stage {
      --card-w: 230px;
      --card-h: 165px;
      --overlap: 96px;
      --y-step: 10px;
      --rotate-step: 4.5deg;
      height: calc(var(--card-h) + 52px);
    }
  }

  @media (max-width: 768px) {
    .bg-arch-stage {
      --card-w: 190px;
      --card-h: 138px;
      --overlap: 72px;
      --y-step: 8px;
      --rotate-step: 3.8deg;
      height: calc(var(--card-h) + 44px);
    }
  }

  @media (max-width: 520px) {
    .bg-arch-stage {
      --card-w: 154px;
      --card-h: 114px;
      --overlap: 48px;
      --y-step: 6px;
      --rotate-step: 3.2deg;
      height: calc(var(--card-h) + 36px);
    }
  }

  @media (max-width: 400px) {
    .bg-arch-stage {
      --card-w: 124px;
      --card-h: 92px;
      --overlap: 34px;
      --y-step: 4px;
      --rotate-step: 2.5deg;
      height: calc(var(--card-h) + 28px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-arch-card {
      transition: none;
    }
    .bg-arch-card:hover,
    .bg-arch-card:focus-visible {
      transform:
        translate(
          calc(var(--offset) * var(--overlap)),
          calc(var(--abs-offset) * var(--y-step))
        )
        rotate(calc(var(--offset) * var(--rotate-step)));
    }
  }
</style>
