  /* ═══════════════════════════════════════════════════════════
     Autonomous 16s Smooth Crop Cycle Animation (4s per crop mode)
     Restrained, cinematic, hardware-accelerated.
  ═══════════════════════════════════════════════════════════ */
  @keyframes live-crop-mask {
    /* 0% - 22%: Mobile Safe Area */
    0%, 22% {
      background: radial-gradient(ellipse 65% 35% at 50% 50%, transparent 40%, rgba(3, 7, 18, 0.8) 90%);
      clip-path: polygon(0% 0%, 0% 100%, 19.8% 100%, 19.8% 35.3%, 80.2% 35.3%, 80.2% 64.7%, 19.8% 64.7%, 19.8% 100%, 100% 100%, 100% 0%);
    }

    /* 25% - 47%: Desktop Viewport */
    25%, 47% {
      background: rgba(3, 7, 18, 0.72);
