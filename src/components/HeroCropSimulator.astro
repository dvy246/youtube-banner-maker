---
/**
 * HeroCropSimulator - Live Studio Crop Intelligence for the Homepage.
 *
 * Implements high-craft art-directed channel art showcase:
 * - 7 distinct, professionally designed preview banners:
 *   1. Executive Finance (Alexander Cross)
 *   2. Personal Creator (Elena Rostova)
 *   3. Cinema Minimal (Kairen Vance)
 *   4. Modern Technology (Synapse Lab)
 *   5. Studio Podcast (The Dialogue)
 *   6. Editorial Theory (Aura Archive)
 *   7. Neon Esports (Neon Velocity)
 * - Pure CSS style switcher: visitors can flip between all 7 styles instantly.
 * - Smooth autonomous 16s crop intelligence cycle demonstrating Mobile -> Desktop -> Tablet -> TV crops.
 * - Interactive: Clicking any device tab locks to that device's exact crop boundaries.
 * - ZERO client JS scripts - strictly preserving the 0 KB static page budget.
 */
import { CANVAS, DEVICES, SAFE_PX } from '../lib/spec';
import { getLocalizedUrl, getTranslations, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props as Props;
const dict = getTranslations(locale);
const tSim = dict.heroSim;

const desktopHeight = Math.round(DEVICES.desktop.h * CANVAS.height);
const tabletWidth = Math.round(DEVICES.tablet.w * CANVAS.width);

const bannerStyles = [
  {
    id: 'anime',
    name: 'Anime',
    label: 'Ghibli Aesthetic',
    image: '/backgrounds/ghibli-mountain-lake-morning-mist.jpg',
    avatar: '/avatars/avatar-anime-totoro-thumb.jpg',
    channelName: 'SAKURA STUDIO',
    category: 'ANIME & GHIBLI AESTHETIC',
    kicker: 'GHIBLI WORLD',
    metrics: '924K DREAMERS',
    monogram: '桜',
    tvLeft: 'ALPINE LAKE · FIRST LIGHT',
    tvRight: 'GHIBLI ARCHIVE · VOL. 01',
    desktopLeft: 'TRANQUIL SCENES DAILY',
    desktopRight: 'AESTHETIC COLLECTION',
    accentColor: '#6EE7B7',
  },
  {
    id: 'editorial',
    name: 'Editorial',
    label: 'Editorial Studio',
    image: '/hero/aura-archive.webp',
    avatar: '/avatars/avatar-business-female-thumb.jpg',
    channelName: 'AURA ARCHIVE',
    category: 'ARCHITECTURAL THEORY & FORM',
    kicker: 'DESIGN ARCHIVE',
    metrics: '480K MEMBERS',
    monogram: 'AA',
    tvLeft: 'MONOGRAPH EDITIONS',
    tvRight: '4K ARCHIVE · VOL. 04',
    desktopLeft: 'COPENHAGEN / TOKYO',
    desktopRight: 'WEEKLY ESSAYS',
    accentColor: '#F8FAFC',
  },
  {
    id: 'finance',
    name: 'Finance',
    label: 'Executive Finance Glow',
    image: '/hero/finance-glow.webp',
    avatar: '/avatars/finance-executive-thumb.jpg',
    channelName: 'ALEXANDER CROSS',
    category: 'WEALTH STRATEGY & MARKETS',
    kicker: 'FINANCIAL INTELLIGENCE',
    metrics: '1.2M SUBSCRIBERS',
    monogram: 'AC',
    tvLeft: 'GLOBAL CAPITAL MARKETS',
    tvRight: '4K BROADCAST · EST. 2024',
    desktopLeft: 'NEW ANALYSIS EVERY TUESDAY',
    desktopRight: 'ROAD TO WEALTH ARCHIVE',
    accentColor: '#00E5FF',
  },
  {
    id: 'brand',
    name: 'Creator',
    label: 'Studio Creator Brand',
    image: '/hero/elena-rostova.webp',
    avatar: '/avatars/avatar-beauty-creator-thumb.jpg',
    channelName: 'ELENA ROSTOVA',
    category: 'CREATIVE DIRECTOR & FOUNDER',
    kicker: 'OFFICIAL CHANNEL',
    metrics: '1.4M SUBSCRIBERS',
    monogram: 'ER',
    tvLeft: 'ROSTOVA ARCHIVE · 4K MASTER',
    tvRight: 'EST. 2024 · VOL. 08',
    desktopLeft: 'NEW EPISODES EVERY SUNDAY',
    desktopRight: '1.4M CREATIVE COMMUNITY',
    accentColor: '#FB7185',
  },
  {
    id: 'cinema',
    name: 'Cinema',
    label: 'Cinematic Minimal',
    image: '/hero/kairen-cinema.webp',
    avatar: '/avatars/avatar-creative-male-thumb.jpg',
    channelName: 'KAIREN VANCE',
    category: 'VISUAL ESSAYS & DOCUMENTARY',
    kicker: 'ORIGINAL CINEMA',
    metrics: '820K SUBSCRIBERS',
    monogram: 'KV',
    tvLeft: 'ORIGINAL PRODUCTIONS',
    tvRight: 'ANAMORPHIC MASTER · 2.39:1',
    desktopLeft: 'DIRECTED BY K. VANCE',
    desktopRight: 'MONTHLY PREMIERE',
    accentColor: '#F59E0B',
  },
  {
    id: 'tech',
    name: 'Tech',
    label: 'Modern Technology',
    image: '/hero/synapse-lab.webp',
    avatar: '/avatars/avatar-tech-glasses-thumb.jpg',
    channelName: 'SYNAPSE LAB',
    category: 'HARDWARE SYSTEMS & SILICON',
    kicker: 'SYSTEMS LAB',
    metrics: '950K SUBSCRIBERS',
    monogram: 'SL',
    tvLeft: 'DEEP ARCHITECTURE',
    tvRight: 'LAB DISPATCH 08',
    desktopLeft: 'KERNEL & PROTOCOL',
    desktopRight: 'WEEKLY DISPATCH',
    accentColor: '#10B981',
  },
  {
    id: 'podcast',
    name: 'Podcast',
    label: 'Studio Podcast',
    image: '/backgrounds/podcast-studio.jpg',
    avatar: '/avatars/avatar-podcast-host-thumb.jpg',
    channelName: 'THE DIALOGUE',
    category: 'FOUNDERS & UNCUT CONVERSATIONS',
    kicker: 'STUDIO BROADCAST',
    metrics: '620K LISTENERS',
    monogram: 'TD',
    tvLeft: 'LIVE FROM STUDIO B',
    tvRight: 'EPISODE 142 STREAMING',
    desktopLeft: 'UNCUT CONVERSATIONS',
    desktopRight: 'NEW GUESTS THURSDAYS',
    accentColor: '#A855F7',
  },
  {
    id: 'gaming',
    name: 'Gaming',
    label: 'Neon Gaming',
    image: '/backgrounds/gaming-neon.jpg',
    avatar: '/avatars/avatar-gaming-streamer-thumb.jpg',
    channelName: 'NEON VELOCITY',
    category: 'PRO ESPORTS & LIVE STREAMS',
    kicker: 'LIVE DAILY',
    metrics: '1.8M SQUAD',
    monogram: 'NV',
    tvLeft: 'RANK #1 WORLDWIDE',
    tvRight: 'LIVE 1080P 240FPS',
    desktopLeft: 'DAILY LIVESTREAMS 6PM',
    desktopRight: 'JOIN THE DISCORD',
    accentColor: '#EC4899',
  },
] as const;

const tabs = [
  {
    id: 'mobile',
    label: tSim.tabMobile,
    icon: '📱',
    dim: `${SAFE_PX.full.width} × ${SAFE_PX.full.height}`,
    badge: tSim.badgeMobile,
    color: '#00E5FF',
  },
  {
    id: 'desktop',
    label: tSim.tabDesktop,
    icon: '💻',
    dim: `${CANVAS.width} × ${desktopHeight}`,
    badge: tSim.badgeDesktop,
    color: '#10B981',
  },
  {
    id: 'tablet',
    label: tSim.tabTablet,
    icon: '📟',
    dim: `${tabletWidth} × ${desktopHeight}`,
    badge: tSim.badgeTablet,
    color: '#F59E0B',
  },
  {
    id: 'tv',
    label: tSim.tabTv,
    icon: '📺',
    dim: `${CANVAS.width} × ${CANVAS.height}`,
    badge: tSim.badgeTv,
    color: '#8B5CF6',
  },
] as const;
---

<div class="hero-sim-root" id="hero-sim">
  <!-- Radio inputs for Banner Style Switching -->
  {bannerStyles.map((b, i) => (
    <input
      type="radio"
      name="hero-banner-art"
      id={`hba-${b.id}`}
      value={b.id}
      checked={i === 0}
      class="sr-only"
    />
  ))}

  <!-- Radio inputs for Device Crop Switching -->
  {tabs.map((t) => (
    <input
      type="radio"
      name="hero-crop-tab"
      id={`hcs-tab-${t.id}`}
      value={t.id}
      class="sr-only"
    />
  ))}

  <!-- Top Studio Bezel Bar: Live Tally + Genre Switcher Deck -->
  <div class="sim-header-bar">
    <div class="sim-header-tally">
      <span class="sim-tally-dot"></span>
      <span class="sim-tally-label">{tSim.viewfinder}</span>
      <span class="sim-tally-fps">60 FPS</span>
    </div>

    <!-- Interactive Backlit Genre Selector -->
    <div class="sim-style-nav" role="tablist" aria-label="Preview banner artwork styles">
      {bannerStyles.map((b) => (
        <label
          class={`sim-style-pill sim-style-${b.id}`}
          for={`hba-${b.id}`}
          title={`Switch to ${b.label}`}
        >
          <span>{b.name}</span>
        </label>
      ))}
    </div>

    <!-- Studio Resolution & Aspect Tag -->
    <div class="sim-header-res font-mono hidden sm:flex items-center gap-1.5 text-[10px] text-ink-600">
      <span class="px-1.5 py-0.5 rounded bg-black/5 dark:bg-white/10 text-ink-950 font-bold border border-black/10 dark:border-white/15">4K HDR</span>
      <span>2560 × 1440</span>
    </div>
  </div>

  <!-- Preview Stage (2560 × 1440 ratio / 16:9) -->
  <div class="sim-stage" id="hcs-stage">
    <a
      href={getLocalizedUrl('/tools/youtube-banner-resizer', locale)}
      class="sim-dropzone"
      aria-label="Launch YouTube Banner Resizer with this preview"
      title="Click to test in the interactive resizer"
    >
      <!-- Multi-Artwork Layers (Crossfades based on radio state) -->
      {bannerStyles.map((b, i) => (
        <div class={`sim-artwork-layer art-layer-${b.id}`}>
          <!-- 16:9 Photographic / Vector Backdrop -->
          <img
            src={b.image}
            alt={`YouTube banner preview for ${b.channelName} (${b.label})`}
            class="art-backdrop-img"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            decoding="async"
            width="2560"
            height="1440"
          />

          <!-- Special Electric Bull-Market Trendline Overlay for Finance -->
          {b.id === 'finance' && (
            <svg class="art-svg-overlay" viewBox="0 0 2560 1440" preserveAspectRatio="none" aria-hidden="true">
              <!-- Grid lines -->
              <line x1="0" y1="500" x2="2560" y2="500" stroke="#00E5FF" stroke-width="1" stroke-dasharray="8 8" opacity="0.18" />
              <line x1="0" y1="940" x2="2560" y2="940" stroke="#00E5FF" stroke-width="1" stroke-dasharray="8 8" opacity="0.18" />
              <!-- Bull Market Luminous Trend Curve -->
              <path d="M 0 1020 Q 420 780 840 880 T 1540 680 T 2100 620 T 2560 480" fill="none" stroke="#00E5FF" stroke-width="6" opacity="0.85" filter="drop-shadow(0 0 16px #00E5FF)" />
              <path d="M 0 1040 Q 420 800 840 900 T 1540 700 T 2100 640 T 2560 500" fill="none" stroke="#38BDF8" stroke-width="2" opacity="0.5" />
              <!-- Data Nodes -->
              <circle cx="840" cy="880" r="7" fill="#00E5FF" filter="drop-shadow(0 0 8px #00E5FF)" />
              <circle cx="1540" cy="680" r="9" fill="#00E5FF" filter="drop-shadow(0 0 12px #00E5FF)" />
              <circle cx="2100" cy="620" r="7" fill="#00E5FF" filter="drop-shadow(0 0 8px #00E5FF)" />
            </svg>
          )}

          <!-- Light Cinematic Vignette -->
          <div class="art-scrim-overlay" aria-hidden="true"></div>

          <!-- Ambient Tint Glow -->
          <div class="art-ambient-glow" aria-hidden="true"></div>

          <!-- TV Bleed Details (Top/Bottom 1440 Canvas Bleed) -->
          <div class="art-tv-header" aria-hidden="true">
            <span class="font-mono text-[9px] text-white/75 tracking-widest uppercase">{b.tvLeft}</span>
            <span class="font-mono text-[9px] text-white/75 tracking-widest uppercase">{b.tvRight}</span>
          </div>

          <!-- Desktop Peripheral Details (Left/Right 2560 Canvas Bleed) -->
          <div class="art-desktop-left" aria-hidden="true">
            <span class="text-[10px] font-mono text-white/80 tracking-wider uppercase font-semibold">{b.desktopLeft}</span>
          </div>
          <div class="art-desktop-right" aria-hidden="true">
            <span class="text-[10px] font-mono text-white/80 tracking-wider uppercase font-semibold">{b.desktopRight}</span>
          </div>

          <!-- Centered Mobile Safe Area Core (Glassmorphic HUD Plate) -->
          <div class="art-safe-core">
            <!-- Custom Geometric Person Frame -->
            <div class="safe-mark-wrap">
              <div class="safe-person-frame">
                <img
                  src={b.avatar}
                  alt={`Creator portrait for ${b.channelName}`}
                  class="safe-person-img"
                  width="88"
                  height="88"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                />
                <div class="safe-person-rim" aria-hidden="true"></div>
                <div class="safe-person-glow" aria-hidden="true"></div>
              </div>
              <span class="safe-verified-badge" title="Verified Creator">✓</span>
            </div>

            <!-- Channel Branding Typography & Live Badges -->
            <div class="safe-typography">
              <div class="safe-badge-strip">
                <span class="safe-pill-kicker font-mono">
                  <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
                  {b.kicker}
                </span>
                <span class="safe-pill-stat font-mono">{b.metrics}</span>
              </div>
              <span class="safe-channel-title">{b.channelName}</span>
              <p class="safe-channel-sub">{b.category}</p>
            </div>

            <!-- Mathematical Corner Registration Brackets -->
            <span class="reg-bracket reg-tl font-mono">┌</span>
            <span class="reg-bracket reg-tr font-mono">┐</span>
            <span class="reg-bracket reg-bl font-mono">└</span>
            <span class="reg-bracket reg-br font-mono">┘</span>

            <!-- Optical Center Reticle -->
            <div class="center-crosshair" aria-hidden="true">+</div>
          </div>
        </div>
      ))}

      <!-- Dynamic Crop Viewport Mask (Vignettes outer non-visible zones) -->
      <div class="sim-viewport-mask" aria-hidden="true"></div>

      <!-- Dynamic Laser Crop Wireframe Boundary -->
      <div class="sim-crop-wireframe" aria-hidden="true">
        <!-- Laser Viewfinder Corner Markers -->
        <span class="hud-corner hud-tl" aria-hidden="true"></span>
        <span class="hud-corner hud-tr" aria-hidden="true"></span>
        <span class="hud-corner hud-bl" aria-hidden="true"></span>
        <span class="hud-corner hud-br" aria-hidden="true"></span>
      </div>

      <!-- Active Crop Readout Pill -->
      <div class="sim-status-pill" aria-hidden="true">
        <span class="status-pulse-dot"></span>
        <span class="status-device-text">{tSim.badgeMobile}</span>
        <span class="status-dim-text tabular-nums">{SAFE_PX.full.width} × {SAFE_PX.full.height}</span>
        <span class="status-aspect-tag font-mono">3.65:1</span>
      </div>

      <!-- Interactive Hover Tooltip Overlay -->
      <div class="sim-launch-hint">
        <span class="font-semibold">{tSim.openResizer}</span>
        <span class="ml-1 text-accent" aria-hidden="true">&rarr;</span>
      </div>
    </a>
  </div>

  <!-- Device Switcher Studio Tabs Below Preview -->
  <div class="sim-tabs" role="tablist" aria-label="Device crop preview modes">
    {tabs.map((t) => (
      <label
        class={`sim-tab sim-tab-${t.id}`}
        for={`hcs-tab-${t.id}`}
        role="tab"
      >
        <div class="flex items-center gap-1.5">
          <span class="tab-device-icon text-xs leading-none">{t.icon}</span>
          <span class="sim-tab-label font-bold">{t.label}</span>
          <span class="tab-indicator-dot"></span>
        </div>
        <span class="sim-tab-dim tabular-nums font-mono">{t.dim}</span>
      </label>
    ))}
  </div>
</div>

<style>
  .hero-sim-root {
    --sim-bg: linear-gradient(180deg, #FBF8F4 0%, #F4EDE2 100%);
    --sim-border: #E6DCD0;
    --sim-shadow:
      0 20px 48px -12px rgba(110, 85, 60, 0.12),
      0 4px 16px -2px rgba(60, 45, 30, 0.05),
      inset 0 1px 0 #FFFFFF,
      0 0 0 1px rgba(230, 220, 208, 0.6);
    --sim-tally-color: #1E2430;
    --sim-tally-fps-bg: rgba(5, 150, 105, 0.1);
    --sim-tally-fps-color: #065F46;
    --sim-tally-fps-border: rgba(5, 150, 105, 0.25);
    --sim-nav-bg: rgba(0, 0, 0, 0.04);
    --sim-nav-border: rgba(0, 0, 0, 0.08);
    --sim-nav-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.04);
    --sim-pill-color: #64748B;
    --sim-pill-hover-color: #0F172A;
    --sim-pill-hover-bg: rgba(0, 0, 0, 0.06);
    --sim-stage-border: #E5DCCE;
    --sim-stage-shadow: 0 8px 24px -4px rgba(90, 70, 50, 0.15), inset 0 0 45px rgba(0, 0, 0, 0.55);
    --sim-tabs-bg: rgba(0, 0, 0, 0.035);
    --sim-tabs-border: rgba(0, 0, 0, 0.07);
    --sim-tab-bg: rgba(255, 255, 255, 0.7);
    --sim-tab-border: rgba(0, 0, 0, 0.06);
    --sim-tab-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    --sim-tab-hover-bg: #FFFFFF;
    --sim-tab-hover-border: rgba(0, 0, 0, 0.12);
    --sim-tab-hover-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
    --sim-tab-dot: #CBD5E1;
    --sim-tab-label: #334155;
    --sim-tab-dim: #64748B;
    --sim-editorial-active-bg: #0F172A;
    --sim-editorial-active-color: #FFFFFF;
    --sim-editorial-active-shadow: 0 2px 10px rgba(15, 23, 42, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    --sim-tab-mobile-active-bg: #FFFFFF;
    --sim-tab-desktop-active-bg: #FFFFFF;
    --sim-tab-tablet-active-bg: #FFFFFF;
    --sim-tab-tv-active-bg: #FFFFFF;
    --sim-tab-active-label: #0F172A;

    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
    background: var(--sim-bg);
    border: 1.5px solid var(--sim-border);
    border-radius: 1.25rem;
    padding: 0.625rem 0.625rem 0.75rem;
    box-shadow: var(--sim-shadow);
    container-type: inline-size;
    position: relative;
    user-select: none;
    transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  /* ── Dark Theme Chassis Mode ── */
  :global(.dark) .hero-sim-root,
  :global([data-theme="dark"]) .hero-sim-root,
  :global(body:has(.theme-toggle-input:checked)) .hero-sim-root,
  :global(body:has(#theme-toggle:checked)) .hero-sim-root {
    --sim-bg: linear-gradient(180deg, #13161F 0%, #0D0F14 100%);
    --sim-border: rgba(255, 255, 255, 0.09);
    --sim-shadow:
      0 24px 60px -12px rgba(0, 0, 0, 0.8),
      0 4px 16px -2px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 0 0 1px rgba(255, 255, 255, 0.04);
    --sim-tally-color: #F1F5F9;
    --sim-tally-fps-bg: rgba(16, 185, 129, 0.12);
    --sim-tally-fps-color: #34D399;
    --sim-tally-fps-border: rgba(16, 185, 129, 0.3);
    --sim-nav-bg: rgba(255, 255, 255, 0.04);
    --sim-nav-border: rgba(255, 255, 255, 0.08);
    --sim-nav-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.4);
    --sim-pill-color: #94A3B8;
    --sim-pill-hover-color: #F8FAFC;
    --sim-pill-hover-bg: rgba(255, 255, 255, 0.08);
    --sim-stage-border: rgba(255, 255, 255, 0.09);
    --sim-stage-shadow: 0 8px 32px -4px rgba(0, 0, 0, 0.6), inset 0 0 45px rgba(0, 0, 0, 0.8);
    --sim-tabs-bg: rgba(0, 0, 0, 0.35);
    --sim-tabs-border: rgba(255, 255, 255, 0.06);
    --sim-tab-bg: rgba(255, 255, 255, 0.04);
    --sim-tab-border: rgba(255, 255, 255, 0.07);
    --sim-tab-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
    --sim-tab-hover-bg: rgba(255, 255, 255, 0.08);
    --sim-tab-hover-border: rgba(255, 255, 255, 0.14);
    --sim-tab-hover-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    --sim-tab-dot: #475569;
    --sim-tab-label: #E2E8F0;
    --sim-tab-dim: #94A3B8;
    --sim-editorial-active-bg: #F8FAFC;
    --sim-editorial-active-color: #0B0D10;
    --sim-editorial-active-shadow: 0 0 16px rgba(255, 255, 255, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    --sim-tab-mobile-active-bg: rgba(2, 132, 199, 0.18);
    --sim-tab-desktop-active-bg: rgba(16, 185, 129, 0.18);
    --sim-tab-tablet-active-bg: rgba(245, 158, 11, 0.18);
    --sim-tab-tv-active-bg: rgba(139, 92, 246, 0.18);
    --sim-tab-active-label: #FFFFFF;
  }

  /* ── Header Bar & Banner Style Switcher ── */
  .sim-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.15rem 0.25rem;
  }

  .sim-header-tally {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .sim-tally-dot {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: #059669;
    box-shadow: 0 0 6px #059669, 0 0 12px rgba(5, 150, 105, 0.4);
    animation: status-dot-pulse 2s infinite ease-in-out;
  }

  .sim-tally-label {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sim-tally-color);
    transition: color 0.2s ease;
  }

  .sim-tally-fps {
    font-size: 0.5625rem;
    font-family: var(--font-mono);
    font-weight: 600;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    background: var(--sim-tally-fps-bg);
    color: var(--sim-tally-fps-color);
    border: 1px solid var(--sim-tally-fps-border);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .sim-style-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    background: var(--sim-nav-bg);
    border: 1px solid var(--sim-nav-border);
    border-radius: 9999px;
    overflow-x: auto;
    max-width: 100%;
    scrollbar-width: none;
    box-shadow: var(--sim-nav-shadow);
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .sim-style-nav::-webkit-scrollbar {
    display: none;
  }

  .sim-style-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.28rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--sim-pill-color);
    background: transparent;
    cursor: pointer;
    line-height: 1;
    white-space: nowrap;
    user-select: none;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sim-style-pill:hover {
    color: var(--sim-pill-hover-color);
    background: var(--sim-pill-hover-bg);
  }

  /* ── Stage (2560 × 1440 / 16:9) ── */
  .sim-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 2560 / 1440;
    border-radius: 0.875rem;
    overflow: hidden;
    background: #030712;
    border: 2px solid var(--sim-stage-border);
    box-shadow: var(--sim-stage-shadow);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .sim-dropzone {
    position: absolute;
    inset: 0;
    display: block;
    text-decoration: none;
    cursor: pointer;
  }

  /* ── Multi-Artwork Layers ── */
  .sim-artwork-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
    user-select: none;
  }

  .art-backdrop-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(1.05) contrast(1.08);
  }

  .art-svg-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .art-scrim-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 90% 70% at 50% 50%, transparent 40%, rgba(3, 7, 18, 0.65) 100%);
    pointer-events: none;
  }

  .art-ambient-glow {
    position: absolute;
    inset: 0;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .art-tv-header {
    position: absolute;
    top: 6%;
    left: 4.5%;
    right: 4.5%;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    z-index: 2;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
  }

  .art-desktop-left {
    position: absolute;
    top: 50%;
    left: 3%;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 2;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
  }

  .art-desktop-right {
    position: absolute;
    top: 50%;
    right: 3%;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 2;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
  }

  /* ── Mobile Safe Area Core Centered (Crafted Elegant Glass HUD Plate) ── */
  .art-safe-core {
    position: absolute;
    top: 35.3125%;
    bottom: 35.3125%;
    left: 19.8047%;
    right: 19.8047%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 0 1.25rem;
    z-index: 2;
    background: linear-gradient(135deg, rgba(16, 20, 30, 0.68) 0%, rgba(8, 11, 18, 0.78) 100%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 12px;
    box-shadow:
      0 24px 48px -8px rgba(0, 0, 0, 0.8),
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 28px rgba(255, 255, 255, 0.06);
  }

  .safe-mark-wrap {
    position: relative;
    flex-shrink: 0;
  }

  /* ── Luxury Person Portrait Frame ── */
  .safe-person-frame {
    position: relative;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    overflow: hidden;
    background: #0C0E14;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.4), 0 4px 20px rgba(0, 0, 0, 0.7);
    flex-shrink: 0;
  }

  .safe-person-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    filter: contrast(1.08) brightness(1.04);
  }

  .safe-person-rim {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    pointer-events: none;
  }

  .safe-person-glow {
    position: absolute;
    inset: -6px;
    border-radius: 9999px;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .safe-verified-badge {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 17px;
    height: 17px;
    border-radius: 9999px;
    background: #00E5FF;
    color: #030712;
    font-size: 10px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #07090E;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.8), 0 0 8px currentColor;
    z-index: 3;
  }

  .safe-typography {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .safe-badge-strip {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.1rem;
  }

  .safe-pill-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.12rem 0.4rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-size: 0.525rem;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .safe-pill-stat {
    display: inline-flex;
    align-items: center;
    padding: 0.12rem 0.4rem;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 0.525rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .safe-channel-title {
    display: block;
    font-family: var(--font-display, var(--font-sans));
    font-size: 1.2rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    line-height: 1.1;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.85);
  }

  .safe-channel-sub {
    font-size: 0.5875rem;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.8);
    text-transform: uppercase;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
  }

  .reg-bracket {
    position: absolute;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.85rem;
    line-height: 1;
    pointer-events: none;
    user-select: none;
    text-shadow: 0 0 6px rgba(255, 255, 255, 0.4);
  }
  .reg-tl { top: 6px; left: 8px; }
  .reg-tr { top: 6px; right: 8px; }
  .reg-bl { bottom: 6px; left: 8px; }
  .reg-br { bottom: 6px; right: 8px; }

  .center-crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.35);
    pointer-events: none;
    text-shadow: 0 0 4px rgba(255, 255, 255, 0.2);
  }

  /* ── 3. Dynamic Crop Viewport Mask (Vignettes outer non-visible zones) ── */
  .sim-viewport-mask {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
    transition: backdrop-filter 0.3s ease, background 0.3s ease;
    animation: live-crop-mask 16s infinite ease-in-out;
  }

  /* ── 4. Dynamic Laser Crop Wireframe Boundary ── */
  .sim-crop-wireframe {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
    animation: live-crop-boundary 16s infinite ease-in-out;
  }

  /* Viewfinder Corner Brackets */
  .hud-corner {
    position: absolute;
    width: 10px;
    height: 10px;
    pointer-events: none;
    z-index: 6;
    color: #FFFFFF;
    filter: drop-shadow(0 0 3px rgba(255, 255, 255, 0.6));
  }
  .hud-tl { top: 0; left: 0; border-top: 2px solid currentColor; border-left: 2px solid currentColor; }
  .hud-tr { top: 0; right: 0; border-top: 2px solid currentColor; border-right: 2px solid currentColor; }
  .hud-bl { bottom: 0; left: 0; border-bottom: 2px solid currentColor; border-left: 2px solid currentColor; }
  .hud-br { bottom: 0; right: 0; border-bottom: 2px solid currentColor; border-right: 2px solid currentColor; }

  /* ── 5. Status Pill Readout ── */
  .sim-status-pill {
    position: absolute;
    top: 0.625rem;
    left: 0.625rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    background: rgba(9, 13, 22, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    z-index: 5;
    pointer-events: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .status-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #FFFFFF;
    box-shadow: 0 0 8px #FFFFFF, 0 0 14px rgba(255, 255, 255, 0.6);
    animation: status-dot-pulse 2s infinite ease-in-out;
  }

  .status-device-text {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status-dim-text {
    font-size: 0.5875rem;
    font-family: var(--font-mono);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.75);
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    padding-left: 0.45rem;
  }

  .status-aspect-tag {
    font-size: 0.525rem;
    padding: 0.08rem 0.3rem;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.12);
    color: #38BDF8;
    font-weight: 700;
  }

  /* ── 6. Hover Tooltip ── */
  .sim-launch-hint {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.95);
    color: #0F172A;
    font-size: 0.75rem;
    font-weight: 700;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5);
    z-index: 6;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  .sim-dropzone:hover .sim-launch-hint {
    opacity: 1;
    transform: translateY(0);
  }

  .sim-dropzone:hover .sim-viewport-mask,
  .sim-dropzone:hover .sim-crop-wireframe {
    animation-play-state: paused;
  }

  /* ── Tabs Below Preview (Studio Selector Deck) ── */
  .sim-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.45rem;
    padding: 0.3rem;
    background: var(--sim-tabs-bg);
    border: 1px solid var(--sim-tabs-border);
    border-radius: 0.875rem;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .sim-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.45rem 0.35rem;
    border-radius: 0.625rem;
    cursor: pointer;
    background: var(--sim-tab-bg);
    border: 1px solid var(--sim-tab-border);
    box-shadow: var(--sim-tab-shadow);
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    min-height: 48px;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .sim-tab:hover {
    background: var(--sim-tab-hover-bg);
    border-color: var(--sim-tab-hover-border);
    box-shadow: var(--sim-tab-hover-shadow);
  }

  .tab-indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--sim-tab-dot);
    transition: all 0.2s ease;
  }

  .sim-tab-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sim-tab-label);
    line-height: 1;
    transition: color 0.15s ease;
  }

  .sim-tab-dim {
    font-size: 0.6rem;
    color: var(--sim-tab-dim);
    line-height: 1;
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }

  /* ═══════════════════════════════════════════════════════════
     Banner Style Switching via :has(#hba-STYLE:checked)
  ═══════════════════════════════════════════════════════════ */
  :global(#hero-sim):has(#hba-finance:checked) .art-layer-finance,
  :global(#hero-sim):has(#hba-brand:checked) .art-layer-brand,
  :global(#hero-sim):has(#hba-cinema:checked) .art-layer-cinema,
