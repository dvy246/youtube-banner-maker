  :global(#hero-sim):has(#hba-editorial:checked) .art-layer-editorial,
  :global(#hero-sim):has(#hba-gaming:checked) .art-layer-gaming,
  :global(#hero-sim):has(#hba-anime:checked) .art-layer-anime {
    opacity: 1;
