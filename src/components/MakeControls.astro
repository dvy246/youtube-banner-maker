---
import RepositionControls from './RepositionControls.astro';
import ReencodeSimulation from './ReencodeSimulation.astro';
import ExportButton from './ExportButton.astro';
---

<div class="space-y-3">
  <!-- Top Bar: Layout Info + Change Template + Segmented Slider Tabs -->
  <div class="sticky top-0 z-20 p-3 rounded-lg border border-line-200 bg-surface-0/95 backdrop-blur-md shadow-2xs space-y-2.5">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-mono uppercase tracking-wider text-accent font-semibold px-1.5 py-0.5 rounded bg-accent/10 border border-accent/20">
          Layout
        </span>
        <h3 id="current-template-name" class="text-xs font-bold text-ink-950">
          Retro Synth
        </h3>
        <span id="current-template-niche" class="text-[9px] font-mono uppercase px-1.5 py-0.5 rounded-sm bg-surface-100 text-ink-600 border border-line-200">
          Gaming
        </span>
      </div>

      <button
        type="button"
        id="change-template-btn"
        class="min-h-[32px] px-2.5 py-1 rounded-md border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-950 text-[11px] font-medium inline-flex items-center justify-center gap-1.5 cursor-pointer focus-visible:ring-2 focus-visible:ring-accent transition-colors"
      >
        <span>Browse Templates</span>
      </button>
    </div>

    <!-- 3-Panel Streamlined Navigation (Pro Craft & Zero Emojis) -->
    <nav class="flex items-center justify-between p-1 bg-surface-100 rounded-lg border border-line-200 gap-1" role="tablist" aria-label="Editor Configuration Tabs">
      <button
        type="button"
        role="tab"
        data-deck-tab="text"
        aria-selected="true"
        class="deck-tab-btn flex-1 min-h-[36px] py-1 px-2 rounded-md text-[11px] font-semibold flex items-center justify-center gap-1.5 transition-all bg-surface-0 text-ink-950 shadow-xs border border-line-200 cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 text-ink-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <span>Brand &amp; Style</span>
      </button>
      <button
        type="button"
        role="tab"
        data-deck-tab="photo"
        aria-selected="false"
        class="deck-tab-btn flex-1 min-h-[36px] py-1 px-2 rounded-md text-[11px] font-medium flex items-center justify-center gap-1.5 transition-all bg-transparent text-ink-600 hover:text-ink-950 cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 text-ink-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>YouTube Badges &amp; Assets</span>
      </button>
      <button
        type="button"
        role="tab"
        data-deck-tab="export"
        aria-selected="false"
        class="deck-tab-btn flex-1 min-h-[36px] py-1 px-2 rounded-md text-[11px] font-medium flex items-center justify-center gap-1.5 transition-all bg-transparent text-ink-600 hover:text-ink-950 cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 text-ink-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Export &amp; Verify</span>
      </button>
    </nav>
  </div>

  <!-- Slide 1: Typography & Brand -->
  <div class="deck-slide space-y-2" data-slide-id="text">
    <section id="panel-text" class="p-4 rounded-lg border border-line-200 bg-surface-0 space-y-4">
    <div class="border-b border-line-100 pb-2.5">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">
        Typography &amp; Branding
      </h3>
      <p class="text-[11px] text-ink-500">
        Enter your channel name. Title size auto-fits to safe area in real-time.
      </p>
    </div>

    <!-- 1-Click Style Variations (Design System Cascade) -->
    <div class="p-3 rounded-lg border border-line-200 bg-surface-50 space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-ink-950">1-Click Style Variations</span>
        <span class="text-[10px] font-mono text-accent uppercase font-semibold">Theme Cascade</span>
      </div>
      <p class="text-[11px] text-ink-600">
        Instantly recolor all text, accents, backplates, and gradients in complete harmony.
      </p>
      <div class="grid grid-cols-4 gap-1.5 pt-1" id="variation-strip">
        <button
          type="button"
          class="variation-btn min-h-[38px] px-2 py-1.5 rounded-md border border-line-200 bg-surface-0 hover:bg-surface-100 text-ink-950 text-center transition-colors cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
          data-variation="original"
          title="Original template palette"
        >
          <div class="text-[11px] font-bold">Original</div>
          <div class="text-[9px] text-ink-500 font-mono">Preset</div>
        </button>
        <button
          type="button"
          class="variation-btn min-h-[38px] px-2 py-1.5 rounded-md border border-line-200 bg-surface-0 hover:bg-surface-100 text-ink-950 text-center transition-colors cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
          data-variation="dark"
          title="Dark Noir inverted palette"
        >
          <div class="text-[11px] font-bold">Dark Noir</div>
          <div class="text-[9px] text-ink-500 font-mono">Invert</div>
        </button>
        <button
          type="button"
          class="variation-btn min-h-[38px] px-2 py-1.5 rounded-md border border-line-200 bg-surface-0 hover:bg-surface-100 text-ink-950 text-center transition-colors cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
          data-variation="warm"
          title="Warm amber/golden shift"
        >
          <div class="text-[11px] font-bold">Warm</div>
          <div class="text-[9px] text-ink-500 font-mono">+30° Hue</div>
        </button>
        <button
          type="button"
          class="variation-btn min-h-[38px] px-2 py-1.5 rounded-md border border-line-200 bg-surface-0 hover:bg-surface-100 text-ink-950 text-center transition-colors cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
          data-variation="cool"
          title="Cool cyan/indigo shift"
        >
          <div class="text-[11px] font-bold">Cool</div>
          <div class="text-[9px] text-ink-500 font-mono">-30° Hue</div>
        </button>
      </div>
    </div>

    <!-- 1-Click Fast Customizations (No-Canva-Fatigue) -->
    <div class="space-y-3 pb-2 border-b border-line-100">
      <!-- Instant Layout Presets -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-[11px] text-ink-600">
          <span>Instant Safe Layouts</span>
          <span class="text-[10px] text-ink-400 font-mono">1-Click</span>
        </div>
        <div class="grid grid-cols-3 gap-1.5">
          <button
            type="button"
            id="layout-preset-left"
            class="min-h-[34px] px-2 py-1 rounded-md text-[11px] font-medium border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-800 flex items-center justify-center gap-1 cursor-pointer transition-colors"
            title="Avatar Left, Text Right"
          >
            <span>👤 Left + Text</span>
          </button>
          <button
            type="button"
            id="layout-preset-center"
            class="min-h-[34px] px-2 py-1 rounded-md text-[11px] font-medium border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-800 flex items-center justify-center gap-1 cursor-pointer transition-colors"
            title="Centered Avatar & Text"
          >
            <span>🎯 Centered</span>
          </button>
          <button
            type="button"
            id="layout-preset-right"
            class="min-h-[34px] px-2 py-1 rounded-md text-[11px] font-medium border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-800 flex items-center justify-center gap-1 cursor-pointer transition-colors"
            title="Text Left, Card Right"
          >
            <span>Text + Card 👤</span>
          </button>
        </div>
      </div>

      <!-- Curated Font Pairings -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-[11px] text-ink-600">
          <span>Curated Typography Pairings</span>
          <span class="text-[10px] text-ink-400 font-mono">Pro Craft</span>
        </div>
        <div class="grid grid-cols-2 gap-1.5" id="font-pairing-presets">
          <button
            type="button"
            class="font-pair-btn min-h-[36px] px-2.5 py-1.5 rounded-md text-left border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-950 transition-colors cursor-pointer group"
            data-font-title="sora-700"
            data-font-tagline="inter-500"
          >
            <div class="text-[11px] font-bold tracking-tight">Sora + Inter</div>
            <div class="text-[9px] text-ink-500">Modern Tech</div>
          </button>
          <button
            type="button"
            class="font-pair-btn min-h-[36px] px-2.5 py-1.5 rounded-md text-left border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-950 transition-colors cursor-pointer group"
            data-font-title="bebas-400"
            data-font-tagline="space-grotesk-700"
          >
            <div class="text-[11px] font-bold tracking-tight uppercase">Bebas + Space</div>
            <div class="text-[9px] text-ink-500">Cinematic Punch</div>
          </button>
          <button
            type="button"
            class="font-pair-btn min-h-[36px] px-2.5 py-1.5 rounded-md text-left border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-950 transition-colors cursor-pointer group"
            data-font-title="playfair-700"
            data-font-tagline="inter-500"
          >
            <div class="text-[11px] font-serif font-bold">Playfair + Inter</div>
            <div class="text-[9px] text-ink-500">Editorial Luxury</div>
          </button>
          <button
            type="button"
            class="font-pair-btn min-h-[36px] px-2.5 py-1.5 rounded-md text-left border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-950 transition-colors cursor-pointer group"
            data-font-title="jetbrains-mono-700"
            data-font-tagline="inter-500"
          >
            <div class="text-[11px] font-mono font-bold">Mono + Inter</div>
            <div class="text-[9px] text-ink-500">Developer Clean</div>
          </button>
        </div>
      </div>

      <!-- Quick Tagline Ideas -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-[11px] text-ink-600">
          <span>Quick Tagline Ideas</span>
          <span class="text-[10px] text-ink-400 font-mono">Instant Insert</span>
        </div>
        <div class="flex flex-wrap gap-1.5" id="tagline-inspiration-chips">
          <button
            type="button"
            class="tagline-chip text-[10px] px-2 py-1 rounded-md border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-700 hover:text-ink-950 cursor-pointer transition-colors"
            data-tagline="New Videos Every Week · 6PM EST"
          >
            + New Videos Weekly
          </button>
          <button
            type="button"
            class="tagline-chip text-[10px] px-2 py-1 rounded-md border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-700 hover:text-ink-950 cursor-pointer transition-colors"
            data-tagline="Tech Reviews · Setups · Workflow"
          >
            + Tech &amp; Setups
          </button>
          <button
            type="button"
            class="tagline-chip text-[10px] px-2 py-1 rounded-md border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-700 hover:text-ink-950 cursor-pointer transition-colors"
            data-tagline="Slow Living · Design · Visual Essays"
          >
            + Slow Living &amp; Design
          </button>
          <button
            type="button"
            class="tagline-chip text-[10px] px-2 py-1 rounded-md border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-700 hover:text-ink-950 cursor-pointer transition-colors"
            data-tagline="Deep Dives &amp; Unfiltered Discussions"
          >
            + Podcast &amp; Deep Dives
          </button>
        </div>
      </div>
    </div>

    <!-- Container where editable layers are rendered (Protected layers are strictly ABSENT) -->
    <div id="text-layers-container" class="space-y-4">
      <!-- Title Layer (Default SSR) -->
      <div class="layer-control-card space-y-2.5 p-3 rounded-lg bg-surface-50 border border-line-200" data-layer-id="title">
        <div class="flex items-center justify-between text-xs font-medium text-ink-950">
          <span>Channel Title</span>
          <span class="text-[10px] font-mono text-ink-500">Safe-Area Bound</span>
        </div>

        <div>
          <label for="layer-text-title" class="sr-only">Channel Title Text</label>
          <input
            type="text"
            id="layer-text-title"
            class="layer-text-input w-full min-h-[44px] px-3 py-2 text-xs rounded-md border border-line-200 bg-surface-0 text-ink-950 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-accent"
            value="RETRO WAVE"
            data-layer-id="title"
            placeholder="Your Channel Name"
          />
        </div>

        <div class="grid grid-cols-2 gap-2 pt-1">
          <div>
            <label for="layer-color-title" class="block text-[11px] text-ink-600 mb-1">Color</label>
            <div class="flex items-center gap-2">
              <input
                type="color"
                id="layer-color-title"
                class="layer-color-input w-9 h-9 min-h-[44px] min-w-[44px] rounded border border-line-200 cursor-pointer p-0.5 bg-surface-0"
                value="#FFFFFF"
                data-layer-id="title"
                aria-label="Title text color"
              />
              <span class="layer-color-hex text-[11px] font-mono text-ink-600">#FFFFFF</span>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between text-[11px] text-ink-600 mb-1">
              <label for="layer-size-title">Size</label>
              <span class="layer-size-val font-mono text-[10px] text-ink-500">54px</span>
            </div>
            <input
              type="range"
              id="layer-size-title"
              min="16"
              max="96"
              value="54"
              class="layer-size-slider w-full h-3 bg-surface-200 rounded-lg appearance-none cursor-pointer accent-ink-950"
              data-layer-id="title"
              aria-label="Title font size"
            />
          </div>
        </div>

        <div class="pt-1 flex items-center justify-between">
          <span class="text-[11px] text-ink-600">Alignment</span>
          <div class="flex items-center gap-1">
            <button
              type="button"
              class="layer-align-btn min-h-[44px] min-w-[44px] p-2 rounded border border-line-200 bg-surface-0 hover:bg-surface-100 text-ink-800 text-xs flex items-center justify-center cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
              data-layer-id="title"
              data-align="left"
              aria-label="Align left"
              title="Align left"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h10.5m-10.5 5.25h16.5" />
              </svg>
            </button>
            <button
              type="button"
              class="layer-align-btn min-h-[44px] min-w-[44px] p-2 rounded border border-line-200 bg-ink-950 text-surface-0 text-xs flex items-center justify-center cursor-pointer focus-visible:ring-2 focus-visible:ring-accent active-align"
              data-layer-id="title"
              data-align="center"
              aria-label="Align center"
              title="Align center"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M6.75 12h10.5m-13.5 5.25h16.5" />
              </svg>
            </button>
            <button
              type="button"
              class="layer-align-btn min-h-[44px] min-w-[44px] p-2 rounded border border-line-200 bg-surface-0 hover:bg-surface-100 text-ink-800 text-xs flex items-center justify-center cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
              data-layer-id="title"
              data-align="right"
              aria-label="Align right"
              title="Align right"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M9.75 12h10.5m-16.5 5.25h16.5" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Tagline Layer (Default SSR) -->
      <div class="layer-control-card space-y-2.5 p-3 rounded-lg bg-surface-50 border border-line-200" data-layer-id="tagline">
        <div class="flex items-center justify-between text-xs font-medium text-ink-950">
          <span>Tagline / Subtitle</span>
          <span class="text-[10px] font-mono text-ink-500">Safe-Area Bound</span>
        </div>

        <div>
          <label for="layer-text-tagline" class="sr-only">Tagline Text</label>
          <input
            type="text"
            id="layer-text-tagline"
            class="layer-text-input w-full min-h-[44px] px-3 py-2 text-xs rounded-md border border-line-200 bg-surface-0 text-ink-950 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-accent"
            value="Synthwave & Gaming Live Streams"
            data-layer-id="tagline"
            placeholder="Your Tagline or Upload Schedule"
          />
        </div>

        <div class="grid grid-cols-2 gap-2 pt-1">
          <div>
            <label for="layer-color-tagline" class="block text-[11px] text-ink-600 mb-1">Color</label>
            <div class="flex items-center gap-2">
              <input
                type="color"
                id="layer-color-tagline"
                class="layer-color-input w-9 h-9 min-h-[44px] min-w-[44px] rounded border border-line-200 cursor-pointer p-0.5 bg-surface-0"
                value="#FF88DC"
                data-layer-id="tagline"
                aria-label="Tagline text color"
              />
              <span class="layer-color-hex text-[11px] font-mono text-ink-600">#FF88DC</span>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between text-[11px] text-ink-600 mb-1">
              <label for="layer-size-tagline">Size</label>
              <span class="layer-size-val font-mono text-[10px] text-ink-500">22px</span>
            </div>
            <input
              type="range"
              id="layer-size-tagline"
              min="16"
              max="96"
              value="22"
              class="layer-size-slider w-full h-3 bg-surface-200 rounded-lg appearance-none cursor-pointer accent-ink-950"
              data-layer-id="tagline"
              aria-label="Tagline font size"
            />
          </div>
        </div>

        <div class="pt-1 flex items-center justify-between">
          <span class="text-[11px] text-ink-600">Alignment</span>
          <div class="flex items-center gap-1">
            <button
              type="button"
              class="layer-align-btn min-h-[44px] min-w-[44px] p-2 rounded border border-line-200 bg-surface-0 hover:bg-surface-100 text-ink-800 text-xs flex items-center justify-center cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
              data-layer-id="tagline"
              data-align="left"
              aria-label="Align left"
              title="Align left"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h10.5m-10.5 5.25h16.5" />
              </svg>
            </button>
            <button
              type="button"
              class="layer-align-btn min-h-[44px] min-w-[44px] p-2 rounded border border-line-200 bg-ink-950 text-surface-0 text-xs flex items-center justify-center cursor-pointer focus-visible:ring-2 focus-visible:ring-accent active-align"
              data-layer-id="tagline"
              data-align="center"
              aria-label="Align center"
              title="Align center"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M6.75 12h10.5m-13.5 5.25h16.5" />
              </svg>
            </button>
            <button
              type="button"
              class="layer-align-btn min-h-[44px] min-w-[44px] p-2 rounded border border-line-200 bg-surface-0 hover:bg-surface-100 text-ink-800 text-xs flex items-center justify-center cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
              data-layer-id="tagline"
              data-align="right"
              aria-label="Align right"
              title="Align right"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M9.75 12h10.5m-16.5 5.25h16.5" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
    <div class="flex justify-end pt-1">
      <button
        type="button"
        data-slide-nav="photo"
        class="text-xs font-semibold text-accent hover:underline inline-flex items-center gap-1 cursor-pointer py-1 px-2 rounded hover:bg-accent/5"
      >
        <span>Photo Frame &amp; Avatar →</span>
      </button>
    </div>
  </div>

  <!-- Slide 2: YouTube Badges & Assets -->
  <div class="deck-slide hidden space-y-2" data-slide-id="photo">
    <section id="panel-photo-frame" class="p-4 rounded-lg border border-line-200 bg-surface-0 space-y-4">
    <div class="border-b border-line-100 pb-2.5 flex items-center justify-between">
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">
          YouTube Badges &amp; Assets
        </h3>
        <p class="text-[11px] text-ink-500">
          Official YouTube Subscribe buttons, notification bells, avatar frames, and background styling.
        </p>
      </div>
      <span id="frame-status-badge" class="text-[10px] font-mono uppercase px-2 py-0.5 rounded-sm bg-accent/10 text-accent border border-accent/20">
        Ready
      </span>
    </div>

    <!-- 1-Click YouTube Badges & Conversion CTAs (Eliminates Flaticon Friction) -->
    <div class="p-3 rounded-lg border border-line-200 bg-surface-50 space-y-3">
      <div class="flex items-center justify-between">
        <h4 class="text-xs font-bold text-ink-950 uppercase tracking-wider">
          YouTube Call-to-Action Badges
        </h4>
        <span class="text-[10px] font-mono text-accent uppercase font-semibold">1-Click Badges</span>
      </div>
      <p class="text-[11px] text-ink-600">
