        >
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-ink-950">{t.motion.presetCinema}</span>
            <span class="text-[9px] font-mono text-accent">Film 4K</span>
          </div>
          <p class="text-[10px] text-ink-500 leading-tight">{t.motion.presetCinemaDesc}</p>
        </button>

        <button
          type="button"
          class="motion-preset-btn p-2.5 rounded-xl border border-line-200 bg-surface-50 hover:bg-surface-100 text-left transition-all cursor-pointer flex flex-col gap-1 sm:col-span-2 active:scale-[0.98]"
          data-motion="esports-hud"
        >
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-ink-950">{t.motion.presetHud}</span>
