---
import RepositionControls from './RepositionControls.astro';
import ReencodeSimulation from './ReencodeSimulation.astro';
import ExportButton from './ExportButton.astro';
import { getTranslations, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getTranslations(locale).toolUi.makeControls;
---

<div class="space-y-3">
  <!-- Top Bar: Layout Info + Change Template + Segmented Slider Tabs -->
  <div class="sticky top-0 z-20 p-3 rounded-lg border border-line-200 bg-surface-0/95 backdrop-blur-md shadow-2xs space-y-2.5">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-mono uppercase tracking-wider text-accent font-semibold px-1.5 py-0.5 rounded bg-accent/10 border border-accent/20">
          {t.layout}
        </span>
        <h3 id="current-template-name" class="text-xs font-bold text-ink-950">
          Retro Synth
        </h3>
        <span id="current-template-niche" class="text-[9px] font-mono uppercase px-1.5 py-0.5 rounded-sm bg-surface-100 text-ink-600 border border-line-200">
          Gaming
        </span>
      </div>

      <button
        type="button"
        id="change-template-btn"
        class="min-h-[32px] px-3 py-1 rounded-full border border-line-200 bg-surface-50 hover:bg-surface-100 active:scale-[0.98] text-ink-950 text-[11px] font-medium inline-flex items-center justify-center gap-1.5 cursor-pointer focus-visible:ring-2 focus-visible:ring-accent transition-all"
      >
        <span>{t.browseTemplates}</span>
      </button>
    </div>

    <!-- 3-Panel Streamlined Navigation (Pro Craft & Zero Emojis) -->
    <nav class="flex items-center justify-between p-1 bg-surface-100 rounded-full border border-line-200 gap-1" role="tablist" aria-label="Editor Configuration Tabs">
      <button
        type="button"
        role="tab"
        data-deck-tab="text"
        aria-selected="true"
        class="deck-tab-btn flex-1 min-h-[36px] py-1 px-2 rounded-full text-[11px] font-semibold flex items-center justify-center gap-1.5 transition-all bg-surface-0 text-ink-950 shadow-xs border border-line-200 cursor-pointer active:scale-[0.98]"
      >
        <svg class="w-3.5 h-3.5 text-ink-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <span class="sm:hidden">{t.tabs.brand}</span>
        <span class="hidden sm:inline">{t.tabs.brandFull}</span>
      </button>
      <button
        type="button"
        role="tab"
        data-deck-tab="photo"
        aria-selected="false"
        class="deck-tab-btn flex-1 min-h-[36px] py-1 px-2 rounded-full text-[11px] font-medium flex items-center justify-center gap-1.5 transition-all bg-transparent text-ink-600 hover:text-ink-950 cursor-pointer active:scale-[0.98]"
      >
        <svg class="w-3.5 h-3.5 text-ink-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="sm:hidden">{t.tabs.badges}</span>
        <span class="hidden sm:inline">{t.tabs.badgesFull}</span>
      </button>
      <button
        type="button"
        role="tab"
        data-deck-tab="background"
        aria-selected="false"
        class="deck-tab-btn flex-1 min-h-[36px] py-1 px-2 rounded-full text-[11px] font-medium flex items-center justify-center gap-1.5 transition-all bg-transparent text-ink-600 hover:text-ink-950 cursor-pointer active:scale-[0.98]"
      >
        <svg class="w-3.5 h-3.5 text-ink-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span class="sm:hidden">Bg</span>
        <span class="hidden sm:inline">Background</span>
      </button>
      <button
        type="button"
        role="tab"
        data-deck-tab="motion"
        aria-selected="false"
        class="deck-tab-btn flex-1 min-h-[36px] py-1 px-2 rounded-full text-[11px] font-medium flex items-center justify-center gap-1.5 transition-all bg-transparent text-ink-600 hover:text-ink-950 cursor-pointer active:scale-[0.98]"
      >
        <svg class="w-3.5 h-3.5 text-ink-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
        </svg>
        <span class="sm:hidden">Motion</span>
        <span class="hidden sm:inline">Motion</span>
      </button>
      <button
        type="button"
        role="tab"
        data-deck-tab="export"
        aria-selected="false"
        class="deck-tab-btn flex-1 min-h-[36px] py-1 px-2 rounded-full text-[11px] font-medium flex items-center justify-center gap-1.5 transition-all bg-transparent text-ink-600 hover:text-ink-950 cursor-pointer active:scale-[0.98]"
      >
        <svg class="w-3.5 h-3.5 text-ink-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span class="sm:hidden">{t.tabs.export}</span>
        <span class="hidden sm:inline">{t.tabs.exportFull}</span>
      </button>
    </nav>
  </div>

  <!-- Slide 1: Typography & Brand -->
  <div class="deck-slide space-y-2" data-slide-id="text">
    <section id="panel-text" class="p-4 rounded-lg border border-line-200 bg-surface-0 space-y-4">
    <div class="border-b border-line-100 pb-2.5">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">
        {t.typography.title}
      </h3>
      <p class="text-[11px] text-ink-500">
        {t.typography.desc}
      </p>
    </div>

    <!-- 1-Click Style Variations (Design System Cascade) -->
    <div class="p-3 rounded-lg border border-line-200 bg-surface-50 space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-ink-950">{t.typography.styleVariations}</span>
        <span class="text-[10px] font-mono text-accent uppercase font-semibold">{t.typography.themeCascade}</span>
      </div>
      <p class="text-[11px] text-ink-600">
        {t.typography.cascadeDesc}
      </p>
      <div class="grid grid-cols-3 gap-1.5 pt-1" id="variation-strip">
        <button
          type="button"
          class="variation-btn min-h-[40px] px-2 py-1.5 rounded-xl border border-line-200 bg-surface-0 hover:bg-surface-100 active:scale-[0.98] text-ink-950 text-center transition-all cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
          data-variation="original"
          title="Original template palette"
        >
          <div class="text-[11px] font-bold leading-tight">{t.typography.varOriginal}</div>
          <div class="text-[9px] text-ink-500 font-mono">{t.typography.varOriginalSub}</div>
        </button>
        <button
          type="button"
          class="variation-btn min-h-[40px] px-2 py-1.5 rounded-xl border border-line-200 bg-surface-0 hover:bg-surface-100 active:scale-[0.98] text-ink-950 text-center transition-all cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
          data-variation="dark"
          title="Dark Noir inverted palette"
        >
          <div class="text-[11px] font-bold leading-tight">{t.typography.varDark}</div>
          <div class="text-[9px] text-ink-500 font-mono">{t.typography.varDarkSub}</div>
        </button>
        <button
          type="button"
          class="variation-btn min-h-[40px] px-2 py-1.5 rounded-xl border border-line-200 bg-surface-0 hover:bg-surface-100 active:scale-[0.98] text-ink-950 text-center transition-all cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
          data-variation="editorial"
          title="Editorial Warm Pearl aesthetic"
        >
          <div class="text-[11px] font-bold leading-tight">{t.typography.varEditorial}</div>
          <div class="text-[9px] text-ink-500 font-mono">{t.typography.varEditorialSub}</div>
        </button>
        <button
          type="button"
          class="variation-btn min-h-[40px] px-2 py-1.5 rounded-xl border border-line-200 bg-surface-0 hover:bg-surface-100 active:scale-[0.98] text-ink-950 text-center transition-all cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
          data-variation="cyberpunk"
          title="Cyberpunk Neon futuristic aesthetic"
        >
          <div class="text-[11px] font-bold leading-tight">{t.typography.varCyberpunk}</div>
          <div class="text-[9px] text-ink-500 font-mono">{t.typography.varCyberpunkSub}</div>
        </button>
        <button
          type="button"
          class="variation-btn min-h-[40px] px-2 py-1.5 rounded-xl border border-line-200 bg-surface-0 hover:bg-surface-100 active:scale-[0.98] text-ink-950 text-center transition-all cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
          data-variation="minimalist"
          title="Stealth Minimalist clean monochrome"
        >
          <div class="text-[11px] font-bold leading-tight">{t.typography.varMinimalist}</div>
          <div class="text-[9px] text-ink-500 font-mono">{t.typography.varMinimalistSub}</div>
        </button>
        <button
          type="button"
          class="variation-btn min-h-[40px] px-2 py-1.5 rounded-xl border border-line-200 bg-surface-0 hover:bg-surface-100 active:scale-[0.98] text-ink-950 text-center transition-all cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
          data-variation="sunset"
          title="Sunset Luxe warm radiant aesthetic"
        >
          <div class="text-[11px] font-bold leading-tight">{t.typography.varSunset}</div>
          <div class="text-[9px] text-ink-500 font-mono">{t.typography.varSunsetSub}</div>
        </button>
      </div>
    </div>

    <!-- 1-Click Fast Customizations (No-Canva-Fatigue) -->
    <div class="space-y-3 pb-2 border-b border-line-100">
      <!-- Smart Safe-Snap Engine (4 Certified Safe Presets) -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-[11px] text-ink-600">
          <span class="font-medium text-ink-950">{t.typography.safeLayouts}</span>
          <span class="text-[10px] text-accent font-mono font-semibold">1-Click Safe-Snap</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5">
          <button
            type="button"
            id="layout-preset-center"
            data-snap="center"
            class="snap-btn min-h-[36px] px-2.5 py-1.5 rounded-xl text-[11px] font-medium border border-line-200 bg-surface-50 hover:bg-surface-100 active:scale-[0.98] text-ink-800 flex items-center justify-center gap-1 cursor-pointer transition-all focus-visible:ring-2 focus-visible:ring-accent"
            title="True Center: Mathematically centered in mobile safe zone"
          >
            <span>True Center</span>
          </button>
          <button
            type="button"
            id="layout-preset-left"
            data-snap="split-left"
            class="snap-btn min-h-[36px] px-2.5 py-1.5 rounded-xl text-[11px] font-medium border border-line-200 bg-surface-50 hover:bg-surface-100 active:scale-[0.98] text-ink-800 flex items-center justify-center gap-1 cursor-pointer transition-all focus-visible:ring-2 focus-visible:ring-accent"
            title="Split-Left: Avatar left, Text right"
          >
            <span>Split-Left</span>
          </button>
          <button
            type="button"
            id="layout-preset-right"
            data-snap="split-right"
            class="snap-btn min-h-[36px] px-2.5 py-1.5 rounded-xl text-[11px] font-medium border border-line-200 bg-surface-50 hover:bg-surface-100 active:scale-[0.98] text-ink-800 flex items-center justify-center gap-1 cursor-pointer transition-all focus-visible:ring-2 focus-visible:ring-accent"
            title="Split-Right: Text left, Avatar right"
          >
            <span>Split-Right</span>
          </button>
          <button
            type="button"
            id="layout-preset-stacked"
            data-snap="stacked"
            class="snap-btn min-h-[36px] px-2.5 py-1.5 rounded-xl text-[11px] font-medium border border-line-200 bg-surface-50 hover:bg-surface-100 active:scale-[0.98] text-ink-800 flex items-center justify-center gap-1 cursor-pointer transition-all focus-visible:ring-2 focus-visible:ring-accent"
            title="Stacked: Centered avatar stacked above title"
          >
            <span>Stacked</span>
          </button>
        </div>
      </div>

      <!-- Curated Font Pairings -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-[11px] text-ink-600">
          <span>{t.typography.curatedPairings}</span>
          <span class="text-[10px] text-ink-400 font-mono">{t.typography.proCraft}</span>
        </div>
        <div class="grid grid-cols-2 gap-1.5" id="font-pairing-presets">
          <button
            type="button"
            class="font-pair-btn min-h-[36px] px-2.5 py-1.5 rounded-xl text-left border border-line-200 bg-surface-50 hover:bg-surface-100 active:scale-[0.98] text-ink-950 transition-all cursor-pointer group"
            data-font-title="sora-700"
            data-font-tagline="inter-500"
          >
            <div class="text-[11px] font-bold tracking-tight">Sora + Inter</div>
            <div class="text-[9px] text-ink-500">{t.typography.pairingTech}</div>
          </button>
          <button
            type="button"
            class="font-pair-btn min-h-[36px] px-2.5 py-1.5 rounded-xl text-left border border-line-200 bg-surface-50 hover:bg-surface-100 active:scale-[0.98] text-ink-950 transition-all cursor-pointer group"
            data-font-title="bebas-400"
            data-font-tagline="space-grotesk-700"
          >
            <div class="text-[11px] font-bold tracking-tight uppercase">Bebas + Space</div>
            <div class="text-[9px] text-ink-500">{t.typography.pairingPunch}</div>
          </button>
          <button
            type="button"
            class="font-pair-btn min-h-[36px] px-2.5 py-1.5 rounded-xl text-left border border-line-200 bg-surface-50 hover:bg-surface-100 active:scale-[0.98] text-ink-950 transition-all cursor-pointer group"
            data-font-title="playfair-700"
            data-font-tagline="inter-500"
          >
            <div class="text-[11px] font-serif font-bold">Playfair + Inter</div>
            <div class="text-[9px] text-ink-500">{t.typography.pairingLuxury}</div>
          </button>
          <button
            type="button"
            class="font-pair-btn min-h-[36px] px-2.5 py-1.5 rounded-xl text-left border border-line-200 bg-surface-50 hover:bg-surface-100 active:scale-[0.98] text-ink-950 transition-all cursor-pointer group"
            data-font-title="jetbrains-mono-700"
            data-font-tagline="inter-500"
          >
            <div class="text-[11px] font-mono font-bold">Mono + Inter</div>
            <div class="text-[9px] text-ink-500">{t.typography.pairingClean}</div>
          </button>
        </div>
      </div>

      <!-- Quick Tagline Ideas -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-[11px] text-ink-600">
          <span>{t.typography.taglineIdeas}</span>
          <span class="text-[10px] text-ink-400 font-mono">{t.typography.instantInsert}</span>
        </div>
        <div class="flex flex-wrap gap-1.5" id="tagline-inspiration-chips">
          <button
            type="button"
            class="tagline-chip text-[10px] px-2.5 py-1 rounded-full border border-line-200 bg-surface-50 hover:bg-surface-100 active:scale-[0.98] text-ink-700 hover:text-ink-950 cursor-pointer transition-all"
            data-tagline="New Videos Every Week · 6PM EST"
          >
            {t.typography.taglineWeekly}
          </button>
          <button
            type="button"
            class="tagline-chip text-[10px] px-2.5 py-1 rounded-full border border-line-200 bg-surface-50 hover:bg-surface-100 active:scale-[0.98] text-ink-700 hover:text-ink-950 cursor-pointer transition-all"
            data-tagline="Tech Reviews · Setups · Workflow"
          >
            {t.typography.taglineTech}
          </button>
          <button
            type="button"
            class="tagline-chip text-[10px] px-2.5 py-1 rounded-full border border-line-200 bg-surface-50 hover:bg-surface-100 active:scale-[0.98] text-ink-700 hover:text-ink-950 cursor-pointer transition-all"
            data-tagline="Slow Living · Design · Visual Essays"
          >
            {t.typography.taglineSlow}
          </button>
          <button
            type="button"
            class="tagline-chip text-[10px] px-2.5 py-1 rounded-full border border-line-200 bg-surface-50 hover:bg-surface-100 active:scale-[0.98] text-ink-700 hover:text-ink-950 cursor-pointer transition-all"
            data-tagline="Deep Dives &amp; Unfiltered Discussions"
          >
            {t.typography.taglinePodcast}
          </button>
        </div>
      </div>
    </div>

    <!-- Contrast Guard & Studio Scrim (Legibility Assurance) -->
    <div class="p-3 rounded-2xl border border-line-200 bg-surface-50 space-y-2.5">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-1.5">
          <span class="text-xs font-bold text-ink-950">Contrast Guard</span>
          <span class="text-[9px] font-mono uppercase px-1.5 py-0.5 rounded-full bg-accent/10 text-accent font-semibold">Pro Legibility</span>
        </div>
        <button
          type="button"
          id="btn-autofit-text"
          class="min-h-[32px] px-3 py-1 rounded-full border border-line-200 bg-surface-0 hover:bg-surface-100 active:scale-[0.98] text-ink-950 text-[11px] font-semibold inline-flex items-center justify-center gap-1 cursor-pointer shadow-2xs transition-all focus-visible:ring-2 focus-visible:ring-accent"
          title="Auto-calculate optimal font size to prevent mobile safe area overflow"
        >
          <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
          </svg>
          <span>Auto-Fit Safe Width</span>
        </button>
      </div>
      <p class="text-[11px] text-ink-600">
        Prevent text overflow across mobile screens and elevate legibility against bright backgrounds.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
        <!-- Studio Scrim Slider -->
        <div class="p-2.5 rounded-xl border border-line-200 bg-surface-0 space-y-1.5">
          <div class="flex items-center justify-between text-[11px] text-ink-600">
            <label for="scrim-slider" class="font-medium text-ink-950">Studio Scrim (Vignette)</label>
            <span id="scrim-val" class="font-mono text-[10px] text-ink-500">0%</span>
          </div>
          <input
            type="range"
            id="scrim-slider"
            min="0"
            max="100"
            step="5"
            value="0"
            class="w-full h-2.5 bg-surface-200 rounded-lg appearance-none cursor-pointer accent-accent"
            aria-label="Studio Scrim Vignette Intensity"
          />
        </div>

        <!-- Aero Plate Frosted Glass Toggle -->
        <div class="p-2.5 rounded-xl border border-line-200 bg-surface-0 flex items-center justify-between">
          <div>
            <div class="text-[11px] font-semibold text-ink-950">Aero Plate Backing</div>
            <div class="text-[9px] text-ink-500 font-mono">Frosted glass backdrop</div>
          </div>
          <button
            type="button"
            id="toggle-aero-plate-btn"
            class="min-h-[32px] px-3 py-1 rounded-full border border-line-200 bg-surface-50 hover:bg-surface-100 active:scale-[0.98] text-ink-800 text-[11px] font-semibold cursor-pointer transition-all"
            data-enabled="false"
          >
            <span>Off</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Container where editable layers are rendered (Protected layers are strictly ABSENT) -->
    <div id="text-layers-container" class="space-y-4">
      <!-- Title Layer (Default SSR) -->
      <div class="layer-control-card space-y-2.5 p-3 rounded-lg bg-surface-50 border border-line-200" data-layer-id="title">
        <div class="flex items-center justify-between text-xs font-medium text-ink-950">
          <span>{t.typography.channelTitle}</span>
          <span class="text-[10px] font-mono text-ink-500">{t.typography.safeAreaBound}</span>
        </div>

        <div>
          <label for="layer-text-title" class="sr-only">Channel Title Text</label>
          <input
            type="text"
            id="layer-text-title"
            class="layer-text-input w-full min-h-[44px] px-3 py-2 text-xs rounded-md border border-line-200 bg-surface-0 text-ink-950 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-accent"
            value="RETRO WAVE"
            data-layer-id="title"
            placeholder={t.typography.placeholderTitle}
          />
        </div>

        <div class="grid grid-cols-2 gap-2 pt-1">
          <div>
            <label for="layer-color-title" class="block text-[11px] text-ink-600 mb-1">{t.typography.color}</label>
            <div class="flex items-center gap-2">
              <input
                type="color"
                id="layer-color-title"
                class="layer-color-input w-9 h-9 min-h-[44px] min-w-[44px] rounded border border-line-200 cursor-pointer p-0.5 bg-surface-0"
                value="#FFFFFF"
                data-layer-id="title"
                aria-label="Title text color"
              />
              <span class="layer-color-hex text-[11px] font-mono text-ink-600">#FFFFFF</span>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between text-[11px] text-ink-600 mb-1">
              <label for="layer-size-title">{t.typography.size}</label>
              <span class="layer-size-val font-mono text-[10px] text-ink-500">54px</span>
            </div>
            <input
              type="range"
              id="layer-size-title"
              min="16"
              max="96"
              value="54"
              class="layer-size-slider w-full h-3 bg-surface-200 rounded-lg appearance-none cursor-pointer accent-ink-950"
              data-layer-id="title"
              aria-label="Title font size"
            />
          </div>
        </div>

        <div class="pt-1 flex items-center justify-between">
          <span class="text-[11px] text-ink-600">{t.typography.alignment}</span>
          <div class="flex items-center gap-1">
            <button
              type="button"
