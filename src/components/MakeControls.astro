---
import RepositionControls from './RepositionControls.astro';
import ReencodeSimulation from './ReencodeSimulation.astro';
import ExportButton from './ExportButton.astro';
---

<div class="space-y-4">
  <!-- Template Switcher Card -->
  <div class="p-4 rounded-lg border border-line-200 bg-surface-0 space-y-3">
    <div class="flex items-center justify-between">
      <div>
        <span class="text-[10px] font-mono uppercase tracking-wider text-accent font-semibold block">
          Current Layout
        </span>
        <h3 id="current-template-name" class="text-sm font-bold text-ink-950">
          Retro Synth
        </h3>
      </div>
      <span id="current-template-niche" class="text-[10px] font-mono uppercase px-2 py-0.5 rounded-sm bg-surface-100 text-ink-600 border border-line-200">
        Gaming
      </span>
    </div>

    <button
      type="button"
      id="change-template-btn"
      class="w-full min-h-[44px] px-4 py-2.5 rounded-md border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-950 text-xs font-semibold inline-flex items-center justify-center gap-2 cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent transition-colors"
    >
      <span>Browse Templates</span>
    </button>
  </div>

  <!-- Text Layers Control Panel (REQ-018: Up to 3 editable text layers; protected elements absent) -->
  <section id="panel-text" class="p-4 rounded-lg border border-line-200 bg-surface-0 space-y-4">
    <div class="border-b border-line-100 pb-2.5">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">
        Typography & Branding
      </h3>
      <p class="text-[11px] text-ink-500">
        Customise channel name and tagline. Drag directly on canvas to reposition inside the safe area.
      </p>
    </div>

    <!-- Container where editable layers are rendered (Protected layers are strictly ABSENT) -->
    <div id="text-layers-container" class="space-y-4">
      <!-- Title Layer (Default SSR) -->
      <div class="layer-control-card space-y-2.5 p-3 rounded-lg bg-surface-50 border border-line-200" data-layer-id="title">
        <div class="flex items-center justify-between text-xs font-medium text-ink-950">
          <span>Channel Title</span>
          <span class="text-[10px] font-mono text-ink-500">Safe-Area Bound</span>
        </div>

        <div>
          <label for="layer-text-title" class="sr-only">Channel Title Text</label>
          <input
            type="text"
            id="layer-text-title"
            class="layer-text-input w-full min-h-[44px] px-3 py-2 text-xs rounded-md border border-line-200 bg-surface-0 text-ink-950 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-accent"
            value="RETRO WAVE"
            data-layer-id="title"
            placeholder="Your Channel Name"
          />
        </div>

        <div class="grid grid-cols-2 gap-2 pt-1">
          <div>
            <label for="layer-color-title" class="block text-[11px] text-ink-600 mb-1">Color</label>
            <div class="flex items-center gap-2">
              <input
                type="color"
                id="layer-color-title"
                class="layer-color-input w-9 h-9 min-h-[44px] min-w-[44px] rounded border border-line-200 cursor-pointer p-0.5 bg-surface-0"
                value="#FFFFFF"
                data-layer-id="title"
                aria-label="Title text color"
              />
              <span class="layer-color-hex text-[11px] font-mono text-ink-600">#FFFFFF</span>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between text-[11px] text-ink-600 mb-1">
              <label for="layer-size-title">Size</label>
              <span class="layer-size-val font-mono text-[10px] text-ink-500">54px</span>
            </div>
            <input
              type="range"
              id="layer-size-title"
              min="16"
              max="96"
              value="54"
              class="layer-size-slider w-full h-3 bg-surface-200 rounded-lg appearance-none cursor-pointer accent-ink-950"
              data-layer-id="title"
              aria-label="Title font size"
            />
          </div>
        </div>

        <div class="pt-1 flex items-center justify-between">
          <span class="text-[11px] text-ink-600">Alignment</span>
          <div class="flex items-center gap-1">
            <button
              type="button"
              class="layer-align-btn min-h-[44px] min-w-[44px] p-2 rounded border border-line-200 bg-surface-0 hover:bg-surface-100 text-ink-800 text-xs flex items-center justify-center cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
              data-layer-id="title"
              data-align="left"
              aria-label="Align left"
              title="Align left"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h10.5m-10.5 5.25h16.5" />
              </svg>
            </button>
            <button
              type="button"
              class="layer-align-btn min-h-[44px] min-w-[44px] p-2 rounded border border-line-200 bg-ink-950 text-surface-0 text-xs flex items-center justify-center cursor-pointer focus-visible:ring-2 focus-visible:ring-accent active-align"
              data-layer-id="title"
              data-align="center"
              aria-label="Align center"
              title="Align center"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M6.75 12h10.5m-13.5 5.25h16.5" />
              </svg>
            </button>
            <button
              type="button"
              class="layer-align-btn min-h-[44px] min-w-[44px] p-2 rounded border border-line-200 bg-surface-0 hover:bg-surface-100 text-ink-800 text-xs flex items-center justify-center cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
              data-layer-id="title"
              data-align="right"
              aria-label="Align right"
              title="Align right"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M9.75 12h10.5m-16.5 5.25h16.5" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Tagline Layer (Default SSR) -->
      <div class="layer-control-card space-y-2.5 p-3 rounded-lg bg-surface-50 border border-line-200" data-layer-id="tagline">
        <div class="flex items-center justify-between text-xs font-medium text-ink-950">
          <span>Tagline / Subtitle</span>
          <span class="text-[10px] font-mono text-ink-500">Safe-Area Bound</span>
        </div>

        <div>
          <label for="layer-text-tagline" class="sr-only">Tagline Text</label>
          <input
            type="text"
            id="layer-text-tagline"
            class="layer-text-input w-full min-h-[44px] px-3 py-2 text-xs rounded-md border border-line-200 bg-surface-0 text-ink-950 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-accent"
            value="Synthwave & Gaming Live Streams"
            data-layer-id="tagline"
            placeholder="Your Tagline or Upload Schedule"
          />
        </div>

        <div class="grid grid-cols-2 gap-2 pt-1">
          <div>
            <label for="layer-color-tagline" class="block text-[11px] text-ink-600 mb-1">Color</label>
            <div class="flex items-center gap-2">
              <input
                type="color"
                id="layer-color-tagline"
                class="layer-color-input w-9 h-9 min-h-[44px] min-w-[44px] rounded border border-line-200 cursor-pointer p-0.5 bg-surface-0"
                value="#FF88DC"
                data-layer-id="tagline"
                aria-label="Tagline text color"
              />
              <span class="layer-color-hex text-[11px] font-mono text-ink-600">#FF88DC</span>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between text-[11px] text-ink-600 mb-1">
              <label for="layer-size-tagline">Size</label>
              <span class="layer-size-val font-mono text-[10px] text-ink-500">22px</span>
            </div>
            <input
              type="range"
              id="layer-size-tagline"
              min="16"
              max="96"
              value="22"
              class="layer-size-slider w-full h-3 bg-surface-200 rounded-lg appearance-none cursor-pointer accent-ink-950"
              data-layer-id="tagline"
              aria-label="Tagline font size"
            />
          </div>
        </div>

        <div class="pt-1 flex items-center justify-between">
          <span class="text-[11px] text-ink-600">Alignment</span>
          <div class="flex items-center gap-1">
            <button
              type="button"
              class="layer-align-btn min-h-[44px] min-w-[44px] p-2 rounded border border-line-200 bg-surface-0 hover:bg-surface-100 text-ink-800 text-xs flex items-center justify-center cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
              data-layer-id="tagline"
              data-align="left"
              aria-label="Align left"
              title="Align left"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h10.5m-10.5 5.25h16.5" />
              </svg>
            </button>
            <button
              type="button"
              class="layer-align-btn min-h-[44px] min-w-[44px] p-2 rounded border border-line-200 bg-ink-950 text-surface-0 text-xs flex items-center justify-center cursor-pointer focus-visible:ring-2 focus-visible:ring-accent active-align"
              data-layer-id="tagline"
              data-align="center"
              aria-label="Align center"
              title="Align center"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M6.75 12h10.5m-13.5 5.25h16.5" />
              </svg>
            </button>
            <button
              type="button"
              class="layer-align-btn min-h-[44px] min-w-[44px] p-2 rounded border border-line-200 bg-surface-0 hover:bg-surface-100 text-ink-800 text-xs flex items-center justify-center cursor-pointer focus-visible:ring-2 focus-visible:ring-accent"
              data-layer-id="tagline"
              data-align="right"
              aria-label="Align right"
              title="Align right"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M9.75 12h10.5m-16.5 5.25h16.5" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Background Swap Panel (REQ-020) -->
  <section id="panel-background" class="p-4 rounded-lg border border-line-200 bg-surface-0 space-y-4">
    <div class="border-b border-line-100 pb-2.5">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">
        Canvas Background
      </h3>
      <p class="text-[11px] text-ink-500">
        Switch between gradients, solid colors, or upload your own photo.
      </p>
    </div>

    <!-- Type Switcher -->
    <div class="grid grid-cols-3 gap-1 p-1 bg-surface-50 rounded-lg border border-line-200">
      <button
        type="button"
        id="bg-type-gradient"
        class="min-h-[44px] px-3 py-2 rounded-md text-xs font-medium cursor-pointer transition-all bg-ink-950 text-surface-0 focus-visible:ring-2 focus-visible:ring-accent"
        data-bg-type="gradient"
      >
        Gradient
      </button>
      <button
        type="button"
        id="bg-type-solid"
        class="min-h-[44px] px-3 py-2 rounded-md text-xs font-medium cursor-pointer transition-all bg-transparent text-ink-600 hover:text-ink-950 focus-visible:ring-2 focus-visible:ring-accent"
        data-bg-type="solid"
      >
        Solid
      </button>
      <button
        type="button"
        id="bg-type-photo"
        class="min-h-[44px] px-3 py-2 rounded-md text-xs font-medium cursor-pointer transition-all bg-transparent text-ink-600 hover:text-ink-950 focus-visible:ring-2 focus-visible:ring-accent"
        data-bg-type="photo"
      >
        Photo
      </button>
    </div>

    <!-- Gradient Options -->
    <div id="bg-gradient-controls" class="space-y-3">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="bg-gradient-from" class="block text-[11px] text-ink-600 mb-1">Color From</label>
          <div class="flex items-center gap-2">
            <input
              type="color"
              id="bg-gradient-from"
              class="w-9 h-9 min-h-[44px] min-w-[44px] rounded border border-line-200 cursor-pointer p-0.5 bg-surface-0"
              value="#1a0033"
              aria-label="Gradient start color"
            />
            <span id="bg-gradient-from-hex" class="text-[11px] font-mono text-ink-600">#1a0033</span>
          </div>
        </div>

        <div>
          <label for="bg-gradient-to" class="block text-[11px] text-ink-600 mb-1">Color To</label>
          <div class="flex items-center gap-2">
            <input
              type="color"
              id="bg-gradient-to"
              class="w-9 h-9 min-h-[44px] min-w-[44px] rounded border border-line-200 cursor-pointer p-0.5 bg-surface-0"
              value="#330066"
              aria-label="Gradient end color"
            />
            <span id="bg-gradient-to-hex" class="text-[11px] font-mono text-ink-600">#330066</span>
          </div>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between text-[11px] text-ink-600 mb-1">
          <label for="bg-gradient-angle">Angle</label>
          <span id="bg-gradient-angle-val" class="font-mono text-[10px] text-ink-500">135°</span>
        </div>
        <input
          type="range"
          id="bg-gradient-angle"
          min="0"
          max="360"
          value="135"
          class="w-full h-3 bg-surface-200 rounded-lg appearance-none cursor-pointer accent-ink-950"
          aria-label="Gradient angle"
        />
      </div>
    </div>

    <!-- Solid Color Options (Hidden initially) -->
    <div id="bg-solid-controls" class="hidden space-y-2">
      <label for="bg-solid-color" class="block text-[11px] text-ink-600">Background Color</label>
      <div class="flex items-center gap-2.5">
        <input
          type="color"
          id="bg-solid-color"
          class="w-9 h-9 min-h-[44px] min-w-[44px] rounded border border-line-200 cursor-pointer p-0.5 bg-surface-0"
          value="#111215"
          aria-label="Solid background color"
        />
        <span id="bg-solid-color-hex" class="text-xs font-mono text-ink-800">#111215</span>
      </div>
    </div>

    <!-- Custom Photo Upload (Hidden initially) -->
    <div id="bg-photo-controls" class="hidden space-y-3">
      <input
        type="file"
        id="bg-photo-file-input"
        accept="image/png, image/jpeg, image/webp, image/*"
        class="sr-only"
        aria-label="Upload custom background image"
      />
      <button
        type="button"
        id="bg-photo-upload"
        class="w-full min-h-[44px] px-4 py-3 rounded-lg border-2 border-dashed border-line-200 hover:border-accent/60 bg-surface-50 hover:bg-surface-100 text-ink-950 text-xs font-medium flex items-center justify-center gap-2 cursor-pointer transition-colors focus-visible:ring-2 focus-visible:ring-accent"
      >
        <svg class="w-4 h-4 text-ink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Upload Background Image</span>
      </button>
      <p class="text-[10px] text-ink-500 leading-relaxed">
        Loads your photo into the background slot with aspect-preserving cover fit.
      </p>
    </div>
  </section>

  <!-- RepositionControls (Zoom & Pan; visible when custom photo is active) -->
  <div id="make-photo-reposition-wrap" class="hidden">
    <RepositionControls />
  </div>

  <!-- Cross-Door Handoff Action (REQ-022, Gate 6) -->
  <div class="p-4 rounded-lg border border-line-200 bg-surface-0 space-y-3">
    <div class="space-y-1">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-950">
        Safe Area Diagnostic Verification
      </h3>
      <p class="text-xs text-ink-600 leading-relaxed">
        Verify your banner design against YouTube Studio's exact cropping parameters before exporting.
      </p>
    </div>
    <button
      type="button"
      id="handoff-check-btn"
      class="w-full min-h-[44px] px-4 py-2.5 rounded-md bg-surface-50 border border-line-200 text-ink-950 text-xs font-semibold hover:bg-surface-100 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent cursor-pointer transition-colors inline-flex items-center justify-center gap-1.5"
    >
      <span>Verify in Safe Area Checker →</span>
    </button>
  </div>

  <!-- Simulation & Export -->
  <ReencodeSimulation />
  <ExportButton />
</div>
