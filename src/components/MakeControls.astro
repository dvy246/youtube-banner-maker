        </div>
        <p class="text-[11px] text-ink-500 mt-0.5">
          {t.motion.desc}
        </p>
      </div>
      <label class="relative inline-flex items-center cursor-pointer" title="Toggle Live 60 FPS Motion">
        <input type="checkbox" id="motion-toggle" class="sr-only peer" />
