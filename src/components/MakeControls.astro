          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-ink-950">{t.motion.presetNeon}</span>
            <span class="text-[9px] font-mono text-accent">60 FPS</span>
          </div>
          <p class="text-[10px] text-ink-500 leading-tight">{t.motion.presetNeonDesc}</p>
        </button>

        <button
          type="button"
          class="motion-preset-btn p-2.5 rounded-xl border border-line-200 bg-surface-50 hover:bg-surface-100 text-left transition-all cursor-pointer flex flex-col gap-1 active:scale-[0.98]"
