          <span class="relative z-10 text-[9px] text-pink-200 font-mono leading-tight">Neon Street</span>
        </button>

        <button
          type="button"
          class="bg-plate-btn relative h-16 rounded-xl border border-line-200 overflow-hidden text-left p-2 flex flex-col justify-end group cursor-pointer hover:border-accent focus-visible:ring-2 focus-visible:ring-accent transition-all active:scale-[0.98]"
          data-bg-src="/backgrounds/life-minimalist.jpg"
          data-title-color="#18181B"
          data-tagline-color="#52525B"
          data-border-color="#71717A"
