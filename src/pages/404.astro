---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { STATIC_PAGES_SEO } from '../lib/seo';

const path = '/404';
const seo = STATIC_PAGES_SEO[path];
---

<BaseLayout
  title={seo.title}
  description={seo.desc}
  path={path}
  robots="noindex, follow"
>
  <Header currentPath={path} />

  <main id="main-content" class="flex-1 flex items-center justify-center py-16 sm:py-24">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
      <div class="space-y-3">
        <span class="inline-block text-xs font-mono font-semibold uppercase tracking-wider text-accent bg-surface-50 border border-line-200 px-3 py-1 rounded-full">
          Error 404
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink-950">
          404: Page Not Found
        </h1>
        <p class="text-base text-ink-600 max-w-md mx-auto leading-relaxed">
          The page you requested does not exist or has been moved.
        </p>
      </div>

      <div class="p-6 rounded-xl border border-line-200 bg-surface-50 text-left space-y-4">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-ink-950">
          Available Tools & Resources
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a
            href="/tools/youtube-banner-resizer"
            class="p-3.5 rounded-lg border border-line-200 bg-surface-0 hover:border-line-200/80 hover:bg-surface-50 transition-colors flex flex-col justify-center min-h-[44px]"
          >
            <span class="text-xs font-semibold text-ink-950">Banner Resizer</span>
            <span class="text-[11px] text-ink-500 mt-0.5">Fit and reposition existing artwork</span>
          </a>
          <a
            href="/tools/youtube-banner-checker"
            class="p-3.5 rounded-lg border border-line-200 bg-surface-0 hover:border-line-200/80 hover:bg-surface-50 transition-colors flex flex-col justify-center min-h-[44px]"
          >
            <span class="text-xs font-semibold text-ink-950">Safe Area Checker</span>
            <span class="text-[11px] text-ink-500 mt-0.5">Diagnose crop cutoff issues</span>
          </a>
          <a
            href="/tools/youtube-banner-maker"
            class="p-3.5 rounded-lg border border-line-200 bg-surface-0 hover:border-line-200/80 hover:bg-surface-50 transition-colors flex flex-col justify-center min-h-[44px]"
          >
            <span class="text-xs font-semibold text-ink-950">Banner Generator</span>
            <span class="text-[11px] text-ink-500 mt-0.5">Design from mobile-safe templates</span>
          </a>
          <a
            href="/guides/youtube-banner-size"
            class="p-3.5 rounded-lg border border-line-200 bg-surface-0 hover:border-line-200/80 hover:bg-surface-50 transition-colors flex flex-col justify-center min-h-[44px]"
          >
            <span class="text-xs font-semibold text-ink-950">Banner Size Guide</span>
            <span class="text-[11px] text-ink-500 mt-0.5">Complete dimensions & specs</span>
          </a>
          <a
            href="/guides/youtube-banner-safe-area"
            class="p-3.5 rounded-lg border border-line-200 bg-surface-0 hover:border-line-200/80 hover:bg-surface-50 transition-colors flex flex-col justify-center min-h-[44px]"
          >
            <span class="text-xs font-semibold text-ink-950">Safe Area Math Guide</span>
            <span class="text-[11px] text-ink-500 mt-0.5">Reconcile official dimensions</span>
          </a>
          <a
            href="/"
            class="p-3.5 rounded-lg border border-line-200 bg-surface-0 hover:border-line-200/80 hover:bg-surface-50 transition-colors flex flex-col justify-center min-h-[44px]"
          >
            <span class="text-xs font-semibold text-ink-950">Home Page</span>
            <span class="text-[11px] text-ink-500 mt-0.5">Return to tools overview</span>
          </a>
        </div>
      </div>

      <div class="pt-2">
        <a
          href="/"
          class="h-10 px-6 rounded-full bg-ink-950 text-surface-0 font-medium text-xs hover:bg-ink-800 transition-all active:scale-[0.98] inline-flex items-center justify-center min-h-[44px] shadow-xs"
        >
          ← Return to Home
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
