                  <tr>
                    <td class="py-2.5 px-4 font-medium text-ink-950 font-sans">Ultra HD 4K Wallpaper</td>
                    <td class="py-2.5 px-4 tabular-nums">3840 × 2160 px</td>
                    <td class="py-2.5 px-4">16:9</td>
                    <td class="py-2.5 px-4 text-ink-600 font-sans">High-Res Desktop Download</td>
