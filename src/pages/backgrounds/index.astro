<script>
  // Client-Side Search, Category Filtering, Safe Area Overlay, & Multi-Size Downloader
  function initBackgroundsHub() {
    const searchInput = document.getElementById('bg-search-input') as HTMLInputElement | null;
    const categoryChips = document.querySelectorAll<HTMLButtonElement>('.category-chip');
    const cards = document.querySelectorAll<HTMLElement>('.bg-card');
    const countLabel = document.getElementById('bg-count-label');
    const safeToggleBtn = document.getElementById('global-safe-toggle-btn');
    const safeOverlays = document.querySelectorAll<HTMLElement>('.safe-overlay');

    let activeCategory = 'all';
    let searchQuery = '';
    let isSafeActive = false;

    // Filter execution
    function updateGallery() {
      let visibleCount = 0;
      cards.forEach((card) => {
        const cat = card.getAttribute('data-category') || '';
        const tags = card.getAttribute('data-tags') || '';
        const name = card.getAttribute('data-name') || '';

        const matchesCat = activeCategory === 'all' || cat === activeCategory;
        const matchesSearch = !searchQuery || name.includes(searchQuery) || tags.includes(searchQuery);

        if (matchesCat && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countLabel) {
        countLabel.textContent = `Showing ${visibleCount} aesthetic background${visibleCount === 1 ? '' : 's'}`;
      }
    }

    // Search event
    searchInput?.addEventListener('input', () => {
      searchQuery = (searchInput.value || '').trim().toLowerCase();
      updateGallery();
    });

    // Category click events
    categoryChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        categoryChips.forEach((c) => {
          c.classList.remove('bg-ink-950', 'text-surface-0', 'shadow-xs');
          c.classList.add('bg-surface-50', 'text-ink-600', 'border', 'border-line-200');
          c.setAttribute('aria-selected', 'false');
        });
        chip.classList.remove('bg-surface-50', 'text-ink-600', 'border', 'border-line-200');
        chip.classList.add('bg-ink-950', 'text-surface-0', 'shadow-xs');
        chip.setAttribute('aria-selected', 'true');

        activeCategory = chip.getAttribute('data-category') || 'all';
        updateGallery();
      });
    });

    // Global Safe Area Overlay Toggle
    safeToggleBtn?.addEventListener('click', () => {
      isSafeActive = !isSafeActive;
      safeToggleBtn.setAttribute('aria-pressed', isSafeActive ? 'true' : 'false');
      if (isSafeActive) {
        safeToggleBtn.classList.add('bg-accent/10', 'border-accent', 'text-accent');
      } else {
        safeToggleBtn.classList.remove('bg-accent/10', 'border-accent', 'text-accent');
      }

      safeOverlays.forEach((overlay) => {
        if (isSafeActive) {
          overlay.classList.remove('opacity-0');
          overlay.classList.add('opacity-100');
        } else {
          overlay.classList.remove('opacity-100');
          overlay.classList.add('opacity-0');
        }
      });
    });

    // Multi-Size Download Engine & Dropdown Controller
    const downloadGroups = document.querySelectorAll<HTMLElement>('.download-group');

    function closeAllDropdowns() {
      document.querySelectorAll<HTMLElement>('.download-dropdown-menu').forEach((m) => {
        m.classList.add('hidden');
      });
      document.querySelectorAll<HTMLButtonElement>('.btn-toggle-sizes').forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
      });
    }

    downloadGroups.forEach((group) => {
      const toggleBtn = group.querySelector<HTMLButtonElement>('.btn-toggle-sizes');
      const menu = group.querySelector<HTMLElement>('.download-dropdown-menu');
      const quickBtn = group.querySelector<HTMLButtonElement>('.btn-quick-download');
      const sizeBtns = group.querySelectorAll<HTMLButtonElement>('.btn-download-size');

      toggleBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = menu?.classList.contains('hidden');
        closeAllDropdowns();
        if (isHidden) {
          menu?.classList.remove('hidden');
          toggleBtn.setAttribute('aria-expanded', 'true');
        }
      });

      quickBtn?.addEventListener('click', () => {
        const src = quickBtn.getAttribute('data-src') || '';
        const id = quickBtn.getAttribute('data-id') || 'background';
        const w = parseInt(quickBtn.getAttribute('data-w') || '2560', 10);
        const h = parseInt(quickBtn.getAttribute('data-h') || '1440', 10);
        const crop = quickBtn.getAttribute('data-crop') || 'false';
        downloadBackground(src, id, w, h, crop, quickBtn);
      });

      sizeBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          closeAllDropdowns();
          const src = btn.getAttribute('data-src') || '';
          const id = btn.getAttribute('data-id') || 'background';
          const w = parseInt(btn.getAttribute('data-w') || '2560', 10);
          const h = parseInt(btn.getAttribute('data-h') || '1440', 10);
          const crop = btn.getAttribute('data-crop') || 'false';
          downloadBackground(src, id, w, h, crop, btn);
        });
      });
    });

    document.addEventListener('click', () => {
      closeAllDropdowns();
    });

    async function downloadBackground(
      src: string,
      filenameBase: string,
      targetW: number,
      targetH: number,
      cropType: string,
      triggerElement?: HTMLElement
    ) {
      if (triggerElement) {
        triggerElement.style.opacity = '0.6';
      }

      try {
        const img = new Image();
        img.crossOrigin = 'anonymous';

        await new Promise<void>((resolve, reject) => {
          img.onload = () => resolve();
          img.onerror = () => reject(new Error('Image failed to load'));
          img.src = src;
        });

        const canvas = document.createElement('canvas');
        canvas.width = targetW;
        canvas.height = targetH;
        const ctx = canvas.getContext('2d');
        if (!ctx) throw new Error('Canvas 2D unsupported');

        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = 'high';

        const natW = img.naturalWidth || 2560;
        const natH = img.naturalHeight || 1440;

        if (cropType === 'desktop') {
          const srcH = (targetH / 1440) * natH;
          const srcY = (natH - srcH) / 2;
          ctx.drawImage(img, 0, srcY, natW, srcH, 0, 0, targetW, targetH);
        } else if (cropType === 'mobile') {
          const srcW = (targetW / 2560) * natW;
          const srcH = (targetH / 1440) * natH;
          const srcX = (natW - srcW) / 2;
          const srcY = (natH - srcH) / 2;
          ctx.drawImage(img, srcX, srcY, srcW, srcH, 0, 0, targetW, targetH);
        } else {
          ctx.drawImage(img, 0, 0, natW, natH, 0, 0, targetW, targetH);
        }

        const isJpeg = src.endsWith('.jpg') || src.endsWith('.jpeg');
        const mime = isJpeg ? 'image/jpeg' : 'image/png';
        const ext = isJpeg ? 'jpg' : 'png';
        const dataUrl = canvas.toDataURL(mime, 0.95);

        const a = document.createElement('a');
        a.href = dataUrl;
        a.download = `${filenameBase}-${targetW}x${targetH}.${ext}`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      } catch (err) {
        const a = document.createElement('a');
        a.href = src;
        a.download = `${filenameBase}.jpg`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      } finally {
        if (triggerElement) {
          triggerElement.style.opacity = '1';
        }
      }
    }
  }

  // Initialize on load & Astro page swap
  initBackgroundsHub();
  document.addEventListener('astro:after-swap', initBackgroundsHub);
</script>
