---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { STATIC_PAGES_SEO, getBreadcrumbSchema, getCollectionPageSchema } from '../../lib/seo';
import { AESTHETIC_BACKGROUNDS, AESTHETIC_CATEGORIES } from '../../data/backgrounds';
import { CANVAS, SAFE, SAFE_PX } from '../../lib/spec';

const mobileCropWidth = SAFE_PX.full.width;
const mobileCropHeight = SAFE_PX.full.height;
const desktopCropHeight = SAFE_PX.full.height;

const seo = STATIC_PAGES_SEO['/backgrounds'];

const breadcrumbs = getBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Backgrounds', url: '/backgrounds' },
]);

const collectionSchema = getCollectionPageSchema({
  name: seo.title,
  description: seo.desc,
  path: '/backgrounds',
  items: AESTHETIC_BACKGROUNDS.map((b) => ({
    name: b.name,
    url: `/tools/youtube-banner-maker?bgId=${b.id}`,
    image: b.src,
  })),
});

const gallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  '@id': 'https://ytbannerstudio.com/backgrounds#gallery',
  name: 'Aesthetic YouTube Banner Backgrounds Gallery',
  description: seo.desc,
  url: 'https://ytbannerstudio.com/backgrounds',
};

const faqs = [
  {
    question: 'What is the correct YouTube banner background size?',
    answer: `The official YouTube banner background size is 2560 × 1440 pixels with a 16:9 aspect ratio and maximum file size of 6 MB. The absolute minimum upload resolution accepted by YouTube Studio is 2048 × 1152 pixels. Keep critical artwork and titles within the centered mobile safe zone (${mobileCropWidth} × ${mobileCropHeight} px) to prevent cropping on smartphones.`,
  },
  {
    question: 'Can I use a 1024 x 576 pixel background for my YouTube banner?',
    answer: 'No. YouTube Studio automatically rejects 1024 × 576 pixel images because they fall below the required 2048 × 1152 minimum dimension. Although 1024 × 576 has the exact same 16:9 ratio, you must upscale or place your artwork onto a 2560 × 1440 canvas to upload successfully.',
  },
  {
    question: 'What is the difference between 2560x1440, 2048x1152, and 1024x576 banner backgrounds?',
    answer: '2560 × 1440 px is YouTube’s recommended resolution that spans Smart TVs and widescreen monitors. 2048 × 1152 px is the minimum allowable upload size. 1024 × 576 px is a sub-resolution 16:9 format rejected by YouTube Studio. All three share a 16:9 ratio, but only 2048 × 1152 and 2560 × 1440 can be uploaded.',
  },
  {
    question: 'How do I stop my aesthetic YouTube banner background from cutting off on mobile?',
    answer: `YouTube centers your 2560 × 1440 background and crops it dynamically. On mobile devices, only the centered ${mobileCropWidth} × ${mobileCropHeight} pixel safe zone remains visible. All backgrounds in our gallery are calibrated so main characters and focal points remain centered and visible across all screens.`,
  },
  {
    question: 'Are these aesthetic YouTube banner backgrounds free to download and use commercially?',
    answer: 'Yes! Every background in this gallery is 100% free for both personal and commercial YouTube channel art, thumbnail backgrounds, and 4K wallpapers with zero watermarks and zero attribution required.',
  },
  {
    question: 'Can I add my channel name, logo, and social handles to these backgrounds?',
    answer: 'Yes! Click "Customize" on any background to open it directly in our free in-browser YouTube Banner Maker. You can add your channel title, subtitle, social badges, and profile avatar frame with automatic safe-area alignment.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};

const safeLeftPct = (SAFE.x * 100).toFixed(2);
const safeTopPct = (SAFE.y * 100).toFixed(2);
const safeWidthPct = (SAFE.w * 100).toFixed(2);
const safeHeightPct = (SAFE.h * 100).toFixed(2);
---

<BaseLayout
  title={seo.title}
  description={seo.desc}
  path="/backgrounds"
  ogType="website"
  ogImageAlt="Curated aesthetic YouTube banner backgrounds in 2560x1440 with safe area overlays"
  jsonLd={[breadcrumbs, collectionSchema, gallerySchema, faqSchema]}
>
  <Header currentPath="/backgrounds" />

  <main id="main-content" class="flex-1">
    <!-- Hero Section -->
    <section class="border-b border-line-200 bg-surface-0 py-12 sm:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-50 border border-line-200 text-xs font-medium text-ink-600 mb-4">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            60+ Curated Aesthetic Banner Backgrounds
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-ink-950 tracking-tight leading-[1.12]">
            Free Aesthetic YouTube Banner Backgrounds (2560×1440)
          </h1>
          <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed">
            Browse curated aesthetic YouTube banner backgrounds calibrated to the official 2560×1440 canvas. Download cool anime, gaming, pink, and cute channel backgrounds fitted for the centered mobile safe area, or customize any background directly in our free browser editor with zero watermarks.
          </p>
        </div>

        <!-- Controls Toolbar: Search & Global Safe Area Overlay Toggle -->
        <div class="mt-8 pt-6 border-t border-line-100 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
          <!-- Search input -->
          <div class="relative flex-1 max-w-md">
            <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="bg-search-input"
              placeholder="Search backgrounds (e.g., sakura, clouds, marble, grunge)..."
              class="w-full h-11 pl-10 pr-4 rounded-full bg-surface-50 border border-line-200 text-sm text-ink-950 placeholder-ink-400 focus:outline-hidden focus:ring-2 focus:ring-accent focus:border-accent transition-all"
            />
          </div>

          <!-- Safe Area Preview Toggle Button -->
          <button
            type="button"
            id="global-safe-toggle-btn"
            class="inline-flex items-center justify-center gap-2 h-11 px-5 rounded-full border border-line-200 bg-surface-50 hover:bg-surface-100 text-xs sm:text-sm font-medium text-ink-700 hover:text-ink-950 cursor-pointer transition-all active:scale-[0.98]"
            aria-pressed="false"
          >
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="3" y="3" width="18" height="18" rx="2" stroke-width="2" />
              <rect x="6" y="8" width="12" height="8" rx="1" stroke-width="2" stroke-dasharray="2 2" />
            </svg>
            <span>Show Safe Area Overlay</span>
          </button>
        </div>

        <!-- Category Filter Chips -->
        <div class="mt-4 flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" id="bg-category-filters" role="tablist">
          {
            AESTHETIC_CATEGORIES.map((cat, idx) => (
              <button
                type="button"
                role="tab"
                data-category={cat.id}
                aria-selected={idx === 0 ? 'true' : 'false'}
                class:list={[
                  'category-chip whitespace-nowrap px-4 py-2 rounded-full text-xs font-medium cursor-pointer transition-all active:scale-[0.98]',
                  idx === 0
                    ? 'bg-ink-950 text-surface-0 shadow-xs'
                    : 'bg-surface-50 hover:bg-surface-100 text-ink-600 border border-line-200',
                ]}
              >
                {cat.label}
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Backgrounds Gallery Grid -->
    <section class="py-12 sm:py-16 bg-surface-50 border-b border-line-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
          <div>
            <h2 class="text-xl sm:text-2xl font-semibold text-ink-950 tracking-tight">
              Aesthetic YouTube Banner Background Library
            </h2>
            <p class="mt-1 text-xs sm:text-sm font-medium text-ink-600" id="bg-count-label">
              Showing all {AESTHETIC_BACKGROUNDS.length} aesthetic banner backgrounds
            </p>
          </div>
          <div class="text-[11px] text-ink-400 font-mono">
            2560 × 1440 px • SVG Vector & Master Art
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="bg-grid">
          {
            AESTHETIC_BACKGROUNDS.map((bg, index) => (
              <article
                class="bg-card group rounded-2xl border border-line-200 bg-surface-0 overflow-hidden shadow-xs hover:shadow-md transition-all flex flex-col"
                data-category={bg.category}
                data-tags={bg.tags.join(' ')}
                data-name={bg.name.toLowerCase()}
              >
                <!-- 16:9 Banner Preview Container -->
                <div class="relative aspect-video w-full bg-ink-950 overflow-hidden border-b border-line-100">
                  <img
                    src={bg.src}
                    alt={`${bg.name} - Aesthetic YouTube banner background 2560x1440`}
                    width="640"
                    height="360"
                    decoding="async"
                    loading={index < 6 ? 'eager' : 'lazy'}
                    fetchpriority={index < 3 ? 'high' : undefined}
                    class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
                  />

                  <!-- Safe Area Overlay (Toggled via JS) -->
                  <div
                    class="safe-overlay absolute inset-0 pointer-events-none transition-opacity duration-200 opacity-0"
                    aria-hidden="true"
                  >
                    <div
                      class="absolute border-2 border-dashed border-accent bg-accent/10 rounded-xs flex items-start justify-end p-1"
                      style={`left: ${safeLeftPct}%; top: ${safeTopPct}%; width: ${safeWidthPct}%; height: ${safeHeightPct}%;`}
                    >
                      <span class="text-[9px] font-mono bg-accent text-white px-1.5 py-0.5 rounded-xs font-semibold">
                        Safe Area
                      </span>
                    </div>
                  </div>

                  <!-- Category Tag Badge -->
                  <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-black/70 backdrop-blur-xs text-[10px] font-medium text-white shadow-xs">
                    {bg.categoryLabel}
                  </span>

                  <!-- Resolution Badge -->
                  <span class="absolute top-3 right-3 px-2 py-0.5 rounded-md bg-black/70 backdrop-blur-xs text-[10px] font-mono text-zinc-300">
                    2560×1440
                  </span>
                </div>

                <!-- Card Body -->
                <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                  <div>
                    <h3 class="text-base font-semibold text-ink-950 tracking-tight group-hover:text-accent transition-colors">
                      {bg.name}
                    </h3>
                    <p class="mt-1 text-xs text-ink-600 line-clamp-2 leading-relaxed">
                      {bg.description}
                    </p>
                  </div>

                  <!-- Text Color Harmony Palette Indicator -->
                  <div class="flex items-center justify-between pt-2 border-t border-line-100 text-[11px] text-ink-500">
                    <span>Harmonized Palette:</span>
                    <div class="flex items-center gap-1.5" title="Recommended text & border contrast colors">
                      <span class="w-3.5 h-3.5 rounded-full border border-line-200" style={`background-color: ${bg.harmony.titleColor};`} />
                      <span class="w-3.5 h-3.5 rounded-full border border-line-200" style={`background-color: ${bg.harmony.taglineColor};`} />
                      <span class="w-3.5 h-3.5 rounded-full border border-line-200" style={`background-color: ${bg.harmony.frameBorderColor};`} />
                    </div>
                  </div>

                  <!-- Action Buttons -->
                  <div class="grid grid-cols-2 gap-2 pt-1">
                    <a
                      href={`/tools/youtube-banner-maker?bgId=${bg.id}`}
                      class="h-9 px-3 rounded-full bg-accent hover:bg-accent-600 text-white text-xs font-medium inline-flex items-center justify-center gap-1.5 transition-all shadow-xs active:scale-[0.98]"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                      </svg>
                      <span>Customize</span>
                    </a>

                    <!-- Split Multi-Size Download Pill -->
                    <div class="relative download-group inline-flex w-full">
                      <button
                        type="button"
                        class="btn-quick-download flex-1 h-9 pl-2.5 pr-1.5 rounded-l-full border border-r-0 border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-700 hover:text-ink-950 text-xs font-medium inline-flex items-center justify-center gap-1 transition-all active:scale-[0.98] cursor-pointer"
                        data-src={bg.src}
                        data-id={bg.id}
                        data-w={CANVAS.width}
                        data-h={CANVAS.height}
                        data-crop="false"
                        title="Download 2560 × 1440"
                      >
                        <svg class="w-3.5 h-3.5 text-ink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        <span>Download</span>
                      </button>
                      <button
                        type="button"
                        class="btn-toggle-sizes h-9 px-2 rounded-r-full border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-500 hover:text-ink-950 text-xs font-medium inline-flex items-center justify-center transition-all active:scale-[0.98] cursor-pointer"
                        aria-expanded="false"
                        aria-haspopup="true"
                        title="Choose custom download size (4K, 1080p, Safe Area Crops)"
                      >
                        <svg class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                      </button>

                      <!-- Floating Dropdown Menu -->
                      <div class="download-dropdown-menu hidden absolute right-0 bottom-full mb-2 w-72 sm:w-80 p-2 bg-surface-0/98 backdrop-blur-md rounded-2xl shadow-2xl border border-line-200 z-30 text-left">
                        <div class="px-2.5 py-1 text-[10px] font-mono font-bold uppercase tracking-wider text-ink-400 select-none">Standard Sizes</div>
                        <button
                          type="button"
                          class="btn-download-size w-full px-2.5 py-1.5 rounded-xl hover:bg-surface-100 flex items-center justify-between text-xs text-ink-900 transition-colors cursor-pointer group"
                          data-src={bg.src}
                          data-id={bg.id}
                          data-w={CANVAS.width}
                          data-h={CANVAS.height}
                          data-crop="false"
                        >
                          <span class="font-medium truncate">YouTube Banner (2K)</span>
                          <span class="text-[10px] font-mono tabular-nums text-ink-500 bg-surface-100/80 px-1.5 py-0.5 rounded border border-line-100 shrink-0 ml-2">{CANVAS.width} × {CANVAS.height}</span>
                        </button>
                        <button
                          type="button"
                          class="btn-download-size w-full px-2.5 py-1.5 rounded-xl hover:bg-surface-100 flex items-center justify-between text-xs text-ink-900 transition-colors cursor-pointer group"
                          data-src={bg.src}
                          data-id={bg.id}
                          data-w="3840"
                          data-h="2160"
                          data-crop="false"
                        >
                          <span class="font-medium truncate">Ultra HD 4K (Wallpaper)</span>
                          <span class="text-[10px] font-mono tabular-nums text-ink-500 bg-surface-100/80 px-1.5 py-0.5 rounded border border-line-100 shrink-0 ml-2">3840 × 2160</span>
                        </button>
                        <button
                          type="button"
                          class="btn-download-size w-full px-2.5 py-1.5 rounded-xl hover:bg-surface-100 flex items-center justify-between text-xs text-ink-900 transition-colors cursor-pointer group"
                          data-src={bg.src}
                          data-id={bg.id}
                          data-w="1920"
                          data-h="1080"
                          data-crop="false"
                        >
                          <span class="font-medium truncate">YouTube Thumbnail (1080p)</span>
                          <span class="text-[10px] font-mono tabular-nums text-ink-500 bg-surface-100/80 px-1.5 py-0.5 rounded border border-line-100 shrink-0 ml-2">1920 × 1080</span>
                        </button>

                        <div class="my-1.5 border-t border-line-100"></div>

                        <div class="px-2.5 py-1 text-[10px] font-mono font-bold uppercase tracking-wider text-ink-400 select-none">Safe Area Crops</div>
                        <button
                          type="button"
                          class="btn-download-size w-full px-2.5 py-1.5 rounded-xl hover:bg-surface-100 flex items-center justify-between text-xs text-ink-900 transition-colors cursor-pointer group"
                          data-src={bg.src}
                          data-id={bg.id}
                          data-w={CANVAS.width}
                          data-h={desktopCropHeight}
                          data-crop="desktop"
                        >
                          <span class="font-medium truncate">Desktop Viewport</span>
                          <span class="text-[10px] font-mono tabular-nums text-ink-500 bg-surface-100/80 px-1.5 py-0.5 rounded border border-line-100 shrink-0 ml-2">{CANVAS.width} × {desktopCropHeight}</span>
                        </button>
                        <button
                          type="button"
                          class="btn-download-size w-full px-2.5 py-1.5 rounded-xl hover:bg-surface-100 flex items-center justify-between text-xs text-ink-900 transition-colors cursor-pointer group"
                          data-src={bg.src}
                          data-id={bg.id}
                          data-w={mobileCropWidth}
                          data-h={mobileCropHeight}
                          data-crop="mobile"
                        >
                          <span class="font-medium truncate">Mobile Safe Zone</span>
                          <span class="text-[10px] font-mono tabular-nums text-ink-500 bg-surface-100/80 px-1.5 py-0.5 rounded border border-line-100 shrink-0 ml-2">{mobileCropWidth} × {mobileCropHeight}</span>
                        </button>

                        <div class="my-1.5 border-t border-line-100"></div>

                        <div class="px-2.5 py-1 text-[10px] font-mono font-bold uppercase tracking-wider text-ink-400 select-none">Customize in Studio</div>
                        <a
                          href={`/tools/youtube-banner-maker?bgId=${bg.id}&res=banner`}
                          class="w-full px-2.5 py-1.5 rounded-xl hover:bg-surface-100 flex items-center justify-between text-xs text-ink-900 hover:text-accent transition-colors group"
                        >
                          <span class="font-medium flex items-center gap-1.5 truncate">
                            <svg class="w-3 h-3 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                            <span>Open as Banner</span>
                          </span>
                          <span class="text-[10px] font-mono tabular-nums text-ink-500 group-hover:text-accent flex items-center gap-1 shrink-0 ml-2">
                            <span class="bg-surface-100/80 px-1.5 py-0.5 rounded border border-line-100">2560 × 1440</span>
                            <span aria-hidden="true">&rarr;</span>
                          </span>
                        </a>
                        <a
                          href={`/tools/youtube-banner-maker?bgId=${bg.id}&res=4k`}
                          class="w-full px-2.5 py-1.5 rounded-xl hover:bg-surface-100 flex items-center justify-between text-xs text-ink-900 hover:text-accent transition-colors group"
                        >
                          <span class="font-medium flex items-center gap-1.5 truncate">
                            <svg class="w-3 h-3 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                            <span>Open as 4K Wallpaper</span>
                          </span>
                          <span class="text-[10px] font-mono tabular-nums text-ink-500 group-hover:text-accent flex items-center gap-1 shrink-0 ml-2">
                            <span class="bg-surface-100/80 px-1.5 py-0.5 rounded border border-line-100">3840 × 2160</span>
                            <span aria-hidden="true">&rarr;</span>
                          </span>
                        </a>
                        <a
                          href={`/tools/youtube-banner-maker?bgId=${bg.id}&res=thumbnail`}
                          class="w-full px-2.5 py-1.5 rounded-xl hover:bg-surface-100 flex items-center justify-between text-xs text-ink-900 hover:text-accent transition-colors group"
                        >
                          <span class="font-medium flex items-center gap-1.5 truncate">
                            <svg class="w-3 h-3 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                            <span>Open as Thumbnail</span>
                          </span>
                          <span class="text-[10px] font-mono tabular-nums text-ink-500 group-hover:text-accent flex items-center gap-1 shrink-0 ml-2">
                            <span class="bg-surface-100/80 px-1.5 py-0.5 rounded border border-line-100">1920 × 1080</span>
                            <span aria-hidden="true">&rarr;</span>
                          </span>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Photo & Illustrated Anime Backgrounds (Community Picks) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-20">
      <div class="flex items-center gap-4 mb-8">
        <div class="flex-1 border-t border-line-200"></div>
        <div class="flex items-center gap-2 px-4 py-1.5 rounded-full bg-surface-50 border border-line-200 shrink-0">
          <h2 class="text-[10px] font-mono font-semibold uppercase tracking-wider text-ink-500">Cool Anime & Superhero YouTube Banners</h2>
        </div>
        <div class="flex-1 border-t border-line-200"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5" id="bg-photo-grid">
        {
          [
            { id: 'anime-samurai-crimson-dragon', src: '/backgrounds/anime-samurai-crimson-dragon.jpg', name: 'Samurai Crimson Dragon', mood: 'Anime Action', alt: 'Samurai Crimson Dragon - Cool gaming anime YouTube banner background' },
            { id: 'hero-thor-god-of-thunder', src: '/backgrounds/hero-thor-god-of-thunder.jpg', name: 'Thor — God of Thunder', mood: 'Superhero', alt: 'Thor God of Thunder - Cool superhero YouTube banner background' },
            { id: 'hero-logan-wolverine-claws', src: '/backgrounds/hero-logan-wolverine-claws.jpg', name: 'Logan — Wolverine', mood: 'Superhero', alt: 'Logan Wolverine - Cool comic YouTube banner background' },
            { id: 'anime-zenitsu-marigold-meadow', src: '/backgrounds/anime-zenitsu-marigold-meadow.jpg', name: 'Zenitsu Marigold Meadow', mood: 'Anime Calm', alt: 'Zenitsu Marigold Meadow - Aesthetic anime YouTube banner background' },
            { id: 'hero-spiderman-chill-headphones', src: '/backgrounds/hero-spiderman-chill-headphones.jpg', name: 'Spider-Man Chill', mood: 'Superhero Lofi', alt: 'Spider-Man Chill - Superhero lofi Spiderman YouTube banner' },
