---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  STATIC_PAGES_SEO,
  getBreadcrumbSchema,
  getFAQSchema,
  getOrganizationSchema,
} from '../lib/seo';
import { CANVAS } from '../lib/spec';

const path = '/contact';
const seo = STATIC_PAGES_SEO[path];

const faqs = [
  {
    question: 'Why is there no embedded contact form on this page?',
    answer:
      'Direct email communication protects your privacy by eliminating third-party form trackers, intrusive CAPTCHAs, and database intermediaries. It guarantees that your message reaches our core engineering team directly.',
  },
  {
    question: 'What should I check if my banner fails to upload to YouTube Studio?',
    answer: `Verify that your file is under YouTube's 6 MB upload limit and meets YouTube's minimum requirement of 2048 × 1152 px. Our tools export at YouTube's recommended ${CANVAS.width} × ${CANVAS.height} px standard with calibrated file budgets.`,
  },
  {
    question: 'Are banners created or resized here free for monetized YouTube channels?',
    answer:
      'Yes. All exports are 100% free for personal, educational, and commercial channels. Creators retain full copyright and ownership of their artwork with zero licensing fees or attribution required.',
  },
  {
    question: 'How quickly can I expect a reply to my support email?',
    answer:
      'Our team responds to all creator inquiries, bug reports, and technical questions within 24 hours, Monday through Friday.',
  },
];

const jsonLd = [
  getOrganizationSchema(),
  getBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Contact & Support', url: path },
  ]),
  getFAQSchema(faqs),
];
---

<BaseLayout
  title={seo.title}
  description={seo.desc}
  path={path}
  jsonLd={jsonLd}
>
  <Header currentPath={path} />

  <main id="main-content" class="flex-1">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
      
      <!-- Hero / Header -->
      <header class="space-y-4 border-b border-line-200 pb-10">
        <nav aria-label="Breadcrumb" class="text-xs font-mono text-ink-500 flex items-center gap-2">
          <a href="/" class="hover:text-ink-950 transition-colors">Home</a>
          <span class="text-line-200">/</span>
          <span class="text-ink-800 font-medium">Contact & Support</span>
        </nav>
        <span class="inline-block text-xs font-mono uppercase tracking-wider font-semibold text-accent">
          Creator Assistance & Inquiries
        </span>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink-950">
          Contact & Support
        </h1>
        <p class="text-base sm:text-lg text-ink-600 leading-relaxed measure-prose">
          Direct engineering support for YouTube creators. Have a question, bug report, or template suggestion? We typically respond in less than 24 hours.
        </p>
      </header>

      <!-- Primary Contact Channels Cards -->
      <section class="space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <!-- Support & General -->
          <div class="p-6 rounded-lg border border-line-200 bg-surface-50 space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent block">
                Technical Support
              </span>
              <h2 class="text-base font-bold text-ink-950">Bug Reports & Help</h2>
              <p class="text-xs text-ink-600 leading-relaxed">
                For questions regarding image resizing, safe-area alignment, or browser rendering issues.
              </p>
            </div>
            <div class="pt-4 border-t border-line-200">
              <a
                href="mailto:support@youtubebannermaker.com"
                class="text-xs font-mono font-semibold text-accent hover:underline block break-all"
              >
                support@youtubebannermaker.com
              </a>
              <span class="text-[11px] text-ink-500 block mt-1">SLA: Response &lt; 24 hours</span>
            </div>
          </div>

          <!-- Feature Requests -->
          <div class="p-6 rounded-lg border border-line-200 bg-surface-50 space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent block">
                Creator Ideas
              </span>
              <h2 class="text-base font-bold text-ink-950">Feature Suggestions</h2>
              <p class="text-xs text-ink-600 leading-relaxed">
                Suggest new template niches, font styles, crop diagnostics, or creator workflow improvements.
              </p>
            </div>
            <div class="pt-4 border-t border-line-200">
              <a
                href="mailto:support@youtubebannermaker.com?subject=Feature%20Request"
                class="text-xs font-mono font-semibold text-accent hover:underline block break-all"
              >
                support@youtubebannermaker.com
              </a>
              <span class="text-[11px] text-ink-500 block mt-1">Direct feedback review</span>
            </div>
          </div>

          <!-- Privacy & Legal -->
          <div class="p-6 rounded-lg border border-line-200 bg-surface-50 space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent block">
                Compliance & Trust
              </span>
              <h2 class="text-base font-bold text-ink-950">Privacy & Legal</h2>
              <p class="text-xs text-ink-600 leading-relaxed">
                For GDPR/CCPA inquiries, privacy questions, or trademark communications.
              </p>
            </div>
            <div class="pt-4 border-t border-line-200">
              <a
                href="mailto:privacy@youtubebannermaker.com"
                class="text-xs font-mono font-semibold text-accent hover:underline block break-all"
              >
                privacy@youtubebannermaker.com
              </a>
              <span class="text-[11px] text-ink-500 block mt-1">Data privacy officer</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Bug Report Format Guidelines -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            Troubleshooting Guidelines
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            How to File an Effective Bug Report
          </h2>
        </div>
        <p class="text-sm text-ink-600 leading-relaxed measure-prose">
          Because YouTubeBannerMaker operates 100% inside your browser, our servers receive zero copies of your image files or error traces. To help us diagnose and resolve any technical issue swiftly, please include:
        </p>
        <div class="p-5 rounded-lg border border-line-200 bg-surface-50">
          <ol class="space-y-3 text-xs text-ink-800 list-decimal pl-5">
            <li>
              <strong>Browser & Operating System:</strong> Your browser name and version (e.g. Chrome 124, Safari 17, Firefox 125) and operating system (e.g. macOS Sonoma, Windows 11, iOS 17, Android 14).
            </li>
            <li>
              <strong>Tool Mode & Action:</strong> Which tool door you were using (Banner Resizer, Safe Area Checker, or Banner Generator) and the step where the issue occurred.
            </li>
            <li>
              <strong>Image Attributes:</strong> The dimensions (width × height) and format (PNG, JPEG, WebP) of your source file.
            </li>
            <li>
              <strong>Observed vs Expected Result:</strong> A brief description of what happened versus what you expected to see.
            </li>
            <li>
              <strong>Console Errors (Optional):</strong> If comfortable opening Developer Tools (F12 or Cmd+Option+I), any red error messages displayed in the Console tab.
            </li>
          </ol>
        </div>
      </section>

      <!-- Support FAQ Section -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            Quick Answers
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            Frequently Asked Support Questions
          </h2>
        </div>
        <div class="space-y-4">
          {
            faqs.map((faq) => (
              <div class="p-5 rounded-lg border border-line-200 bg-surface-50 space-y-2">
                <h3 class="text-sm font-semibold text-ink-950">{faq.question}</h3>
                <p class="text-xs text-ink-600 leading-relaxed measure-prose">{faq.answer}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Trademark Disclaimer -->
      <section class="border-t border-line-200 pt-8 text-xs text-ink-500 measure-prose">
        <p>
          YouTube is a registered trademark of Google LLC. YouTubeBannerMaker is an independently developed utility and is not affiliated with, endorsed by, or sponsored by Google LLC or YouTube.
        </p>
      </section>

    </div>
  </main>

  <Footer />
</BaseLayout>
