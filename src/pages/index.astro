---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SpecTable from '../components/SpecTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import HeroCropSimulator from '../components/HeroCropSimulator.astro';
import ArchGallery from '../components/ArchGallery.astro';
import { STATIC_PAGES_SEO, getWebSiteSchema, getOrganizationSchema, getSoftwareAppSchema } from '../lib/seo';
import { CANVAS, SAFE, SAFE_PX, DEVICES, REENCODE_BUDGET_BYTES } from '../lib/spec';

const path = '/';
const seo = STATIC_PAGES_SEO[path];

const jsonLd = [
  getWebSiteSchema(),
  getOrganizationSchema(),
  getSoftwareAppSchema(
    'YouTube Banner Maker',
    'Free client-side YouTube banner maker, resizer, and safe area checker tool.',
    '/'
  ),
];

const desktopHeight = Math.round(DEVICES.desktop.h * CANVAS.height);
const desktopY = Math.round(DEVICES.desktop.y * CANVAS.height);
const tabletWidth = Math.round(DEVICES.tablet.w * CANVAS.width);
const tabletX = Math.round(DEVICES.tablet.x * CANVAS.width);
const mobileX = Math.round(SAFE.x * CANVAS.width);
const mobileY = Math.round(SAFE.y * CANVAS.height);
const desktopKb = Math.round(REENCODE_BUDGET_BYTES.desktop / 1000);
---

<BaseLayout
  title={seo.title}
  description={seo.desc}
  path={path}
  jsonLd={jsonLd}
>
  <Header currentPath={path} />

  <main id="main-content" class="flex-1">

    <!-- ═══════════════════════════════════════════════════════════
         Block 1: Asymmetric Split Hero
         Left: headline + CTAs + instrument readout
         Right: live crop simulator inside double-bezel enclosure
    ═══════════════════════════════════════════════════════════ -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-4 lg:pt-14">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] gap-8 lg:gap-12 items-center">

        <!-- Left rail -->
        <div class="space-y-6 lg:pr-2">
          <!-- Core Differentiators (Above Main Tagline & Subtitle) -->
          <div class="inline-flex flex-wrap items-center gap-1.5 sm:gap-2 px-3 py-1.5 rounded-full bg-surface-50 border border-line-200 shadow-2xs text-xs">
            <span class="inline-flex items-center gap-1.5 font-medium text-ink-900">
              <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
              100% Client-Side Privacy
            </span>
            <span class="text-ink-300 text-xs select-none" aria-hidden="true">·</span>
            <span class="inline-flex items-center gap-1 font-medium text-ink-700">
              <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
              No Sign-Up or Accounts
            </span>
            <span class="text-ink-300 text-xs select-none" aria-hidden="true">·</span>
            <span class="inline-flex items-center gap-1 font-medium text-ink-700">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
              No Watermark
            </span>
          </div>

          <div class="space-y-4">
            <h1 class="text-3xl sm:text-5xl lg:text-[3.5rem] font-extrabold tracking-[-0.035em] text-ink-950 leading-[1.04]">
              Free YouTube Banner Maker That Fits <span class="relative inline-block text-accent whitespace-nowrap">
                Every Screen
                <svg class="absolute -bottom-2 sm:-bottom-2.5 left-0 w-full h-3 sm:h-3.5 overflow-visible pointer-events-none" viewBox="0 0 260 18" fill="none" preserveAspectRatio="none" aria-hidden="true">
                  <!-- Primary artisanal expressive brush curve -->
                  <path
                    d="M3 12 C 45 4, 110 2, 252 8 C 220 12, 120 16, 22 15"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="sketch-stroke-primary opacity-90"
                  />
                  <!-- Secondary organic echo sketch stroke for authentic hand-drafted texture -->
                  <path
                    d="M12 14 C 70 8, 175 6, 256 12"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    class="sketch-stroke-secondary opacity-60"
                  />
                  <!-- Hand-drawn drafting spark / star mark at the terminus -->
                  <path
                    d="M250 3 L254 9 L260 10 L255 13 L257 18 L251 14 L246 17 L248 12 L243 9 L249 8 Z"
                    fill="currentColor"
                    class="sketch-star opacity-90"
                  />
                </svg>
              </span>
            </h1>
            <p class="text-base sm:text-lg text-ink-600 leading-relaxed max-w-[44ch] font-normal">
              Create or resize your banner and <span class="relative inline-block font-semibold text-ink-950">preview exactly<svg class="absolute -bottom-1 left-0 w-full h-2.5 overflow-visible pointer-events-none" viewBox="0 0 160 10" fill="none" preserveAspectRatio="none" aria-hidden="true"><path d="M2 6 C 40 2, 95 1, 156 5 C 130 8, 70 9, 14 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="sketch-tagline-stroke text-accent opacity-90"/></svg></span> how it will appear on mobile, desktop, tablet, and TV. Everything runs in your browser.
            </p>
          </div>

          <!-- Primary CTAs with button-in-button elevation -->
          <div class="flex flex-col sm:flex-row gap-3 pt-1">
            <a
              href="/tools/youtube-banner-resizer"
              class="group inline-flex items-center justify-center gap-3 h-12 px-6 rounded-xl bg-accent text-surface-0 font-semibold text-sm hover:bg-accent-hover active:scale-[0.98] transition-all focus-visible:outline-accent shadow-raised min-h-[44px]"
            >
              <span>Fix Existing Artwork</span>
              <span class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center group-hover:translate-x-0.5 transition-transform" aria-hidden="true">
                <svg class="w-3.5 h-3.5" viewBox="0 0 14 14" fill="none">
                  <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
            <a
              href="/tools/youtube-banner-checker"
              class="inline-flex items-center justify-center gap-2 h-12 px-6 rounded-xl bg-surface-0 text-ink-950 border border-line-200 font-semibold text-sm hover:bg-surface-50 active:scale-[0.98] transition-all focus-visible:outline-accent shadow-2xs min-h-[44px]"
            >
              <span>Check Safe Area</span>
            </a>
          </div>

          <!-- 4-cell instrument readout strip with double-bezel hardware styling -->
          <div class="p-1 rounded-xl bg-surface-100/80 border border-line-200 shadow-raised">
            <dl class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4 gap-1">
              <div class="bg-surface-0 rounded-lg px-3.5 py-2.5 space-y-0.5">
                <dt class="text-[10px] font-mono font-semibold uppercase tracking-wider text-ink-500">Canvas</dt>
                <dd class="text-sm font-mono font-bold text-ink-950 tabular-nums">{CANVAS.width} × {CANVAS.height}</dd>
              </div>
              <div class="bg-surface-0 rounded-lg px-3.5 py-2.5 space-y-0.5">
                <dt class="text-[10px] font-mono font-semibold uppercase tracking-wider text-ink-500">Safe Area</dt>
                <dd class="text-sm font-mono font-bold text-accent tabular-nums">{SAFE_PX.full.width} × {SAFE_PX.full.height}</dd>
              </div>
              <div class="bg-surface-0 rounded-lg px-3.5 py-2.5 space-y-0.5">
                <dt class="text-[10px] font-mono font-semibold uppercase tracking-wider text-ink-500">File Limit</dt>
                <dd class="text-sm font-mono font-bold text-ink-950 tabular-nums">6 MB</dd>
              </div>
              <div class="bg-surface-0 rounded-lg px-3.5 py-2.5 space-y-0.5">
                <dt class="text-[10px] font-mono font-semibold uppercase tracking-wider text-ink-500">Privacy</dt>
                <dd class="text-sm font-mono font-bold text-success tabular-nums">Client-only</dd>
              </div>
            </dl>
          </div>

        </div>

        <!-- Right rail: crop simulator inside studio console housing -->
        <div class="w-full relative group">
          <!-- Ambient backlight glow -->
          <div class="absolute -inset-1.5 bg-gradient-to-r from-accent/20 via-cyan-500/20 to-purple-600/20 rounded-3xl blur-xl opacity-70 group-hover:opacity-95 transition-opacity pointer-events-none -z-10" aria-hidden="true"></div>
          <HeroCropSimulator />
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         Block 2: Three Workflow Doors (Locked Scroll Section & Stacking Cards)
    ═══════════════════════════════════════════════════════════ -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 border-t border-line-200 mt-14">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

        <!-- Pinned Left Rail: Section Title & Locked Navigation Status -->
        <div class="lg:col-span-4 lg:sticky lg:top-24 space-y-6">
          <div class="space-y-3">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium text-accent bg-accent/10 border border-accent/20">
              <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
              Three Studio Doors
            </div>
            <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-ink-950 leading-[1.1]">
              Choose Your Channel Art Door
            </h2>
            <p class="text-sm sm:text-base text-ink-600 leading-relaxed">
              Whether you have finished artwork that needs resizing, want to check an existing banner for mobile cutoff, or need a fresh mobile-tested design.
            </p>
          </div>

          <!-- Visual Locked Step Roadmap -->
          <div class="hidden lg:block p-4 rounded-xl border border-line-200 bg-surface-50/70 space-y-3 shadow-2xs">
            <p class="text-[11px] font-mono font-semibold uppercase tracking-wider text-ink-500">
              Workflow Index
            </p>
            <div class="space-y-2 text-xs font-medium">
              <div class="flex items-center gap-3 p-2 rounded-lg bg-surface-0 border border-line-200/80 shadow-2xs text-ink-950">
                <span class="w-5 h-5 rounded-full bg-accent text-surface-0 text-[10px] font-mono font-bold flex items-center justify-center shrink-0">1</span>
                <span>Door 01 · Fix &amp; Refit</span>
              </div>
              <div class="flex items-center gap-3 p-2 rounded-lg bg-surface-0/60 border border-line-200/40 text-ink-700">
                <span class="w-5 h-5 rounded-full bg-surface-100 text-ink-800 text-[10px] font-mono font-bold flex items-center justify-center shrink-0">2</span>
                <span>Door 02 · Diagnostic Check</span>
              </div>
              <div class="flex items-center gap-3 p-2 rounded-lg bg-surface-0/60 border border-line-200/40 text-ink-700">
                <span class="w-5 h-5 rounded-full bg-surface-100 text-ink-800 text-[10px] font-mono font-bold flex items-center justify-center shrink-0">3</span>
                <span>Door 03 · New Generator</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Rail: Stacking Locked Cards Deck -->
        <div class="lg:col-span-8 space-y-6 relative">

          <!-- Door 01: Fix (Sticky Locked Card 1) -->
          <div class="group relative sticky top-20 sm:top-24 z-10 rounded-2xl border-2 border-ink-950 bg-surface-0 p-7 sm:p-9 flex flex-col justify-between space-y-6 shadow-overlay transition-all duration-300 backdrop-blur-md overflow-hidden">
            <!-- Artisanal sketch frame inner dashed boundary -->
            <div class="absolute inset-2 sm:inset-2.5 rounded-xl border border-dashed border-line-200/90 pointer-events-none transition-colors duration-300 group-hover:border-accent/40 z-0" aria-hidden="true"></div>

            <!-- Corner drafting sketch registration ticks -->
            <span class="absolute top-2.5 left-3 font-mono text-[10px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>
            <span class="absolute top-2.5 right-3 font-mono text-[10px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>
            <span class="absolute bottom-2.5 left-3 font-mono text-[10px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>
            <span class="absolute bottom-2.5 right-3 font-mono text-[10px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>

            <div class="space-y-4 relative z-10">
              <div class="flex items-start justify-between gap-2 border-b border-line-100 pb-3">
                <span class="inline-flex items-center h-6 px-2.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-ink-950 text-surface-0">
                  Door 01 · Fix
                </span>
                <span class="text-xs font-mono font-semibold text-accent flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-accent"></span>
                  Most Popular
                </span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink-950 leading-tight">
                Banner Resizer &amp; Refitter
              </h3>
              <p class="text-sm sm:text-base text-ink-600 leading-relaxed">
                Upload any existing image and fit it to YouTube's exact dimensions with live per-device preview.
              </p>
              <ul class="space-y-2 text-xs sm:text-sm text-ink-600 pt-1">
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  Reposition focal subjects safely inside the mobile safe area
                </li>
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  Toggle instant YouTube CDN re-encode compression preview
                </li>
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  Inspect mobile, desktop, tablet, and TV crops in real time
                </li>
              </ul>
            </div>
            <a
              href="/tools/youtube-banner-resizer"
              class="relative z-10 w-full sm:w-auto self-start h-12 px-6 rounded-xl bg-accent text-surface-0 font-semibold text-sm hover:bg-accent-hover active:scale-[0.98] transition-all inline-flex items-center justify-center gap-2.5 min-h-[44px] shadow-raised"
            >
              <span>Open Banner Resizer</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <!-- Door 02: Check (Sticky Locked Card 2) -->
          <div class="group relative sticky top-24 sm:top-28 z-20 rounded-2xl border-2 border-line-200 bg-surface-0 p-7 sm:p-9 flex flex-col justify-between space-y-6 shadow-overlay transition-all duration-300 backdrop-blur-md overflow-hidden">
            <!-- Artisanal sketch frame inner dashed boundary -->
            <div class="absolute inset-2 sm:inset-2.5 rounded-xl border border-dashed border-line-200/90 pointer-events-none transition-colors duration-300 group-hover:border-accent/40 z-0" aria-hidden="true"></div>

            <!-- Corner drafting sketch registration ticks -->
            <span class="absolute top-2.5 left-3 font-mono text-[10px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>
            <span class="absolute top-2.5 right-3 font-mono text-[10px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>
            <span class="absolute bottom-2.5 left-3 font-mono text-[10px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>
            <span class="absolute bottom-2.5 right-3 font-mono text-[10px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>

            <div class="space-y-4 relative z-10">
              <div class="flex items-start justify-between gap-2 border-b border-line-100 pb-3">
                <span class="inline-flex items-center h-6 px-2.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-surface-100 text-ink-800 border border-line-200">
                  Door 02 · Check
                </span>
                <span class="text-xs font-mono text-ink-500">
                  Instant Diagnostic
                </span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink-950 leading-tight">
                Safe Area Checker
              </h3>
              <p class="text-sm sm:text-base text-ink-600 leading-relaxed">
                Instant diagnostic safe-area crop verification with actionable plain-language verdicts.
              </p>
              <ul class="space-y-2 text-xs sm:text-sm text-ink-600 pt-1">
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  Immediate per-device verdict on text and logo positioning
                </li>
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  Clear warnings if graphics collide with mobile crop boundaries
                </li>
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  One-click handoff into the resizer to adjust your layout
                </li>
              </ul>
            </div>
            <a
              href="/tools/youtube-banner-checker"
              class="relative z-10 w-full sm:w-auto self-start h-12 px-6 rounded-xl bg-surface-50 text-ink-950 border border-line-200 font-semibold text-sm hover:bg-surface-100 hover:border-ink-400 active:scale-[0.98] transition-all inline-flex items-center justify-center gap-2.5 min-h-[44px] shadow-2xs"
            >
              <span>Launch Safe Area Checker</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <!-- Door 03: Create (Sticky Locked Card 3) -->
          <div class="group relative sticky top-28 sm:top-32 z-30 rounded-2xl border-2 border-line-200 bg-surface-0 p-7 sm:p-9 flex flex-col justify-between space-y-6 shadow-overlay transition-all duration-300 backdrop-blur-md overflow-hidden">
            <!-- Artisanal sketch frame inner dashed boundary -->
            <div class="absolute inset-2 sm:inset-2.5 rounded-xl border border-dashed border-line-200/90 pointer-events-none transition-colors duration-300 group-hover:border-accent/40 z-0" aria-hidden="true"></div>

            <!-- Corner drafting sketch registration ticks -->
            <span class="absolute top-2.5 left-3 font-mono text-[10px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>
            <span class="absolute top-2.5 right-3 font-mono text-[10px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>
            <span class="absolute bottom-2.5 left-3 font-mono text-[10px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>
            <span class="absolute bottom-2.5 right-3 font-mono text-[10px] text-ink-400/80 group-hover:text-accent/80 transition-colors pointer-events-none leading-none select-none z-10" aria-hidden="true">+</span>

            <div class="space-y-4 relative z-10">
              <div class="flex items-start justify-between gap-2 border-b border-line-100 pb-3">
                <span class="inline-flex items-center h-6 px-2.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-surface-100 text-ink-800 border border-line-200">
                  Door 03 · Create
                </span>
                <span class="text-xs font-mono text-ink-500">
                  Generator &amp; Presets
                </span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink-950 leading-tight">
                Banner Generator
              </h3>
              <p class="text-sm sm:text-base text-ink-600 leading-relaxed">
                Start from curated, geometry-safe templates engineered to fit mobile screens.
              </p>
              <ul class="space-y-2 text-xs sm:text-sm text-ink-600 pt-1">
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  Category-specific layouts for gaming, tech, podcasting, and vlogs
                </li>
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  Typography and logos pre-aligned inside the safe center frame
                </li>
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  Customizable colors, text layers, and background art
                </li>
              </ul>
            </div>
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 relative z-10">
              <a
                href="/tools/youtube-banner-maker"
                class="w-full sm:w-auto h-12 px-6 rounded-xl bg-surface-50 text-ink-950 border border-line-200 font-semibold text-sm hover:bg-surface-100 hover:border-ink-400 active:scale-[0.98] transition-all inline-flex items-center justify-center gap-2.5 min-h-[44px] shadow-2xs"
              >
                <span>Design New Banner</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <a
                href="/templates"
                class="text-xs font-semibold text-accent hover:underline underline-offset-4 py-2 px-1"
              >
                Or explore curated template gallery &rarr;
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         Block 2.5: Curated Channel Art Presets (Instant Creation)
    ═══════════════════════════════════════════════════════════ -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-t border-line-200">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium text-accent bg-accent/8 border border-accent/20">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            Zero-Cutoff Presets
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-ink-950">
