---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SpecTable from '../components/SpecTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import HeroCropSimulator from '../components/HeroCropSimulator.astro';
import TemplateCard from '../components/TemplateCard.astro';
import { STATIC_PAGES_SEO, getWebSiteSchema, getOrganizationSchema } from '../lib/seo';
import { CANVAS, SAFE, SAFE_PX, DEVICES, REENCODE_BUDGET_BYTES } from '../lib/spec';
import { getTemplate, type TemplateManifest } from '../lib/template';

const path = '/';
const seo = STATIC_PAGES_SEO[path];

const jsonLd = [
  getWebSiteSchema(),
  getOrganizationSchema(),
];

const desktopHeight = Math.round(DEVICES.desktop.h * CANVAS.height);
const desktopY = Math.round(DEVICES.desktop.y * CANVAS.height);
const tabletWidth = Math.round(DEVICES.tablet.w * CANVAS.width);
const tabletX = Math.round(DEVICES.tablet.x * CANVAS.width);
const mobileX = Math.round(SAFE.x * CANVAS.width);
const mobileY = Math.round(SAFE.y * CANVAS.height);
const desktopKb = Math.round(REENCODE_BUDGET_BYTES.desktop / 1000);

const featuredTemplates = [
  getTemplate('gaming-neon'),
  getTemplate('tech-hardware'),
  getTemplate('podcast-noir'),
  getTemplate('vlog-cinema'),
  getTemplate('music-synthwave'),
  getTemplate('life-botanical'),
].filter((t): t is TemplateManifest => t !== undefined);
---

<BaseLayout
  title={seo.title}
  description={seo.desc}
  path={path}
  jsonLd={jsonLd}
>
  <Header currentPath={path} />

  <main id="main-content" class="flex-1">

    <!-- ═══════════════════════════════════════════════════════════
         Block 1: Asymmetric Split Hero
         Left: headline + CTAs + instrument readout
         Right: live crop simulator inside double-bezel enclosure
    ═══════════════════════════════════════════════════════════ -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-4 lg:pt-14">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] gap-8 lg:gap-12 items-center">

        <!-- Left rail -->
        <div class="space-y-6 lg:pr-2">
          <!-- Subtle Luxury Eyebrow Tag -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium text-accent bg-accent/8 border border-accent/20 shadow-2xs">
            <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
            Zero-Crop Channel Art Engine
          </div>

          <div class="space-y-4">
            <h1 class="text-3xl sm:text-5xl lg:text-[3.5rem] font-extrabold tracking-[-0.035em] text-ink-950 leading-[1.04]">
              Free YouTube Banner Maker That Fits <span class="text-accent underline decoration-accent/30 underline-offset-8">Every Screen</span>
            </h1>
            <p class="text-base sm:text-lg text-ink-600 leading-relaxed max-w-[44ch] font-normal">
              Create or resize your banner and preview exactly how it will appear on mobile, desktop, tablet, and TV. Everything runs in your browser.
            </p>
          </div>

          <!-- Primary CTAs with button-in-button elevation -->
          <div class="flex flex-col sm:flex-row gap-3 pt-1">
            <a
              href="/tools/youtube-banner-resizer"
              class="group inline-flex items-center justify-center gap-3 h-12 px-6 rounded-xl bg-accent text-surface-0 font-semibold text-sm hover:bg-accent-hover active:scale-[0.98] transition-all focus-visible:outline-accent shadow-raised min-h-[44px]"
            >
              <span>Fix Existing Artwork</span>
              <span class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center group-hover:translate-x-0.5 transition-transform" aria-hidden="true">
                <svg class="w-3.5 h-3.5" viewBox="0 0 14 14" fill="none">
                  <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
            <a
              href="/tools/youtube-banner-checker"
              class="inline-flex items-center justify-center gap-2 h-12 px-6 rounded-xl bg-surface-0 text-ink-950 border border-line-200 font-semibold text-sm hover:bg-surface-50 active:scale-[0.98] transition-all focus-visible:outline-accent shadow-2xs min-h-[44px]"
            >
              <span>Check Safe Area</span>
            </a>
          </div>

          <!-- 4-cell instrument readout strip with double-bezel hardware styling -->
          <div class="p-1 rounded-xl bg-surface-100/80 border border-line-200 shadow-raised">
            <dl class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4 gap-1">
              <div class="bg-surface-0 rounded-lg px-3.5 py-2.5 space-y-0.5">
                <dt class="text-[10px] font-mono font-semibold uppercase tracking-wider text-ink-500">Canvas</dt>
                <dd class="text-sm font-mono font-bold text-ink-950 tabular-nums">{CANVAS.width} × {CANVAS.height}</dd>
              </div>
              <div class="bg-surface-0 rounded-lg px-3.5 py-2.5 space-y-0.5">
                <dt class="text-[10px] font-mono font-semibold uppercase tracking-wider text-ink-500">Safe Area</dt>
                <dd class="text-sm font-mono font-bold text-accent tabular-nums">{SAFE_PX.full.width} × {SAFE_PX.full.height}</dd>
              </div>
              <div class="bg-surface-0 rounded-lg px-3.5 py-2.5 space-y-0.5">
                <dt class="text-[10px] font-mono font-semibold uppercase tracking-wider text-ink-500">File Limit</dt>
                <dd class="text-sm font-mono font-bold text-ink-950 tabular-nums">6 MB</dd>
              </div>
              <div class="bg-surface-0 rounded-lg px-3.5 py-2.5 space-y-0.5">
                <dt class="text-[10px] font-mono font-semibold uppercase tracking-wider text-ink-500">Privacy</dt>
                <dd class="text-sm font-mono font-bold text-success tabular-nums">Client-only</dd>
              </div>
            </dl>
          </div>

          <!-- Trust Badges -->
          <div class="flex flex-wrap items-center gap-2 text-xs text-ink-600 pt-1">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-50 border border-line-200 text-xs font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
              100% Client-Side Privacy
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-50 border border-line-200 text-xs font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
              No Sign-Up or Accounts
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-50 border border-line-200 text-xs font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
              No Watermark
            </span>
          </div>
        </div>

        <!-- Right rail: crop simulator inside luxury double-bezel frame -->
        <div class="w-full p-2 sm:p-2.5 rounded-2xl bg-surface-100/70 border border-line-200 shadow-overlay">
          <HeroCropSimulator />
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         Block 2: Three Workflow Doors (asymmetric workbench layout)
    ═══════════════════════════════════════════════════════════ -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-t border-line-200 mt-14">
      <div class="space-y-2 mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950">
          Choose Your Channel Art Door
        </h2>
        <p class="text-sm text-ink-600 max-w-[52ch] leading-relaxed">
          Whether you have finished artwork that needs resizing, want to check an existing banner for mobile cutoff, or need a fresh mobile-tested design.
        </p>
      </div>

      <!-- Asymmetric grid: primary door (Fix) has prominent visual weight -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-5">

        <!-- Door 01: Fix - primary, larger visual weight -->
        <div class="group relative rounded-2xl border-2 border-ink-950 dark:border-line-200 bg-surface-0 p-7 sm:p-8 flex flex-col justify-between space-y-6 shadow-raised transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1.5 hover:shadow-overlay hover:border-accent cursor-pointer active:translate-y-0 active:scale-[0.99] motion-reduce:transform-none">
          <div class="space-y-3">
            <div class="flex items-start justify-between gap-2">
              <span class="inline-flex items-center h-5 px-2 rounded text-[10px] font-mono font-bold uppercase tracking-wider bg-ink-950 text-surface-0 group-hover:bg-accent transition-colors">
                Door 01 · Fix
              </span>
              <span class="text-[10px] font-mono text-ink-500 pt-0.5">Most used</span>
            </div>
            <h3 class="text-xl font-bold tracking-tight text-ink-950 leading-snug group-hover:text-accent transition-colors">
              Banner Resizer<br class="hidden sm:block" />&amp; Refitter
            </h3>
            <p class="text-sm text-ink-600 leading-relaxed">
              Upload any existing image and fit it to YouTube's exact dimensions with live per-device preview.
            </p>
            <ul class="space-y-1.5 text-xs text-ink-600 mt-1">
              <li class="flex items-start gap-2">
                <span class="mt-0.5 w-1 h-1 rounded-full bg-ink-400 flex-shrink-0"></span>
                Reposition focal subjects safely inside the mobile safe area
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-0.5 w-1 h-1 rounded-full bg-ink-400 flex-shrink-0"></span>
                Toggle instant YouTube CDN re-encode compression preview
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-0.5 w-1 h-1 rounded-full bg-ink-400 flex-shrink-0"></span>
                Inspect mobile, desktop, tablet, and TV crops in real time
              </li>
            </ul>
          </div>
          <a
            href="/tools/youtube-banner-resizer"
            class="w-full h-11 px-5 rounded-lg bg-ink-950 text-surface-0 font-semibold text-xs group-hover:bg-accent transition-colors inline-flex items-center justify-center gap-2 min-h-[44px] after:absolute after:inset-0 after:rounded-2xl after:pointer-events-auto"
          >
            <span>Open Banner Resizer</span>
            <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Door 02: Check -->
        <div class="group relative rounded-2xl border border-line-200 bg-surface-0 p-7 sm:p-8 flex flex-col justify-between space-y-6 shadow-2xs transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1.5 hover:shadow-raised hover:border-ink-400/40 cursor-pointer active:translate-y-0 active:scale-[0.99] motion-reduce:transform-none">
          <div class="space-y-3">
            <div class="flex items-start justify-between gap-2">
              <span class="inline-flex items-center h-5 px-2 rounded text-[10px] font-mono font-bold uppercase tracking-wider bg-surface-100 text-ink-600 border border-line-200">
                Door 02 · Check
              </span>
              <span class="text-[10px] font-mono text-ink-500 pt-0.5">Diagnostic</span>
            </div>
            <h3 class="text-xl font-bold tracking-tight text-ink-950 leading-snug group-hover:text-accent transition-colors">
              Safe Area Checker
            </h3>
            <p class="text-sm text-ink-600 leading-relaxed">
              Instant diagnostic safe-area crop verification with actionable plain-language verdicts.
            </p>
            <ul class="space-y-1.5 text-xs text-ink-600 mt-1">
              <li class="flex items-start gap-2">
                <span class="mt-0.5 w-1 h-1 rounded-full bg-ink-400 flex-shrink-0"></span>
                Immediate per-device verdict on text and logo positioning
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-0.5 w-1 h-1 rounded-full bg-ink-400 flex-shrink-0"></span>
                Clear warnings if graphics collide with mobile crop boundaries
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-0.5 w-1 h-1 rounded-full bg-ink-400 flex-shrink-0"></span>
                One-click handoff into the resizer to adjust your layout
              </li>
            </ul>
          </div>
          <a
            href="/tools/youtube-banner-checker"
            class="w-full h-11 px-5 rounded-lg bg-surface-0 text-ink-950 border border-line-200 font-semibold text-xs group-hover:bg-surface-100 group-hover:border-ink-400/40 transition-colors inline-flex items-center justify-center gap-2 min-h-[44px] after:absolute after:inset-0 after:rounded-2xl after:pointer-events-auto"
          >
            <span>Launch Safe Area Checker</span>
            <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Door 03: Create -->
        <div class="group relative rounded-2xl border border-line-200 bg-surface-0 p-7 sm:p-8 flex flex-col justify-between space-y-6 shadow-2xs transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1.5 hover:shadow-raised hover:border-ink-400/40 cursor-pointer active:translate-y-0 active:scale-[0.99] motion-reduce:transform-none">
          <div class="space-y-3">
            <div class="flex items-start justify-between gap-2">
              <span class="inline-flex items-center h-5 px-2 rounded text-[10px] font-mono font-bold uppercase tracking-wider bg-surface-100 text-ink-600 border border-line-200">
                Door 03 · Create
              </span>
              <span class="text-[10px] font-mono text-ink-500 pt-0.5">Generator</span>
            </div>
            <h3 class="text-xl font-bold tracking-tight text-ink-950 leading-snug group-hover:text-accent transition-colors">
              Banner Generator
            </h3>
            <p class="text-sm text-ink-600 leading-relaxed">
              Start from curated, geometry-safe templates engineered to fit mobile screens.
            </p>
            <ul class="space-y-1.5 text-xs text-ink-600 mt-1">
              <li class="flex items-start gap-2">
                <span class="mt-0.5 w-1 h-1 rounded-full bg-ink-400 flex-shrink-0"></span>
                Category-specific layouts for gaming, tech, podcasting, and vlogs
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-0.5 w-1 h-1 rounded-full bg-ink-400 flex-shrink-0"></span>
                Typography and logos pre-aligned inside the safe center frame
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-0.5 w-1 h-1 rounded-full bg-ink-400 flex-shrink-0"></span>
                Customizable colors, text layers, and background art
              </li>
            </ul>
          </div>
          <div class="space-y-2">
            <a
              href="/tools/youtube-banner-maker"
              class="w-full h-11 px-5 rounded-lg bg-surface-0 text-ink-950 border border-line-200 font-semibold text-xs group-hover:bg-surface-100 group-hover:border-ink-400/40 transition-colors inline-flex items-center justify-center gap-2 min-h-[44px] after:absolute after:inset-0 after:rounded-2xl after:pointer-events-auto"
            >
              <span>Design New Banner</span>
              <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
            </a>
            <div class="text-center relative z-10">
              <a href="/templates" class="text-[11px] text-ink-500 hover:text-accent underline underline-offset-2 transition-colors">
                Or explore curated template gallery &rarr;
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         Block 2.5: Curated Channel Art Presets (Instant Creation)
    ═══════════════════════════════════════════════════════════ -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-t border-line-200">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium text-accent bg-accent/8 border border-accent/20">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            Zero-Cutoff Presets
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-ink-950">
            Start From a Verified Channel Art Preset
          </h2>
          <p class="text-base text-ink-600 leading-relaxed">
            Every template is mathematically bounded to the centered mobile safe zone. Choose a design, customize your title and branding in seconds, and export at full 2560 × 1440 fidelity.
          </p>
        </div>
        <a
          href="/templates"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-surface-0 border border-line-200 text-ink-950 font-semibold text-sm hover:bg-surface-50 transition-colors focus-visible:outline-accent shadow-2xs shrink-0 self-start sm:self-auto min-h-[44px]"
        >
          <span>Explore All 100+ Free Presets</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredTemplates.map((template) => (
          <TemplateCard template={template} loading="lazy" />
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         Block 3: "What YouTube Actually Does to Your Banner"
         Architectural & Technical Blueprint (Zero Text Collision)
    ═══════════════════════════════════════════════════════════ -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-t border-line-200 space-y-10">
      <div class="space-y-3 max-w-3xl">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950">
          What YouTube Actually Does to Your Banner
        </h2>
        <p class="text-sm text-ink-600 leading-relaxed max-w-[60ch]">
          YouTube does not scale your channel art down evenly. Instead, it uploads a single 16:9 canvas ({CANVAS.width} × {CANVAS.height} px) and carves out different viewports depending on the viewer's device.
        </p>
      </div>

      <!-- Precision Blueprint SVG Diagram -->
      <div class="space-y-6">
        <div class="w-full overflow-hidden rounded-2xl border border-line-200 bg-surface-50 p-3 sm:p-5 shadow-raised">
          <svg
            viewBox={`0 0 ${CANVAS.width} ${CANVAS.height}`}
            class="w-full h-auto rounded-xl bg-surface-0 shadow-inner"
            role="img"
            aria-label="Diagram showing YouTube banner crop zones across TV, desktop, tablet, and mobile safe area"
          >
            <!-- TV Background: Full 16:9 Canvas -->
            <rect
              x="0"
              y="0"
              width={CANVAS.width}
              height={CANVAS.height}
              fill="#F8FAFC"
              stroke="#E2E8F0"
              stroke-width="6"
            />

            <!-- 1. TV Screen Viewport Tag (Top-left corner) -->
            <g transform="translate(60, 60)">
              <rect width="480" height="74" rx="12" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="2" />
              <text x="24" y="34" font-family="system-ui, -apple-system, sans-serif" font-size="20" font-weight="700" fill="#0F172A">
                1. TV SCREEN VIEWPORT
              </text>
              <text x="24" y="56" font-family="ui-monospace, monospace" font-size="16" font-weight="600" fill="#64748B">
                {CANVAS.width} × {CANVAS.height} px · Full 16:9 Canvas
              </text>
            </g>

            <!-- 2. Desktop Ribbon (Full width band) -->
            <rect
              x="0"
              y={desktopY}
              width={CANVAS.width}
              height={desktopHeight}
              fill="#F1F5F9"
              stroke="#475569"
              stroke-width="4"
              stroke-dasharray="12 8"
            />

            <!-- Desktop Viewport Tag (Placed ABOVE the desktop ribbon on the left - zero collision) -->
            <g transform={`translate(60, ${desktopY - 88})`}>
              <rect width="520" height="72" rx="12" fill="#FFFFFF" stroke="#94A3B8" stroke-width="2" />
              <text x="24" y="32" font-family="system-ui, -apple-system, sans-serif" font-size="20" font-weight="700" fill="#0F172A">
                2. DESKTOP VIEWPORT
              </text>
              <text x="24" y="54" font-family="ui-monospace, monospace" font-size="16" font-weight="600" fill="#475569">
                {CANVAS.width} × {desktopHeight} px · Top &amp; Bottom Cropped
              </text>
            </g>

            <!-- 3. Tablet Viewport (Centered ribbon crop) -->
            <rect
              x={tabletX}
              y={desktopY}
              width={tabletWidth}
              height={desktopHeight}
              fill="#E2E8F0"
              fill-opacity="0.5"
              stroke="#64748B"
              stroke-width="4"
              stroke-dasharray="8 6"
            />

            <!-- Tablet Viewport Tag (Placed ABOVE the desktop ribbon on the right - zero collision) -->
            <g transform={`translate(${CANVAS.width - 580}, ${desktopY - 88})`}>
              <rect width="520" height="72" rx="12" fill="#FFFFFF" stroke="#94A3B8" stroke-width="2" />
              <text x="24" y="32" font-family="system-ui, -apple-system, sans-serif" font-size="20" font-weight="700" fill="#0F172A">
                3. TABLET VIEWPORT
              </text>
              <text x="24" y="54" font-family="ui-monospace, monospace" font-size="16" font-weight="600" fill="#475569">
                {tabletWidth} × {desktopHeight} px · Scaled Ribbon
              </text>
            </g>

            <!-- 4. Mobile Safe Area Box (Centered intersection) -->
            <rect
              x={mobileX}
              y={mobileY}
              width={SAFE_PX.full.width}
              height={SAFE_PX.full.height}
              fill="var(--color-accent)"
              fill-opacity="0.10"
              stroke="var(--color-accent)"
              stroke-width="8"
              rx="16"
            />

            <!-- Mobile Safe Area Corner Framing Ticks (Architectural precision markers) -->
            <path
              d={`M ${mobileX + 28} ${mobileY + 12} L ${mobileX + 12} ${mobileY + 12} L ${mobileX + 12} ${mobileY + 28}`}
              fill="none"
              stroke="var(--color-accent)"
              stroke-width="5"
            />
            <path
              d={`M ${mobileX + SAFE_PX.full.width - 28} ${mobileY + 12} L ${mobileX + SAFE_PX.full.width - 12} ${mobileY + 12} L ${mobileX + SAFE_PX.full.width - 12} ${mobileY + 28}`}
              fill="none"
              stroke="var(--color-accent)"
              stroke-width="5"
            />
            <path
              d={`M ${mobileX + 28} ${mobileY + SAFE_PX.full.height - 12} L ${mobileX + 12} ${mobileY + SAFE_PX.full.height - 12} L ${mobileX + 12} ${mobileY + SAFE_PX.full.height - 28}`}
              fill="none"
              stroke="var(--color-accent)"
              stroke-width="5"
            />
            <path
              d={`M ${mobileX + SAFE_PX.full.width - 28} ${mobileY + SAFE_PX.full.height - 12} L ${mobileX + SAFE_PX.full.width - 12} ${mobileY + SAFE_PX.full.height - 12} L ${mobileX + SAFE_PX.full.width - 12} ${mobileY + SAFE_PX.full.height - 28}`}
              fill="none"
              stroke="var(--color-accent)"
              stroke-width="5"
            />

            <!-- Mobile Safe Area Center Floating Badge (High contrast, zero text collision) -->
            <g transform={`translate(${CANVAS.width / 2}, ${CANVAS.height / 2})`} text-anchor="middle">
              <rect
                x="-450"
                y="-90"
                width="900"
                height="180"
                rx="16"
                fill="#FFFFFF"
                fill-opacity="0.95"
                stroke="var(--color-accent)"
                stroke-width="3"
                stroke-opacity="0.5"
              />
              <text
                y="-25"
                font-family="system-ui, -apple-system, sans-serif"
