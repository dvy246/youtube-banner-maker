---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SpecTable from '../../components/SpecTable.astro';
import DeviceCropTable from '../../components/DeviceCropTable.astro';
import { STATIC_PAGES_SEO, getBreadcrumbSchema, getFAQSchema, getTechArticleSchema } from '../../lib/seo';
import { CANVAS, SAFE, SAFE_PX, DEVICES, REENCODE_BUDGET_BYTES, MAX_UPLOAD_BYTES } from '../../lib/spec';

const path = '/guides/youtube-banner-size';
const seo = STATIC_PAGES_SEO[path];

const maxUploadMb = Math.round(MAX_UPLOAD_BYTES / (1024 * 1024));
const desktopBudgetKb = Math.round(REENCODE_BUDGET_BYTES.desktop / 1000);

const faqs = [
  {
    question: 'What is the correct YouTube banner size?',
    answer: `The official recommended YouTube banner size is ${CANVAS.width} × ${CANVAS.height} pixels with a 16:9 aspect ratio. The minimum supported size is 2048 × 1152 pixels, and the maximum file upload size is ${maxUploadMb} MB.`,
  },
  {
    question: 'Can I upload a 1024x576 YouTube banner?',
    answer: 'No. While 1024×576 maintains the identical 16:9 aspect ratio, YouTube Studio strictly enforces a minimum upload dimension of 2048×1152 pixels. Uploading a 1024×576 image will trigger an immediate error: "Image is too small". Use our free YouTube Banner Resizer to upscale and fit your artwork to the verified 2560×1440 standard.',
  },
  {
    question: 'What is the 2048 x 1152 YouTube banner requirement?',
    answer: '2048 × 1152 pixels is the absolute minimum upload size accepted by YouTube Studio. While YouTube allows this minimum, 2560 × 1440 pixels is strongly recommended to preserve sharpness across 4K displays and smart TVs without upscaling blur.',
  },
  {
    question: 'What is the mobile safe area for YouTube banners?',
    answer: `The mobile safe area is the central ${SAFE_PX.full.width} × ${SAFE_PX.full.height} pixel zone (or ${SAFE_PX.min.width} × ${SAFE_PX.min.height} pixels on minimum uploads). All text, logos, social handles, and faces must remain within this zone to avoid getting cut off on mobile devices.`,
  },
  {
    question: 'Why does YouTube cut off the top and bottom of my banner on computers?',
    answer: `Desktop browsers only display a horizontal banner ribbon covering ${(DEVICES.desktop.h * 100).toFixed(1)}% of the canvas height. The top and bottom margins (~35% each) are cropped away by YouTube's layout engine.`,
  },
  {
    question: 'Why do my banner colors look washed out or different after uploading?',
    answer: `YouTube's image processing pipeline operates in the standard sRGB color space. If your graphics software exports using Display P3 or Adobe RGB profiles, YouTube clamps the gamut without color management tags, causing muted colors or hue shifts. Always export in sRGB.`,
  },
  {
    question: 'What is the recommended YouTube banner size?',
    answer: `The official recommended YouTube banner size is ${CANVAS.width} × ${CANVAS.height} pixels with a 16:9 aspect ratio. The minimum upload dimension is 2048 × 1152 pixels. The maximum file size accepted by YouTube Studio is ${maxUploadMb} MB in PNG, JPEG, or WebP format.`,
  },
  {
    question: 'What is the YouTube banner safe area?',
    answer: `The mobile safe area is a centered ${SAFE_PX.full.width} × ${SAFE_PX.full.height} pixel box within the ${CANVAS.width} × ${CANVAS.height} canvas. Any logos, channel names, taglines, or focal subjects placed inside this area will be completely visible on all devices, including mobile smartphones, tablets, laptops, desktops, and smart TVs.`,
  },
  {
    question: 'Why does my YouTube banner look blurry or low quality?',
    answer: 'YouTube automatically recompresses uploaded banners via its content delivery network using WebP and JPEG downsampling. Uploading below 2560×1440 or using an image above 6 MB triggers aggressive server-side recompression. Ensuring your canvas is exactly 2560×1440 and keeping critical detail centered in the safe area produces the crispest result.',
  },
  {
    question: 'Can I upload a PNG banner to YouTube?',
    answer: 'Yes, YouTube Studio accepts PNG, JPEG, and WebP files up to 6 MB. While PNG is ideal for sharp graphic text and vector logos, YouTube may convert it to WebP or JPEG when delivering to client browsers.',
  },
];

const jsonLd = [
  getTechArticleSchema({
    title: seo.title,
    description: seo.desc,
    path,
    datePublished: '2026-01-15T00:00:00Z',
    dateModified: '2026-09-09T00:00:00Z',
  }),
  getBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'YouTube Banner Size Guide', url: path },
  ]),
  getFAQSchema(faqs),
];
---

<BaseLayout
  title={seo.title}
  description={seo.desc}
  path={path}
  jsonLd={jsonLd}
>
  <Header currentPath={path} />

  <main id="main-content" class="flex-1">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
      
      <!-- Hero / Header with Direct-Answer First (SEO.md §8.1) -->
      <header class="space-y-6 border-b border-line-200 pb-10">
        <nav aria-label="Breadcrumb" class="text-xs font-mono text-ink-500 flex items-center gap-2">
          <a href="/" class="hover:text-ink-950 transition-colors">Home</a>
          <span class="text-line-200">/</span>
          <span class="text-ink-800 font-medium">Banner Size Guide</span>
        </nav>

        <div class="space-y-3">
          <span class="inline-block text-xs font-mono uppercase tracking-wider font-semibold text-accent">
            Official Technical Specifications · Updated 2026
          </span>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink-950">
            YouTube Banner Size: Dimensions, Safe Area & Device Crops
          </h1>
          <p class="text-base sm:text-lg text-ink-600 leading-relaxed measure-prose">
            The definitive guide to YouTube channel art dimensions, mobile safe areas, file size caps, and server-side CDN cropping mechanics.
          </p>
        </div>

        <!-- E-E-A-T Author & Citation Byline -->
        <div class="flex flex-wrap items-center gap-3 text-xs text-ink-600 border-t border-line-200 pt-4">
          <span>By <strong>Channel Branding Operations Team</strong></span>
          <span>·</span>
          <span>Verified against <a href="https://support.google.com/youtube/answer/2657964" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent font-medium">YouTube Help Center: Manage Channel Branding</a></span>
          <span>·</span>
          <span>March 2026 Revision</span>
        </div>

        <!-- Direct Answer Card -->
        <div class="p-6 rounded-xl border border-accent/20 bg-surface-50 space-y-4">
          <div class="space-y-2">
            <span class="text-xs font-mono uppercase tracking-wider font-bold text-accent">
              Direct Answer
            </span>
            <p class="text-base sm:text-lg text-ink-950 font-medium leading-snug">
              If you are wondering what size is a YouTube banner, the official recommended YouTube banner size is <strong>{CANVAS.width} × {CANVAS.height} pixels</strong> with a <strong>16:9 aspect ratio</strong>.
            </p>
          </div>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            The minimum accepted upload dimension is <strong>2048 × 1152 pixels</strong>, and the maximum file size limit is <strong>{maxUploadMb} MB</strong>. To avoid cutoffs on mobile phones and tablets, all text, logos, and essential graphics must stay inside the centered <strong>{SAFE_PX.full.width} × {SAFE_PX.full.height} pixel safe area</strong>.
          </p>

          <!-- At a Glance Metric Pills -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2">
            <div class="p-3 bg-surface-0 border border-line-200 rounded-lg">
              <span class="text-[11px] font-mono text-ink-500 uppercase tracking-wider block">Recommended</span>
              <span class="text-sm sm:text-base font-mono font-bold text-ink-950">{CANVAS.width} × {CANVAS.height} px</span>
              <span class="text-[11px] text-ink-500 block">16:9 TV Full Frame</span>
            </div>
            <div class="p-3 bg-surface-0 border border-line-200 rounded-lg">
              <span class="text-[11px] font-mono text-ink-500 uppercase tracking-wider block">Minimum Size</span>
              <span class="text-sm sm:text-base font-mono font-bold text-ink-950">2048 × 1152 px</span>
              <span class="text-[11px] text-ink-500 block">Studio upload floor</span>
            </div>
            <div class="p-3 bg-surface-0 border border-line-200 rounded-lg">
              <span class="text-[11px] font-mono text-ink-500 uppercase tracking-wider block">Mobile Safe Area</span>
              <span class="text-sm sm:text-base font-mono font-bold text-accent">{SAFE_PX.full.width} × {SAFE_PX.full.height} px</span>
              <span class="text-[11px] text-ink-500 block">Visible everywhere</span>
            </div>
            <div class="p-3 bg-surface-0 border border-line-200 rounded-lg">
              <span class="text-[11px] font-mono text-ink-500 uppercase tracking-wider block">Max File Size</span>
              <span class="text-sm sm:text-base font-mono font-bold text-ink-950">{maxUploadMb} MB</span>
              <span class="text-[11px] text-ink-500 block">PNG, JPG, WebP</span>
            </div>
            <div class="p-3 bg-surface-0 border border-line-200 rounded-lg">
              <span class="text-[11px] font-mono text-ink-500 uppercase tracking-wider block">Color Space</span>
              <span class="text-sm sm:text-base font-mono font-bold text-ink-950">sRGB</span>
              <span class="text-[11px] text-ink-500 block">Standard web color</span>
            </div>
            <div class="p-3 bg-surface-0 border border-line-200 rounded-lg">
              <span class="text-[11px] font-mono text-ink-500 uppercase tracking-wider block">Server Budget</span>
              <span class="text-sm sm:text-base font-mono font-bold text-ink-950">~{desktopBudgetKb} KB</span>
              <span class="text-[11px] text-ink-500 block">Desktop slice budget</span>
            </div>
          </div>
        </div>
      </header>

      <!-- Section 1: Official Specifications Table -->
      <section class="space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            01 · Technical Requirements
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            Official YouTube Banner Specifications
          </h2>
        </div>
        <p class="text-sm text-ink-600 leading-relaxed measure-prose">
          When uploading channel artwork to YouTube Studio, your file is checked against strict boundary constraints. The table below lists the required parameters verified against Google's official creator documentation and YouTube Studio upload validators.
        </p>

        <SpecTable />
      </section>

      <!-- Section 2: Device Crops -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            02 · Viewport Geometry
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            How YouTube Crops Your Banner Across Devices
          </h2>
        </div>
        <p class="text-sm text-ink-600 leading-relaxed measure-prose">
          YouTube does not scale your full 16:9 artwork down proportionally on computers or mobile phones. Instead, YouTube displays specific cropped viewports depending on the device:
        </p>
        <ul class="space-y-2 text-sm text-ink-800 list-disc pl-5 measure-prose">
          <li>
            <strong>Smart TVs & Game Consoles:</strong> Display the entire 16:9 artwork at {CANVAS.width} × {CANVAS.height} pixels (100% of the canvas).
          </li>
          <li>
            <strong>Desktop Computers:</strong> Display a wide horizontal slice ({CANVAS.width} × {Math.round(DEVICES.desktop.h * CANVAS.height)} px), cropping away roughly 35% of the height from the top and bottom.
          </li>
          <li>
            <strong>Tablets:</strong> Display a centered horizontal ribbon crop ({Math.round(DEVICES.tablet.w * CANVAS.width)} × {SAFE_PX.full.height} px), wider than mobile screens but constrained vertically to YouTube's safe band.
          </li>
          <li>
            <strong>Mobile Smartphones:</strong> Display only the center safe area window ({SAFE_PX.full.width} × {SAFE_PX.full.height} px).
          </li>
        </ul>

        <DeviceCropTable />
      </section>

      <!-- Section 3: Empirical Research & fcrop64 -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            03 · Empirical CDN Research
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            Empirical Research: Decoded <code class="text-accent font-mono">fcrop64</code> Fractions
          </h2>
        </div>
        <p class="text-sm text-ink-600 leading-relaxed measure-prose">
          Most sizing guides online repeat anecdotal dimensions without verifying how YouTube's infrastructure actually serves banner images. To determine the ground truth, we audited live banner delivery from YouTube's image CDN (<code class="text-xs bg-surface-50 border border-line-200 px-1 py-0.5 rounded font-mono">yt3.googleusercontent.com</code>) across prominent creator channels (including Veritasium, MKBHD, Kurzgesagt, TED, and NASA), verified as of September 2026.
        </p>
        <div class="p-6 rounded-xl border border-line-200 bg-surface-50 space-y-4">
          <h3 class="text-sm font-semibold text-ink-950">Understanding the 64-Bit Crop Coordinate Token</h3>
          <p class="text-xs text-ink-600 leading-relaxed measure-prose">
            YouTube's image CDN uses a query parameter formatted as <code class="font-mono text-ink-950 font-medium">fcrop64=1,x1y1x2y2</code> to crop images server-side. Each token contains four 16-bit unsigned hex values representing normalized crop boundaries across the unit interval [0, 65535]:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="p-3 bg-surface-0 border border-line-200 rounded-lg space-y-1">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-ink-950">Television View</span>
                <span class="font-mono text-accent">00000000ffffffff</span>
              </div>
              <p class="text-ink-600">
                Maps to <code class="font-mono">[0, 0, 1.0, 1.0]</code>. The complete 100% width and 100% height of the uploaded canvas is preserved.
              </p>
            </div>

            <div class="p-3 bg-surface-0 border border-line-200 rounded-lg space-y-1">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-ink-950">Desktop Ribbon</span>
                <span class="font-mono text-accent">00005a57ffffa5a8</span>
              </div>
              <p class="text-ink-600">
                Maps to a vertical window starting at {(DEVICES.desktop.y * 100).toFixed(2)}% top offset with a height fraction of {(DEVICES.desktop.h * 100).toFixed(2)}% (100% width).
              </p>
            </div>

            <div class="p-3 bg-surface-0 border border-line-200 rounded-lg space-y-1">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-ink-950">Tablet Crop</span>
                <span class="font-mono text-accent">Horizontal Band</span>
              </div>
              <p class="text-ink-600">
                Maps to a horizontal window spanning {(DEVICES.tablet.w * 100).toFixed(2)}% of the canvas width, displayed as a horizontal header band.
              </p>
            </div>

            <div class="p-3 bg-surface-0 border border-line-200 rounded-lg space-y-1">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-ink-950">Mobile Safe Center</span>
                <span class="font-mono text-accent">Centered Envelope</span>
              </div>
              <p class="text-ink-600">
                A centered viewing rectangle measuring {(SAFE.w * 100).toFixed(1)}% width by {(SAFE.h * 100).toFixed(1)}% height, preserved across all smartphones.
              </p>
            </div>
          </div>

          <p class="text-xs text-ink-500 leading-relaxed">
            Our multi-channel analysis confirmed that these crop fractions are identical across verified channels, proving that device crops are governed by universal layout rules rather than individual channel configurations.
          </p>
        </div>
      </section>

      <!-- Section 4: Safe Area Reconciliation -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            04 · Safe Area Clarification
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            The Safe Area Reconciliation
          </h2>
        </div>
        <p class="text-sm text-ink-600 leading-relaxed measure-prose">
          A widespread source of confusion across creator forums is why some documentation cites <strong>{SAFE_PX.min.width} × {SAFE_PX.min.height} pixels</strong> as the safe area, while others insist on <strong>{SAFE_PX.full.width} × {SAFE_PX.full.height} pixels</strong>.
        </p>
        <p class="text-sm text-ink-600 leading-relaxed measure-prose">
          These are not conflicting rules. They describe the <strong>exact same centered viewing rectangle</strong> measured against two different canvas resolutions:
        </p>
        <div class="p-5 rounded-xl border border-line-200 bg-surface-50 space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
            <div class="p-3 bg-surface-0 border border-line-200 rounded-lg">
              <span class="text-ink-500 block mb-1">On Minimum Upload (2048 × 1152 px):</span>
              <span class="text-ink-950 font-bold block">{SAFE_PX.min.width} / 2048 = {(SAFE_PX.min.width / 2048).toFixed(4)} (60.30% width)</span>
              <span class="text-ink-950 font-bold block">{SAFE_PX.min.height} / 1152 = {(SAFE_PX.min.height / 1152).toFixed(4)} (29.34% height)</span>
            </div>
            <div class="p-3 bg-surface-0 border border-line-200 rounded-lg">
              <span class="text-ink-500 block mb-1">On Recommended Upload ({CANVAS.width} × {CANVAS.height} px):</span>
              <span class="text-ink-950 font-bold block">{SAFE_PX.full.width} / {CANVAS.width} = {(SAFE_PX.full.width / CANVAS.width).toFixed(4)} (60.39% width)</span>
              <span class="text-ink-950 font-bold block">{SAFE_PX.full.height} / {CANVAS.height} = {(SAFE_PX.full.height / CANVAS.height).toFixed(4)} (29.38% height)</span>
            </div>
          </div>
          <p class="text-xs text-ink-600 leading-relaxed measure-prose">
            Both sets of coordinates correspond to the central 60.3% × 29.3% portion of the canvas. Because YouTube scales banners dynamically, designing on a {CANVAS.width} × {CANVAS.height} canvas with a {SAFE_PX.full.width} × {SAFE_PX.full.height} safe area ensures your artwork scales cleanly on high-density Retina and 4K screens.
          </p>
          <div class="pt-1">
            <a
              href="/guides/youtube-banner-safe-area"
              class="inline-flex items-center text-xs font-semibold text-accent hover:text-accent-hover transition-colors underline gap-1"
            >
              Read our dedicated Safe Area Guide with worked proofs and visual diagrams →
            </a>
          </div>
        </div>

        <!-- 1024x576 vs 2048x1152 Analysis -->
        <div class="p-5 rounded-xl border border-line-200 bg-surface-50/50 space-y-3 mt-4">
          <h3 class="text-sm font-semibold text-ink-950">
            Why 1024×576 Banners Get Rejected (The 16:9 Aspect Misconception)
          </h3>
          <p class="text-xs text-ink-600 leading-relaxed measure-prose">
            A common search term among new creators is <strong>"1024x576 youtube banner"</strong>. Mathematically, 1024 ÷ 576 equals 1.777&hellip; (an exact 16:9 widescreen ratio). However, attempting to upload a 1024×576 pixel banner directly to YouTube Studio will fail immediately with the error: <em>"Image is too small. It must be at least 2048 x 1152 pixels."</em>
          </p>
          <p class="text-xs text-ink-600 leading-relaxed measure-prose">
            YouTube enforces <strong>2048 × 1152 px as its absolute floor</strong> so that banners have sufficient pixel data when rendered across larger tablet and laptop viewports. If you have artwork created at 1024×576 px, do not attempt to force-upload it. Open our free <a href="/tools/youtube-banner-resizer" class="text-accent underline font-semibold">YouTube Banner Resizer</a> to upscale and mathematically center your focal points onto the full 2560 × 1440 canvas before uploading.
          </p>
        </div>
      </section>

      <!-- Section 5: Server-Side Re-encoding -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            05 · Image Processing Reality
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            YouTube Server-Side Re-Encoding & Compression
          </h2>
        </div>
        <p class="text-sm text-ink-600 leading-relaxed measure-prose">
          Many creators spend hours fine-tuning export settings in Photoshop or Canva, only to discover that their uploaded banner appears soft or lacks crispness on desktop displays.
        </p>
        <p class="text-sm text-ink-600 leading-relaxed measure-prose">
          This behavior is expected and occurs because <strong>YouTube automatically re-encodes all uploaded images server-side</strong>. YouTube does not serve your raw uploaded file to viewers. Instead, YouTube's CDN generates responsive WebP and JPEG derivatives tailored to viewer connection speeds and screen widths:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl border border-line-200 bg-surface-50 space-y-2">
            <h3 class="text-sm font-semibold text-ink-950">The ~{desktopBudgetKb} KB Desktop Budget</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              Measurements of desktop banner slices (<code class="font-mono text-ink-800">w1707</code>) reveal that YouTube re-compresses artwork down to approximately {desktopBudgetKb} KB. Highly complex imagery with fine film grain or detailed noise patterns will be aggressively smoothed.
            </p>
          </div>
          <div class="p-5 rounded-xl border border-line-200 bg-surface-50 space-y-2">
            <h3 class="text-sm font-semibold text-ink-950">Gradient Softening</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              Subtle, low-contrast pastel gradients frequently exhibit visible color banding after YouTube's quantization pass. To minimize visible artifacts, use higher color contrast, distinct silhouettes, and solid typography.
            </p>
          </div>
        </div>
        <p class="text-xs text-ink-500 leading-relaxed measure-prose">
          Note: No local export setting or third-party tool can bypass YouTube's server-side re-encoding. Previewing your artwork against approximate re-encode budgets before publishing helps you spot compression vulnerabilities before going live.
        </p>
      </section>

      <!-- Section 6: FAQ Section -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            06 · Frequently Asked Questions
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            Frequently Asked Questions About YouTube Banner Sizes
          </h2>
        </div>

        <div class="space-y-3">
          {
            faqs.map((faq, index) => (
              <details
                class="group rounded-xl border border-line-200 bg-surface-0 open:border-line-200 transition-colors"
                id={`faq-${index}`}
              >
                <summary class="flex items-center justify-between p-4 min-h-[44px] text-xs font-semibold text-ink-950 cursor-pointer select-none list-none group-hover:text-accent transition-colors">
                  <span>{faq.question}</span>
                  <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-line-200 text-ink-600 group-open:rotate-180 transition-transform text-xs" aria-hidden="true">
                    ▾
                  </span>
                </summary>
                <div
                  class="px-4 pb-4 text-xs text-ink-600 leading-relaxed measure-prose border-t border-line-100 pt-3"
                >
                  <div>
                    {faq.answer}
                  </div>
                </div>
              </details>
            ))
          }
        </div>
      </section>

      <!-- Section 7: High-Contrast Contextual CTA Card -->
      <section class="rounded-lg bg-ink-950 text-surface-0 p-6 sm:p-10 border border-ink-800 space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent-light">
            Free Creator Utilities · 100% In-Browser Execution
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-surface-0">
            Test or Resize Your Channel Art Before Uploading
          </h2>
          <p class="text-sm text-line-200 leading-relaxed measure-prose">
            Don't guess what YouTube will cut. Use our free, browser-first tools to verify your safe-area crops or reposition an existing image to fit the exact {CANVAS.width} × {CANVAS.height} canvas.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 pt-2">
          <a
            href="/tools/youtube-banner-resizer"
