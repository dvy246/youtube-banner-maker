---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getBreadcrumbSchema, getOrganizationSchema } from '../../lib/seo';
import { CANVAS, SAFE_PX } from '../../lib/spec';
import {
  TARGET_LOCALES,
  getStaticPageSeo,
  getTranslations,
  getLocalizedUrl,
  type Locale,
} from '../../i18n';

export async function getStaticPaths() {
  return TARGET_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const path = `/${locale}/about`;
const seo = getStaticPageSeo('/about', locale);
const dict = getTranslations(locale);

const jsonLd = [
  getOrganizationSchema(),
  getBreadcrumbSchema([
    { name: dict.nav.sizeGuide ? 'Home' : 'Home', url: getLocalizedUrl('/', locale) },
    { name: dict.about.title, url: path },
  ]),
];
---

<BaseLayout
  title={seo.title}
  description={seo.desc}
  path={path}
  locale={locale}
  jsonLd={jsonLd}
>
  <Header currentPath={path} locale={locale} />

  <main id="main-content" class="flex-1">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
      
      <!-- Hero / Header -->
      <header class="space-y-4 border-b border-line-200 pb-10">
        <nav aria-label="Breadcrumb" class="text-xs font-mono text-ink-500 flex items-center gap-2">
          <a href={getLocalizedUrl('/', locale)} class="hover:text-ink-950 transition-colors">Home</a>
          <span class="text-line-200">/</span>
          <span class="text-ink-800 font-medium">{dict.about.title}</span>
        </nav>
        <span class="inline-block text-xs font-mono uppercase tracking-wider font-semibold text-accent">
          {dict.about.valuesTitle}
        </span>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink-950">
          {dict.about.title}
        </h1>
        <p class="text-base sm:text-lg text-ink-600 leading-relaxed measure-prose">
          {dict.about.subtitle}
        </p>
      </header>

      <!-- Mission Section -->
      <section class="space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            01 · {dict.about.missionTitle}
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            {dict.about.missionTitle}
          </h2>
        </div>
        <p class="text-sm text-ink-600 leading-relaxed measure-prose">
          {dict.about.missionP1}
        </p>
        <p class="text-sm text-ink-600 leading-relaxed measure-prose">
          {dict.about.missionP2}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-5 rounded-lg border border-line-200 bg-surface-50 space-y-2">
            <h3 class="text-sm font-semibold text-ink-950">{dict.about.val1Title}</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              {dict.about.val1Desc}
            </p>
          </div>
          <div class="p-5 rounded-lg border border-line-200 bg-surface-50 space-y-2">
            <h3 class="text-sm font-semibold text-ink-950">{dict.about.val2Title}</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              {dict.about.val2Desc}
            </p>
          </div>
          <div class="p-5 rounded-lg border border-line-200 bg-surface-50 space-y-2">
            <h3 class="text-sm font-semibold text-ink-950">{dict.about.val3Title}</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              {dict.about.val3Desc}
            </p>
          </div>
          <div class="p-5 rounded-lg border border-line-200 bg-surface-50 space-y-2">
            <h3 class="text-sm font-semibold text-ink-950">{dict.common.privacyBadge}</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              {dict.footer.zeroTransmitted}
            </p>
          </div>
        </div>
      </section>

      <!-- Technical Architecture Section -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            02 · {dict.about.val1Title}
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            {dict.about.val1Title}
          </h2>
        </div>
        <div class="p-5 rounded-lg border border-line-200 bg-surface-50 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-xs">
            <div class="p-3 bg-surface-0 border border-line-200 rounded">
              <span class="text-ink-500 font-mono block">{dict.guideSize.fullCanvas}</span>
              <span class="font-mono text-sm font-semibold text-ink-950">{CANVAS.width} × {CANVAS.height} px</span>
              <span class="text-[11px] text-ink-500 block mt-0.5">16:9 TV</span>
            </div>
            <div class="p-3 bg-surface-0 border border-line-200 rounded">
              <span class="text-ink-500 font-mono block">{dict.guideSize.safeArea}</span>
              <span class="font-mono text-sm font-semibold text-ink-950">{SAFE_PX.full.width} × {SAFE_PX.full.height} px</span>
              <span class="text-[11px] text-ink-500 block mt-0.5">{dict.footer.specSafeArea}</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Leadership Section -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            03 · Leadership
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            YTBannerStudio Editorial & Engineering Team
          </h2>
        </div>
        <div class="p-6 rounded-xl border border-line-200 bg-surface-50/50 flex flex-col sm:flex-row items-start sm:items-center gap-5">
          <div class="w-14 h-14 rounded-full bg-ink-950 text-surface-0 font-bold text-lg flex items-center justify-center shrink-0">
            YT
          </div>
          <div class="space-y-1.5 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
              <h3 class="text-base font-bold text-ink-950">YTBannerStudio Editorial & Engineering Team</h3>
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-surface-100 text-ink-600 border border-line-200">
                Video Operations & Creator Tooling Collective
              </span>
            </div>
            <p class="text-xs text-ink-600 leading-relaxed measure-prose">
              A collective of video operations specialists, channel designers, and open-web developers dedicated to client-side graphic algorithms, YouTube safe-area research, and privacy-first creator tooling.
            </p>
            <div class="pt-1">
              <a
                href="https://github.com/dvy246/youtube-banner-maker"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-mono font-semibold text-accent hover:underline inline-flex items-center gap-1"
              >
                <span>github.com/dvy246/youtube-banner-maker</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Legal & Trademark Disclaimer Section -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            04 · {dict.terms.disclaimerTitle}
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            {dict.terms.disclaimerTitle}
          </h2>
        </div>
        <div class="p-4 rounded-lg bg-surface-50 border border-line-200 text-xs text-ink-600 space-y-2 measure-prose">
          <p>
            {dict.terms.disclaimerP1}
          </p>
          <p>
            {dict.terms.liabilityP1}
          </p>
        </div>
      </section>

    </div>
  </main>

  <Footer currentPath={path} locale={locale} />
</BaseLayout>
