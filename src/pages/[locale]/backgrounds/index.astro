---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { getBreadcrumbSchema, getCollectionPageSchema } from "../../../lib/seo";
import { AESTHETIC_BACKGROUNDS, AESTHETIC_CATEGORIES } from "../../../data/backgrounds";
import { CANVAS, SAFE, SAFE_PX } from "../../../lib/spec";
import {
  TARGET_LOCALES,
  getStaticPageSeo,
  getTranslations,
  getLocalizedUrl,
  type Locale,
} from "../../../i18n";

const mobileCropWidth = SAFE_PX.full.width;
const mobileCropHeight = SAFE_PX.full.height;
const desktopCropHeight = SAFE_PX.full.height;

export async function getStaticPaths() {
  return TARGET_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const path = `/${locale}/backgrounds`;
const seo = getStaticPageSeo("/backgrounds", locale);
const dict = getTranslations(locale);
const t = dict.backgroundsPage;

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: getLocalizedUrl("/", locale) },
  { name: dict.nav.backgrounds, url: path },
]);

const collectionSchema = getCollectionPageSchema({
  name: seo.title,
  description: seo.desc,
  path: path,
  items: AESTHETIC_BACKGROUNDS.map((b) => ({
    name: b.name,
    url: `${getLocalizedUrl("/tools/youtube-banner-maker", locale)}?bgId=${b.id}`,
    image: b.src,
  })),
});

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: t.faq1Q,
      acceptedAnswer: {
        "@type": "Answer",
        text: t.faq1A,
      },
    },
    {
      "@type": "Question",
      name: t.faq2Q,
      acceptedAnswer: {
        "@type": "Answer",
        text: t.faq2A,
      },
    },
    {
      "@type": "Question",
      name: t.faq3Q,
      acceptedAnswer: {
        "@type": "Answer",
        text: t.faq3A,
      },
    },
    {
      "@type": "Question",
      name: t.faq4Q,
      acceptedAnswer: {
        "@type": "Answer",
        text: t.faq4A,
      },
    },
  ],
};

const safeLeftPct = (SAFE.x * 100).toFixed(2);
const safeTopPct = (SAFE.y * 100).toFixed(2);
const safeWidthPct = (SAFE.w * 100).toFixed(2);
const safeHeightPct = (SAFE.h * 100).toFixed(2);

const categoryLabels: Record<string, string> = {
  all: t.allCategories,
  ghibli: 'Studio Ghibli',
  sky: t.catSky,
  floral: t.catFloral,
  boho: t.catBoho,
  anime: t.catAnime,
  zen: t.catZen,
};
---

<BaseLayout
  title={seo.title}
  description={seo.desc}
  path={path}
  locale={locale}
  jsonLd={[breadcrumbs, collectionSchema, faqSchema]}
>
  <Header currentPath={path} locale={locale} />

  <main id="main-content" class="flex-1">
    <!-- Hero Section -->
    <section class="border-b border-line-200 bg-surface-0 py-12 sm:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-50 border border-line-200 text-xs font-medium text-ink-600 mb-4">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            {t.badge}
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-ink-950 tracking-tight leading-[1.12]">
            {t.title}
          </h1>
          <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed">
            {t.desc}
          </p>
        </div>

        <!-- Controls Toolbar: Search & Global Safe Area Overlay Toggle -->
        <div class="mt-8 pt-6 border-t border-line-100 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
          <!-- Search input -->
          <div class="relative flex-1 max-w-md">
            <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="bg-search-input"
              placeholder={t.searchPlaceholder}
              class="w-full h-11 pl-10 pr-4 rounded-full bg-surface-50 border border-line-200 text-sm text-ink-950 placeholder-ink-400 focus:outline-hidden focus:ring-2 focus:ring-accent focus:border-accent transition-all"
            />
          </div>

          <!-- Safe Area Preview Toggle Button -->
          <button
            type="button"
            id="global-safe-toggle-btn"
            class="inline-flex items-center justify-center gap-2 h-11 px-5 rounded-full border border-line-200 bg-surface-50 hover:bg-surface-100 text-xs sm:text-sm font-medium text-ink-700 hover:text-ink-950 cursor-pointer transition-all active:scale-[0.98]"
            aria-pressed="false"
          >
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="3" y="3" width="18" height="18" rx="2" stroke-width="2" />
              <rect x="6" y="8" width="12" height="8" rx="1" stroke-width="2" stroke-dasharray="2 2" />
            </svg>
            <span>{t.safeAreaToggle}</span>
          </button>
        </div>

        <!-- Category Filter Chips -->
        <div class="mt-4 flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" id="bg-category-filters" role="tablist">
          {
            AESTHETIC_CATEGORIES.map((cat, idx) => (
              <button
                type="button"
                role="tab"
                data-category={cat.id}
                aria-selected={idx === 0 ? "true" : "false"}
                class:list={[
                  "category-chip whitespace-nowrap px-4 py-2 rounded-full text-xs font-medium cursor-pointer transition-all active:scale-[0.98]",
                  idx === 0
                    ? "bg-ink-950 text-surface-0 shadow-xs"
                    : "bg-surface-50 hover:bg-surface-100 text-ink-600 border border-line-200",
                ]}
              >
                {categoryLabels[cat.id] || cat.label}
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Backgrounds Gallery Grid -->
    <section class="py-12 sm:py-16 bg-surface-50 border-b border-line-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-6">
          <p class="text-xs sm:text-sm font-medium text-ink-600" id="bg-count-label">
            {AESTHETIC_BACKGROUNDS.length} {t.allCategories}
          </p>
          <div class="text-[11px] text-ink-400 font-mono">
            2560 × 1440 px • SVG Vector
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="bg-grid">
          {
            AESTHETIC_BACKGROUNDS.map((bg) => (
              <article
                class="bg-card group rounded-2xl border border-line-200 bg-surface-0 overflow-hidden shadow-xs hover:shadow-md transition-all flex flex-col"
                data-category={bg.category}
                data-tags={bg.tags.join(" ")}
                data-name={bg.name.toLowerCase()}
              >
                <!-- 16:9 Banner Preview Container -->
                <div class="relative aspect-video w-full bg-ink-950 overflow-hidden border-b border-line-100">
                  <img
                    src={bg.src}
                    alt={bg.name}
                    class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
                    loading="lazy"
                  />

                  <!-- Safe Area Overlay -->
                  <div
                    class="safe-overlay absolute inset-0 pointer-events-none transition-opacity duration-200 opacity-0"
                    aria-hidden="true"
                  >
                    <div
                      class="absolute border-2 border-dashed border-accent bg-accent/10 rounded-xs flex items-start justify-end p-1"
                      style={`left: ${safeLeftPct}%; top: ${safeTopPct}%; width: ${safeWidthPct}%; height: ${safeHeightPct}%;`}
                    >
                      <span class="text-[9px] font-mono bg-accent text-white px-1.5 py-0.5 rounded-xs font-semibold">
                        Safe Area
                      </span>
                    </div>
                  </div>

                  <!-- Category Tag Badge -->
                  <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-black/70 backdrop-blur-xs text-[10px] font-medium text-white shadow-xs">
                    {categoryLabels[bg.category] || bg.categoryLabel}
                  </span>

                  <!-- Resolution Badge -->
                  <span class="absolute top-3 right-3 px-2 py-0.5 rounded-md bg-black/70 backdrop-blur-xs text-[10px] font-mono text-zinc-300">
                    2560×1440
                  </span>
                </div>

                <!-- Card Body -->
                <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                  <div>
                    <h2 class="text-base font-semibold text-ink-950 tracking-tight group-hover:text-accent transition-colors">
                      {bg.name}
                    </h2>
                    <p class="mt-1 text-xs text-ink-600 line-clamp-2 leading-relaxed">
                      {bg.description}
                    </p>
                  </div>

                  <!-- Action Buttons -->
                  <div class="grid grid-cols-2 gap-2 pt-1">
                    <a
                      href={`${getLocalizedUrl("/tools/youtube-banner-maker", locale)}?bgId=${bg.id}`}
                      class="h-9 px-3 rounded-full bg-accent hover:bg-accent-600 text-white text-xs font-medium inline-flex items-center justify-center gap-1.5 transition-all shadow-xs active:scale-[0.98]"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                      </svg>
                      <span>{t.customizeBtn}</span>
                    </a>

                    <!-- Split Multi-Size Download Pill -->
                    <div class="relative download-group inline-flex w-full">
                      <button
                        type="button"
                        class="btn-quick-download flex-1 h-9 pl-2.5 pr-1.5 rounded-l-full border border-r-0 border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-700 hover:text-ink-950 text-xs font-medium inline-flex items-center justify-center gap-1 transition-all active:scale-[0.98] cursor-pointer"
                        data-src={bg.src}
                        data-id={bg.id}
                        data-w={CANVAS.width}
                        data-h={CANVAS.height}
                        data-crop="false"
                        title="Download 2560 × 1440"
                      >
                        <svg class="w-3.5 h-3.5 text-ink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        <span>{t.downloadBtn}</span>
                      </button>
                      <button
                        type="button"
                        class="btn-toggle-sizes h-9 px-2 rounded-r-full border border-line-200 bg-surface-50 hover:bg-surface-100 text-ink-500 hover:text-ink-950 text-xs font-medium inline-flex items-center justify-center transition-all active:scale-[0.98] cursor-pointer"
                        aria-expanded="false"
                        aria-haspopup="true"
                        title="Choose custom download size (4K, 1080p, Safe Area Crops)"
                      >
                        <svg class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                      </button>

                      <!-- Floating Dropdown Menu -->
                      <div class="download-dropdown-menu hidden absolute right-0 bottom-full mb-1.5 w-56 p-1.5 bg-surface-0 rounded-2xl shadow-xl border border-line-200 z-30 text-left">
                        <div class="px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-ink-400">Standard Sizes</div>
                        <button
                          type="button"
                          class="btn-download-size w-full px-2.5 py-1.5 rounded-xl hover:bg-surface-100 flex items-center justify-between text-xs text-ink-800 transition-colors cursor-pointer"
                          data-src={bg.src}
                          data-id={bg.id}
                          data-w={CANVAS.width}
                          data-h={CANVAS.height}
                          data-crop="false"
                        >
                          <span class="font-medium">YouTube Banner (2K)</span>
                          <span class="text-[10px] font-mono text-ink-500">{CANVAS.width} × {CANVAS.height}</span>
                        </button>
                        <button
                          type="button"
                          class="btn-download-size w-full px-2.5 py-1.5 rounded-xl hover:bg-surface-100 flex items-center justify-between text-xs text-ink-800 transition-colors cursor-pointer"
                          data-src={bg.src}
                          data-id={bg.id}
                          data-w="3840"
                          data-h="2160"
                          data-crop="false"
                        >
                          <span class="font-medium">Ultra HD 4K (Wallpaper)</span>
                          <span class="text-[10px] font-mono text-ink-500">3840 × 2160</span>
                        </button>
                        <button
                          type="button"
                          class="btn-download-size w-full px-2.5 py-1.5 rounded-xl hover:bg-surface-100 flex items-center justify-between text-xs text-ink-800 transition-colors cursor-pointer"
                          data-src={bg.src}
                          data-id={bg.id}
                          data-w="1920"
                          data-h="1080"
                          data-crop="false"
                        >
                          <span class="font-medium">YouTube Thumbnail (1080p)</span>
                          <span class="text-[10px] font-mono text-ink-500">1920 × 1080</span>
                        </button>
                        <div class="my-1 border-t border-line-100"></div>
                        <div class="px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-ink-400">Safe Area Crops</div>
                        <button
                          type="button"
                          class="btn-download-size w-full px-2.5 py-1.5 rounded-xl hover:bg-surface-100 flex items-center justify-between text-xs text-ink-800 transition-colors cursor-pointer"
                          data-src={bg.src}
                          data-id={bg.id}
                          data-w={CANVAS.width}
                          data-h={desktopCropHeight}
                          data-crop="desktop"
                        >
                          <span class="font-medium">Desktop Viewport</span>
                          <span class="text-[10px] font-mono text-ink-500">{CANVAS.width} × {desktopCropHeight}</span>
                        </button>
                        <button
                          type="button"
                          class="btn-download-size w-full px-2.5 py-1.5 rounded-xl hover:bg-surface-100 flex items-center justify-between text-xs text-ink-800 transition-colors cursor-pointer"
                          data-src={bg.src}
                          data-id={bg.id}
                          data-w={mobileCropWidth}
                          data-h={mobileCropHeight}
                          data-crop="mobile"
                        >
                          <span class="font-medium">Mobile Safe Zone</span>
                          <span class="text-[10px] font-mono text-ink-500">{mobileCropWidth} × {mobileCropHeight}</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 sm:py-20 bg-surface-0 border-b border-line-200">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl sm:text-2xl font-semibold text-ink-950 tracking-tight mb-8">
          {t.faqTitle}
        </h2>

        <div class="space-y-6">
          <div class="border-b border-line-200 pb-5">
            <h3 class="text-base font-medium text-ink-950">{t.faq1Q}</h3>
            <p class="mt-2 text-sm text-ink-600 leading-relaxed">{t.faq1A}</p>
          </div>
          <div class="border-b border-line-200 pb-5">
            <h3 class="text-base font-medium text-ink-950">{t.faq2Q}</h3>
            <p class="mt-2 text-sm text-ink-600 leading-relaxed">{t.faq2A}</p>
          </div>
          <div class="border-b border-line-200 pb-5">
            <h3 class="text-base font-medium text-ink-950">{t.faq3Q}</h3>
            <p class="mt-2 text-sm text-ink-600 leading-relaxed">{t.faq3A}</p>
          </div>
          <div class="border-b border-line-200 pb-5">
            <h3 class="text-base font-medium text-ink-950">{t.faq4Q}</h3>
            <p class="mt-2 text-sm text-ink-600 leading-relaxed">{t.faq4A}</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer currentPath={path} locale={locale} />
</BaseLayout>

<script>
  function initBackgroundsHub() {
    const searchInput = document.getElementById("bg-search-input") as HTMLInputElement | null;
    const categoryChips = document.querySelectorAll<HTMLButtonElement>(".category-chip");
    const cards = document.querySelectorAll<HTMLElement>(".bg-card");
    const countLabel = document.getElementById("bg-count-label");
    const safeToggleBtn = document.getElementById("global-safe-toggle-btn");
    const safeOverlays = document.querySelectorAll<HTMLElement>(".safe-overlay");

    let activeCategory = "all";
    let searchQuery = "";
    let isSafeActive = false;

    function updateGallery() {
      let visibleCount = 0;
      cards.forEach((card) => {
        const cat = card.getAttribute("data-category") || "";
        const tags = card.getAttribute("data-tags") || "";
        const name = card.getAttribute("data-name") || "";

        const matchesCat = activeCategory === "all" || cat === activeCategory;
        const matchesSearch = !searchQuery || name.includes(searchQuery) || tags.includes(searchQuery);

        if (matchesCat && matchesSearch) {
          card.classList.remove("hidden");
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      if (countLabel) {
        countLabel.textContent = `${visibleCount} items`;
      }
    }

    searchInput?.addEventListener("input", () => {
      searchQuery = (searchInput.value || "").trim().toLowerCase();
      updateGallery();
    });

    categoryChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        categoryChips.forEach((c) => {
          c.classList.remove("bg-ink-950", "text-surface-0", "shadow-xs");
          c.classList.add("bg-surface-50", "text-ink-600", "border", "border-line-200");
          c.setAttribute("aria-selected", "false");
        });
        chip.classList.remove("bg-surface-50", "text-ink-600", "border", "border-line-200");
        chip.classList.add("bg-ink-950", "text-surface-0", "shadow-xs");
        chip.setAttribute("aria-selected", "true");

        activeCategory = chip.getAttribute("data-category") || "all";
        updateGallery();
      });
    });

    safeToggleBtn?.addEventListener("click", () => {
      isSafeActive = !isSafeActive;
      safeToggleBtn.setAttribute("aria-pressed", isSafeActive ? "true" : "false");
      if (isSafeActive) {
        safeToggleBtn.classList.add("bg-accent/10", "border-accent", "text-accent");
      } else {
        safeToggleBtn.classList.remove("bg-accent/10", "border-accent", "text-accent");
      }

      safeOverlays.forEach((overlay) => {
        if (isSafeActive) {
          overlay.classList.remove("opacity-0");
          overlay.classList.add("opacity-100");
        } else {
          overlay.classList.remove("opacity-100");
          overlay.classList.add("opacity-0");
        }
      });
    });

    // Multi-Size Download Engine & Dropdown Controller
    const downloadGroups = document.querySelectorAll<HTMLElement>('.download-group');

    function closeAllDropdowns() {
      document.querySelectorAll<HTMLElement>('.download-dropdown-menu').forEach((m) => {
        m.classList.add('hidden');
      });
      document.querySelectorAll<HTMLButtonElement>('.btn-toggle-sizes').forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
      });
    }

    downloadGroups.forEach((group) => {
      const toggleBtn = group.querySelector<HTMLButtonElement>('.btn-toggle-sizes');
      const menu = group.querySelector<HTMLElement>('.download-dropdown-menu');
      const quickBtn = group.querySelector<HTMLButtonElement>('.btn-quick-download');
      const sizeBtns = group.querySelectorAll<HTMLButtonElement>('.btn-download-size');

      toggleBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = menu?.classList.contains('hidden');
        closeAllDropdowns();
        if (isHidden) {
          menu?.classList.remove('hidden');
          toggleBtn.setAttribute('aria-expanded', 'true');
        }
      });

      quickBtn?.addEventListener('click', () => {
        const src = quickBtn.getAttribute('data-src') || '';
        const id = quickBtn.getAttribute('data-id') || 'background';
        const w = parseInt(quickBtn.getAttribute('data-w') || '2560', 10);
        const h = parseInt(quickBtn.getAttribute('data-h') || '1440', 10);
        const crop = quickBtn.getAttribute('data-crop') || 'false';
        downloadBackground(src, id, w, h, crop, quickBtn);
      });

      sizeBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          closeAllDropdowns();
          const src = btn.getAttribute('data-src') || '';
          const id = btn.getAttribute('data-id') || 'background';
          const w = parseInt(btn.getAttribute('data-w') || '2560', 10);
          const h = parseInt(btn.getAttribute('data-h') || '1440', 10);
          const crop = btn.getAttribute('data-crop') || 'false';
          downloadBackground(src, id, w, h, crop, btn);
        });
      });
    });

    document.addEventListener('click', () => {
      closeAllDropdowns();
    });

    async function downloadBackground(
      src: string,
      filenameBase: string,
      targetW: number,
      targetH: number,
      cropType: string,
      triggerElement?: HTMLElement
    ) {
      if (triggerElement) {
        triggerElement.style.opacity = '0.6';
      }

      try {
        const img = new Image();
        img.crossOrigin = 'anonymous';

        await new Promise<void>((resolve, reject) => {
          img.onload = () => resolve();
          img.onerror = () => reject(new Error('Image failed to load'));
          img.src = src;
        });

        const canvas = document.createElement('canvas');
        canvas.width = targetW;
        canvas.height = targetH;
        const ctx = canvas.getContext('2d');
        if (!ctx) throw new Error('Canvas 2D unsupported');

        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = 'high';

        const natW = img.naturalWidth || 2560;
        const natH = img.naturalHeight || 1440;

        if (cropType === 'desktop') {
          const srcH = (targetH / 1440) * natH;
          const srcY = (natH - srcH) / 2;
          ctx.drawImage(img, 0, srcY, natW, srcH, 0, 0, targetW, targetH);
        } else if (cropType === 'mobile') {
          const srcW = (targetW / 2560) * natW;
          const srcH = (targetH / 1440) * natH;
          const srcX = (natW - srcW) / 2;
          const srcY = (natH - srcH) / 2;
          ctx.drawImage(img, srcX, srcY, srcW, srcH, 0, 0, targetW, targetH);
        } else {
          ctx.drawImage(img, 0, 0, natW, natH, 0, 0, targetW, targetH);
        }

        const isJpeg = src.endsWith('.jpg') || src.endsWith('.jpeg');
        const mime = isJpeg ? 'image/jpeg' : 'image/png';
        const ext = isJpeg ? 'jpg' : 'png';
        const dataUrl = canvas.toDataURL(mime, 0.95);

        const a = document.createElement('a');
        a.href = dataUrl;
        a.download = `${filenameBase}-${targetW}x${targetH}.${ext}`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      } catch (err) {
        const a = document.createElement('a');
        a.href = src;
        a.download = `${filenameBase}.jpg`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      } finally {
        if (triggerElement) {
          triggerElement.style.opacity = '1';
        }
      }
    }
  }

  initBackgroundsHub();
  document.addEventListener("astro:after-swap", initBackgroundsHub);
</script>
