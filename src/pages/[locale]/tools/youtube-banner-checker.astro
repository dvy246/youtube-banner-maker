---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToolShell from '../../../components/ToolShell.astro';
import SpecTable from '../../../components/SpecTable.astro';
import DeviceCropTable from '../../../components/DeviceCropTable.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import {
  getSoftwareAppSchema,
  getBreadcrumbSchema,
} from '../../../lib/seo';
import { CANVAS, SAFE_PX } from '../../../lib/spec';
import {
  TARGET_LOCALES,
  getStaticPageSeo,
  getTranslations,
  getLocalizedUrl,
  type Locale,
} from '../../../i18n';

export async function getStaticPaths() {
  return TARGET_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const path = `/${locale}/tools/youtube-banner-checker`;
const seo = getStaticPageSeo('/tools/youtube-banner-checker', locale);
const dict = getTranslations(locale);

const jsonLd = [
  getSoftwareAppSchema(
    dict.tools.checker.title,
    seo.desc,
    path
  ),
  getBreadcrumbSchema([
    { name: 'Home', url: getLocalizedUrl('/', locale) },
    { name: dict.tools.checker.title, url: path },
  ]),
];
---

<BaseLayout
  title={seo.title}
  description={seo.desc}
  path={path}
  locale={locale}
  jsonLd={jsonLd}
>
  <Header currentPath={path} locale={locale} />

  <main id="main-content" class="flex-1">
    <!-- Primary Tool Island Mounting Shell -->
    <ToolShell
      mode="check"
      title={dict.tools.checker.title}
      intro={dict.tools.checker.intro}
      showControls={false}
      showExport={false}
      locale={locale}
    />

    <!-- Comprehensive Explanatory Content & Supporting Specs -->
    <section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-24 border-t border-line-200 space-y-20 lg:space-y-28">
      <!-- Section 1: How the Diagnostic Works -->
      <div class="space-y-8">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono font-medium text-accent bg-accent/8 border border-accent/20">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span>Automated Diagnostics</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-ink-950">
            {dict.tools.checker.title}
          </h2>
          <p class="text-base sm:text-lg text-ink-600 leading-relaxed max-w-3xl">
            {dict.tools.checker.intro}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Card 1: Safe Area Detection -->
          <div class="group p-6 sm:p-7 rounded-2xl border border-line-200 bg-surface-0 shadow-2xs hover:shadow-raised hover:border-ink-400/30 transition-all duration-200 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="w-11 h-11 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="22" y1="12" x2="18" y2="12"></line>
                  <line x1="6" y1="12" x2="2" y2="12"></line>
                  <line x1="12" y1="6" x2="12" y2="2"></line>
                  <line x1="12" y1="22" x2="12" y2="18"></line>
                </svg>
              </div>
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <h3 class="text-base sm:text-lg font-semibold text-ink-950">Boundary Detection</h3>
                  <span class="text-[10px] font-mono font-medium text-ink-600 uppercase px-2 py-0.5 rounded bg-surface-100 border border-line-200">{SAFE_PX.full.width} × {SAFE_PX.full.height}</span>
                </div>
                <p class="text-sm text-ink-600 leading-relaxed">
                  Evaluates whether logos, titles, and focal artwork stay securely within the centered mobile safe viewport, calculating exact boundaries against YouTube's {CANVAS.width} × {CANVAS.height} px canvas.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-line-100 text-xs font-mono text-ink-500">
              Real-time boundary collision audit
            </div>
          </div>

          <!-- Card 2: Resolution & Ratio -->
          <div class="group p-6 sm:p-7 rounded-2xl border border-line-200 bg-surface-0 shadow-2xs hover:shadow-raised hover:border-ink-400/30 transition-all duration-200 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="w-11 h-11 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                  <line x1="8" y1="21" x2="16" y2="21"></line>
                  <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
              </div>
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <h3 class="text-base sm:text-lg font-semibold text-ink-950">Resolution & Ratio</h3>
                  <span class="text-[10px] font-mono font-medium text-ink-600 uppercase px-2 py-0.5 rounded bg-surface-100 border border-line-200">2048 × 1152 Floor</span>
                </div>
                <p class="text-sm text-ink-600 leading-relaxed">
                  Assesses source dimensions against YouTube's 2048 × 1152 px minimum threshold to flag potential pixelation risks on smart TV and 4K displays.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-line-100 text-xs font-mono text-ink-500">
              Optical density verification
            </div>
          </div>

          <!-- Card 3: File Weight -->
          <div class="group p-6 sm:p-7 rounded-2xl border border-line-200 bg-surface-0 shadow-2xs hover:shadow-raised hover:border-ink-400/30 transition-all duration-200 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="w-11 h-11 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
              </div>
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <h3 class="text-base sm:text-lg font-semibold text-ink-950">File Weight</h3>
                  <span class="text-[10px] font-mono font-medium text-ink-600 uppercase px-2 py-0.5 rounded bg-surface-100 border border-line-200">6 MB Ceiling</span>
                </div>
                <p class="text-sm text-ink-600 leading-relaxed">
                  Checks file size against Google's strict 6 MB ceiling before you attempt to upload to YouTube Studio, preventing upload failures.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-line-100 text-xs font-mono text-ink-500">
              Verified against Studio upload limits
            </div>
          </div>
        </div>
      </div>

      <!-- Section 2: 3 Most Common YouTube Crop Pitfalls -->
      <div class="border-t border-line-200 pt-16 sm:pt-20 space-y-8">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono font-medium text-accent bg-accent/8 border border-accent/20">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span>Common Pitfalls</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-ink-950">
            Common YouTube Banner Crop Mistakes
          </h2>
          <p class="text-base sm:text-lg text-ink-600 leading-relaxed max-w-3xl">
            Most creators only discover channel art crop errors after publishing. Here are the three issues our automated checker catches:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 sm:p-7 rounded-2xl border border-line-200 bg-surface-0 space-y-4 shadow-2xs hover:shadow-raised hover:border-ink-400/30 transition-all duration-200 flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-bold bg-danger/10 text-danger border border-danger/20">
                  01 / High Risk
                </span>
                <span class="text-xs font-mono text-ink-400">Mobile Devices</span>
              </div>
              <h3 class="text-lg font-semibold text-ink-950">
                Mobile Safe Area Cutoff
              </h3>
              <p class="text-sm text-ink-600 leading-relaxed">
                Mobile screens display only the central safe rectangle. Placing logos, social handles, or text outside this middle zone results in immediate clipping on phones and mobile apps.
              </p>
            </div>
            <div class="pt-3 border-t border-line-100 text-xs font-mono text-danger">
              Affects ~70% of viewers
            </div>
          </div>

          <div class="p-6 sm:p-7 rounded-2xl border border-line-200 bg-surface-0 space-y-4 shadow-2xs hover:shadow-raised hover:border-ink-400/30 transition-all duration-200 flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-bold bg-warning/10 text-warning border border-warning/20">
                  02 / Frequent Trap
                </span>
                <span class="text-xs font-mono text-ink-400">Desktop Web</span>
              </div>
              <h3 class="text-lg font-semibold text-ink-950">
                Desktop Horizontal Compression
              </h3>
              <p class="text-sm text-ink-600 leading-relaxed">
                Desktop browsers show a wide horizontal banner, trimming roughly 35% from both top and bottom edges. Graphics or headlines positioned along vertical borders get cropped out on laptops.
              </p>
            </div>
            <div class="pt-3 border-t border-line-100 text-xs font-mono text-warning">
              Vertical margins discarded
            </div>
          </div>

          <div class="p-6 sm:p-7 rounded-2xl border border-line-200 bg-surface-0 space-y-4 shadow-2xs hover:shadow-raised hover:border-ink-400/30 transition-all duration-200 flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-bold bg-accent/10 text-accent border border-accent/20">
                  03 / Display Degradation
                </span>
                <span class="text-xs font-mono text-ink-400">Smart TV / 4K</span>
              </div>
              <h3 class="text-lg font-semibold text-ink-950">
                Low Resolution Scaling
              </h3>
              <p class="text-sm text-ink-600 leading-relaxed">
                Smart TVs display the complete {CANVAS.width} × {CANVAS.height} px artwork. Uploading graphics under 2048 × 1152 px forces YouTube to upscale your image, causing visible artifacting on large screens.
              </p>
            </div>
            <div class="pt-3 border-t border-line-100 text-xs font-mono text-accent">
              Full 16:9 canvas required
            </div>
          </div>
        </div>
      </div>

      <!-- Section 3: Device Crops Breakdown -->
      <div class="border-t border-line-200 pt-16 sm:pt-20 space-y-8">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono font-medium text-accent bg-accent/8 border border-accent/20">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span>Multi-Screen Specs</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-ink-950">
            {dict.footer.guideSafeArea}
          </h2>
          <p class="text-base sm:text-lg text-ink-600 leading-relaxed max-w-3xl">
            YouTube extracts different viewports from a single {CANVAS.width} × {CANVAS.height} px upload. Use this reference to understand what viewers see on each screen.
          </p>
        </div>
        <DeviceCropTable />
      </div>

      <!-- Section 4: Official Specifications -->
      <div class="border-t border-line-200 pt-16 sm:pt-20 space-y-8">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono font-medium text-accent bg-accent/8 border border-accent/20">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span>Technical Standard</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-ink-950">
            {dict.footer.colSpecs}
          </h2>
          <p class="text-base sm:text-lg text-ink-600 leading-relaxed max-w-3xl">
            Standard Google guidelines for channel banner dimensions, file weights, and supported formats.
          </p>
        </div>
        <SpecTable />
      </div>

      <!-- Section 5: Frequently Asked Questions -->
      <div class="border-t border-line-200 pt-16 sm:pt-20 space-y-8">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono font-medium text-accent bg-accent/8 border border-accent/20">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span>Knowledge Base</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-ink-950">
            {dict.home.faqTitle}
          </h2>
          <p class="text-base sm:text-lg text-ink-600 leading-relaxed max-w-3xl">
            Common questions regarding safe area testing, device cutoffs, and YouTube banner diagnostics.
          </p>
        </div>
        <FaqAccordion />
      </div>

      <!-- Section 6: Contextual Interlinking Hub (SEO §3.4) -->
      <div class="border-t border-line-200 pt-16 sm:pt-20">
        <div class="p-8 sm:p-10 rounded-2xl bg-surface-50 border border-line-200 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 shadow-2xs">
          <div class="space-y-2 max-w-2xl">
            <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded text-xs font-mono font-semibold uppercase tracking-wider text-accent bg-accent/10 border border-accent/20">
              Immediate Fix Action
            </div>
            <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-ink-950">
              {dict.tools.checker.handoffTitle}
            </h3>
            <p class="text-sm sm:text-base text-ink-600 leading-relaxed">
              {dict.tools.checker.handoffDesc}
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-3 shrink-0">
            <a
              href={getLocalizedUrl('/tools/youtube-banner-resizer', locale)}
              class="h-11 px-6 rounded-xl bg-accent text-surface-0 text-sm font-semibold hover:bg-accent/90 transition-all shadow-xs inline-flex items-center gap-2"
            >
              <span>{dict.tools.checker.handoffBtn}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
            <a
              href={getLocalizedUrl('/guides/youtube-banner-size', locale)}
              class="h-11 px-6 rounded-xl bg-surface-0 border border-line-200 text-sm font-semibold text-ink-950 hover:bg-surface-100 hover:border-ink-300 transition-all shadow-2xs inline-flex items-center"
            >
              {dict.nav.sizeGuide}
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer currentPath={path} locale={locale} />
</BaseLayout>
