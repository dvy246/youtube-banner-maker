---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToolShell from '../../../components/ToolShell.astro';
import SpecTable from '../../../components/SpecTable.astro';
import DeviceCropTable from '../../../components/DeviceCropTable.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import {
  getSoftwareAppSchema,
  getBreadcrumbSchema,
} from '../../../lib/seo';
import { CANVAS } from '../../../lib/spec';
import {
  TARGET_LOCALES,
  getStaticPageSeo,
  getTranslations,
  getLocalizedUrl,
  type Locale,
} from '../../../i18n';

export async function getStaticPaths() {
  return TARGET_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const path = `/${locale}/tools/youtube-banner-resizer`;
const seo = getStaticPageSeo('/tools/youtube-banner-resizer', locale);
const dict = getTranslations(locale);

const jsonLd = [
  getSoftwareAppSchema(
    dict.tools.resizer.title,
    seo.desc,
    path
  ),
  getBreadcrumbSchema([
    { name: 'Home', url: getLocalizedUrl('/', locale) },
    { name: dict.tools.resizer.title, url: path },
  ]),
];
---

<BaseLayout
  title={seo.title}
  description={seo.desc}
  path={path}
  locale={locale}
  jsonLd={jsonLd}
>
  <Header currentPath={path} locale={locale} />

  <main id="main-content" class="flex-1">
    <!-- Primary Tool Island Mounting Shell -->
    <ToolShell
      mode="fix"
      title={dict.tools.resizer.title}
      intro={dict.tools.resizer.intro}
      locale={locale}
    />

    <!-- Comprehensive Explanatory Content & Supporting Specs -->
    <section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-24 border-t border-line-200 space-y-20 lg:space-y-28">
      <!-- Section 1: How the Resizing Engine Operates -->
      <div class="space-y-8">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono font-medium text-accent bg-accent/8 border border-accent/20">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span>{dict.toolsExtended.resizer.archBadge}</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-ink-950">
            {dict.toolsExtended.resizer.coverFitTitle}
          </h2>
          <p class="text-base sm:text-lg text-ink-600 leading-relaxed max-w-3xl">
            {dict.toolsExtended.resizer.coverFitDesc}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Card 1: Proportional Coverage -->
          <div class="group p-6 sm:p-7 rounded-2xl border border-line-200 bg-surface-0 shadow-2xs hover:shadow-raised hover:border-ink-400/30 transition-all duration-200 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="w-11 h-11 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="3" y1="9" x2="21" y2="9"></line>
                  <line x1="9" y1="21" x2="9" y2="9"></line>
                </svg>
              </div>
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <h3 class="text-base sm:text-lg font-semibold text-ink-950">{dict.toolsExtended.resizer.card1Title}</h3>
                  <span class="text-[10px] font-mono font-medium text-ink-600 uppercase px-2 py-0.5 rounded bg-surface-100 border border-line-200">{dict.toolsExtended.resizer.card1Tag}</span>
                </div>
                <p class="text-sm text-ink-600 leading-relaxed">
                  {dict.toolsExtended.resizer.card1Desc}
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-line-100 text-xs font-mono text-ink-500">
              {dict.toolsExtended.resizer.card1Footer}
            </div>
          </div>

          <!-- Card 2: Clamped Offsets -->
          <div class="group p-6 sm:p-7 rounded-2xl border border-line-200 bg-surface-0 shadow-2xs hover:shadow-raised hover:border-ink-400/30 transition-all duration-200 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="w-11 h-11 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"></circle>
                  <line x1="12" y1="3" x2="12" y2="7"></line>
                  <line x1="12" y1="17" x2="12" y2="21"></line>
                  <line x1="3" y1="12" x2="7" y2="12"></line>
                  <line x1="17" y1="12" x2="21" y2="12"></line>
                </svg>
              </div>
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <h3 class="text-base sm:text-lg font-semibold text-ink-950">{dict.toolsExtended.resizer.card2Title}</h3>
                  <span class="text-[10px] font-mono font-medium text-ink-600 uppercase px-2 py-0.5 rounded bg-surface-100 border border-line-200">{dict.toolsExtended.resizer.card2Tag}</span>
                </div>
                <p class="text-sm text-ink-600 leading-relaxed">
                  {dict.toolsExtended.resizer.card2Desc}
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-line-100 text-xs font-mono text-ink-500">
              {dict.toolsExtended.resizer.card2Footer}
            </div>
          </div>

          <!-- Card 3: 1:1 Resolution Ceiling -->
          <div class="group p-6 sm:p-7 rounded-2xl border border-line-200 bg-surface-0 shadow-2xs hover:shadow-raised hover:border-ink-400/30 transition-all duration-200 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="w-11 h-11 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                </svg>
              </div>
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <h3 class="text-base sm:text-lg font-semibold text-ink-950">{dict.toolsExtended.resizer.card3Title}</h3>
                  <span class="text-[10px] font-mono font-medium text-ink-600 uppercase px-2 py-0.5 rounded bg-surface-100 border border-line-200">{dict.toolsExtended.resizer.card3Tag}</span>
                </div>
                <p class="text-sm text-ink-600 leading-relaxed">
                  {dict.toolsExtended.resizer.card3Desc}
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-line-100 text-xs font-mono text-ink-500">
              {dict.toolsExtended.resizer.card3Footer}
            </div>
          </div>
        </div>
      </div>

      <!-- Section 2: Device Crops Breakdown -->
      <div class="border-t border-line-200 pt-16 sm:pt-20 space-y-8">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono font-medium text-accent bg-accent/8 border border-accent/20">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span>Multi-Screen Specs</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-ink-950">
            {dict.footer.guideSafeArea}
          </h2>
          <p class="text-base sm:text-lg text-ink-600 leading-relaxed max-w-3xl">
            YouTube does not scale down your banner uniformly on smaller screens. Instead, it extracts distinct rectangular cuts from your single uploaded {CANVAS.width} × {CANVAS.height} px image.
          </p>
        </div>
        <DeviceCropTable locale={locale} />
      </div>

      <!-- Section 3: Official Specifications -->
      <div class="border-t border-line-200 pt-16 sm:pt-20 space-y-8">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono font-medium text-accent bg-accent/8 border border-accent/20">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span>Technical Standard</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-ink-950">
            {dict.footer.colSpecs}
          </h2>
          <p class="text-base sm:text-lg text-ink-600 leading-relaxed max-w-3xl">
            Adhering strictly to Google's published channel art guidelines prevents upload rejection and unexpected post-upload cropping.
          </p>
        </div>
        <SpecTable locale={locale} />
      </div>

      <!-- Section 4: Frequently Asked Questions -->
      <div class="border-t border-line-200 pt-16 sm:pt-20 space-y-8">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono font-medium text-accent bg-accent/8 border border-accent/20">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span>Knowledge Base</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-ink-950">
            {dict.home.faqTitle}
          </h2>
          <p class="text-base sm:text-lg text-ink-600 leading-relaxed max-w-3xl">
            Everything you need to know about YouTube channel banner sizing, safe areas, and image compression.
          </p>
        </div>
        <FaqAccordion locale={locale} />
      </div>

      <!-- Section 5: Contextual Interlinking Hub (SEO §3.4) -->
      <div class="border-t border-line-200 pt-16 sm:pt-20">
        <div class="p-8 sm:p-10 rounded-2xl bg-surface-50 border border-line-200 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 shadow-2xs">
          <div class="space-y-2 max-w-2xl">
            <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded text-xs font-mono font-semibold uppercase tracking-wider text-accent bg-accent/10 border border-accent/20">
              {dict.toolsExtended.resizer.nextStepBadge}
            </div>
            <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-ink-950">
              {dict.toolsExtended.resizer.nextStepTitle}
            </h3>
            <p class="text-sm sm:text-base text-ink-600 leading-relaxed">
              {dict.toolsExtended.resizer.nextStepDesc}
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-3 shrink-0">
            <a
              href={getLocalizedUrl('/tools/youtube-banner-checker', locale)}
              class="h-11 px-6 rounded-xl bg-surface-0 border border-line-200 text-sm font-semibold text-ink-950 hover:bg-surface-100 hover:border-ink-300 transition-all shadow-2xs inline-flex items-center gap-2"
            >
              <span>{dict.tools.checker.title}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
            <a
              href={getLocalizedUrl('/guides/youtube-banner-size', locale)}
              class="h-11 px-6 rounded-xl bg-ink-950 text-surface-0 text-sm font-semibold hover:bg-ink-800 transition-colors shadow-xs inline-flex items-center"
            >
              {dict.nav.sizeGuide}
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer currentPath={path} locale={locale} />
</BaseLayout>
