---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import { getBreadcrumbSchema, getFAQSchema, getTechArticleSchema } from '../../../lib/seo';
import { CANVAS, SAFE_PX, MAX_UPLOAD_BYTES } from '../../../lib/spec';
import {
  TARGET_LOCALES,
  LOCALE_CONFIG,
  getStaticPageSeo,
  getTranslations,
  getLocalizedUrl,
  type Locale,
} from '../../../i18n';

export async function getStaticPaths() {
  return TARGET_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const path = `/${locale}/guides/how-to-choose-a-youtube-banner-template`;
const seo = getStaticPageSeo('/guides/how-to-choose-a-youtube-banner-template', locale);
const dict = getTranslations(locale);
const maxUploadMb = Math.round(MAX_UPLOAD_BYTES / (1024 * 1024));

const faqs = [
  {
    question: dict.guideChooseTemplate.faq1Q,
    answer: dict.guideChooseTemplate.faq1A,
  },
  {
    question: dict.guideChooseTemplate.faq2Q,
    answer: dict.guideChooseTemplate.faq2A,
  },
  {
    question: dict.guideChooseTemplate.faq3Q,
    answer: dict.guideChooseTemplate.faq3A,
  },
  {
    question: dict.guideChooseTemplate.faq4Q,
    answer: dict.guideChooseTemplate.faq4A,
  },
  {
    question: dict.guideChooseTemplate.faq5Q,
    answer: dict.guideChooseTemplate.faq5A,
  },
];

const breadcrumbs = [
  { name: dict.common.home, url: getLocalizedUrl('/', locale) },
  { name: dict.nav.templates, url: getLocalizedUrl('/templates', locale) },
  { name: dict.footer.guideBestTemplates, url: path },
];

const jsonLd = [
  getBreadcrumbSchema(breadcrumbs),
  getTechArticleSchema({
    title: seo.title,
    description: seo.desc,
    path,
    datePublished: '2026-03-01T00:00:00Z',
    dateModified: '2026-09-07T00:00:00Z',
    inLanguage: LOCALE_CONFIG[locale]?.htmlLang || 'en-US',
  }),
  getFAQSchema(faqs),
];
---

<BaseLayout
  title={seo.title}
  description={seo.desc}
  path={path}
  locale={locale}
  jsonLd={jsonLd}
>
  <Header currentPath={path} locale={locale} />

  <main id="main-content" class="flex-1">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
      
      <!-- Hero / Header -->
      <header class="space-y-6 border-b border-line-200 pb-10">
        <nav aria-label="Breadcrumb" class="text-xs font-mono text-ink-500 flex items-center gap-2">
          <a href={getLocalizedUrl('/', locale)} class="hover:text-ink-950 transition-colors">{dict.common.home}</a>
          <span class="text-line-200">/</span>
          <a href={getLocalizedUrl('/templates', locale)} class="hover:text-ink-950 transition-colors">{dict.nav.templates}</a>
          <span class="text-line-200">/</span>
          <span class="text-ink-800 font-medium">{dict.footer.guideBestTemplates}</span>
        </nav>

        <div class="space-y-3">
          <span class="inline-block text-xs font-mono uppercase tracking-wider font-semibold text-accent">
            {dict.guideChooseTemplate.kicker}
          </span>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink-950">
            {dict.guideChooseTemplate.title}
          </h1>
          <p class="text-base sm:text-lg text-ink-600 leading-relaxed measure-prose">
            {dict.guideChooseTemplate.subtitle}
          </p>
        </div>

        <!-- E-E-A-T Author & Citation Byline -->
        <div class="flex flex-wrap items-center gap-3 text-xs text-ink-600 border-t border-line-200 pt-4">
          <span>{dict.guideChooseTemplate.byAuthor}</span>
          <span>·</span>
          <span>{dict.guideChooseTemplate.verifiedAgainst} <a href="https://support.google.com/youtube/answer/2657964" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent font-medium">{dict.guideChooseTemplate.officialSpecs}</a></span>
          <span>·</span>
          <span>{dict.guideChooseTemplate.updatedDate}</span>
          <span>·</span>
          <span>{dict.common.privacyBadge}</span>
        </div>

        <!-- Direct Answer Card -->
        <div class="p-6 rounded-2xl border border-accent/20 bg-surface-50 space-y-4">
          <div class="space-y-2">
            <span class="text-xs font-mono uppercase tracking-wider font-bold text-accent">
              {dict.guideChooseTemplate.directAnswerLabel}
            </span>
            <p class="text-base sm:text-lg text-ink-950 font-medium leading-snug">
              {dict.guideChooseTemplate.directAnswerText}
            </p>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-xs border-t border-line-200">
            <div>
              <span class="text-ink-500 block">{dict.guideChooseTemplate.metricSafe}</span>
              <strong class="font-mono text-ink-950 tabular-nums">{SAFE_PX.full.width} × {SAFE_PX.full.height} px</strong>
            </div>
            <div>
              <span class="text-ink-500 block">{dict.guideChooseTemplate.metricContrast}</span>
              <strong class="font-mono text-ink-950">&ge; 4.5:1 WCAG AA</strong>
            </div>
            <div>
              <span class="text-ink-500 block">{dict.guideChooseTemplate.metricAvatar}</span>
              <strong class="font-mono text-ink-950">{dict.guideChooseTemplate.metricAvatarVal}</strong>
            </div>
            <div>
              <span class="text-ink-500 block">{dict.guideChooseTemplate.metricExport}</span>
              <strong class="font-mono text-ink-950 tabular-nums">&le; {maxUploadMb} MB sRGB</strong>
            </div>
          </div>
        </div>
      </header>

      <!-- Section 1: The 5-Point Quality Checklist -->
      <section class="space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            {dict.guideChooseTemplate.s1Kicker}
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            {dict.guideChooseTemplate.s1Title}
          </h2>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            {dict.guideChooseTemplate.s1Desc}
          </p>
        </div>

        <div class="space-y-4">
          <div class="p-5 rounded-2xl border border-line-200 bg-surface-0 space-y-2">
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-full bg-accent/10 text-accent font-mono font-bold text-xs flex items-center justify-center">1</span>
              <h3 class="text-base font-bold text-ink-950">{dict.guideChooseTemplate.item1Title}</h3>
            </div>
            <p class="text-xs sm:text-sm text-ink-600 leading-relaxed measure-prose">
              {dict.guideChooseTemplate.item1Desc.replace('{safeWidth}', String(SAFE_PX.full.width))}
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-line-200 bg-surface-0 space-y-2">
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-full bg-accent/10 text-accent font-mono font-bold text-xs flex items-center justify-center">2</span>
              <h3 class="text-base font-bold text-ink-950">{dict.guideChooseTemplate.item2Title}</h3>
            </div>
            <p class="text-xs sm:text-sm text-ink-600 leading-relaxed measure-prose">
              {dict.guideChooseTemplate.item2Desc}
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-line-200 bg-surface-0 space-y-2">
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-full bg-accent/10 text-accent font-mono font-bold text-xs flex items-center justify-center">3</span>
              <h3 class="text-base font-bold text-ink-950">{dict.guideChooseTemplate.item3Title}</h3>
            </div>
            <p class="text-xs sm:text-sm text-ink-600 leading-relaxed measure-prose">
              {dict.guideChooseTemplate.item3Desc}
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-line-200 bg-surface-0 space-y-2">
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-full bg-accent/10 text-accent font-mono font-bold text-xs flex items-center justify-center">4</span>
              <h3 class="text-base font-bold text-ink-950">{dict.guideChooseTemplate.item4Title}</h3>
            </div>
            <p class="text-xs sm:text-sm text-ink-600 leading-relaxed measure-prose">
              {dict.guideChooseTemplate.item4Desc}
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-line-200 bg-surface-0 space-y-2">
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-full bg-accent/10 text-accent font-mono font-bold text-xs flex items-center justify-center">5</span>
              <h3 class="text-base font-bold text-ink-950">{dict.guideChooseTemplate.item5Title}</h3>
            </div>
            <p class="text-xs sm:text-sm text-ink-600 leading-relaxed measure-prose">
              {dict.guideChooseTemplate.item5Desc.replace('{width}', String(CANVAS.width)).replace('{height}', String(CANVAS.height))}
            </p>
          </div>
        </div>
      </section>

      <!-- Section 2: Niche Template Archetypes -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            {dict.guideChooseTemplate.s2Kicker}
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            {dict.guideChooseTemplate.s2Title}
          </h2>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            {dict.guideChooseTemplate.s2Desc}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
          <!-- Gaming -->
          <div class="p-6 rounded-2xl border border-line-200 bg-surface-0 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-semibold text-accent uppercase tracking-wider">{dict.guideChooseTemplate.nicheGamingCategory}</span>
              <a href={getLocalizedUrl('/templates/gaming', locale)} class="text-xs font-semibold text-ink-950 hover:text-accent">{dict.guideChooseTemplate.nicheGamingBrowse}</a>
            </div>
            <h3 class="text-lg font-bold text-ink-950">{dict.guideChooseTemplate.nicheGamingTitle}</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              {dict.guideChooseTemplate.nicheGamingDesc}
            </p>
          </div>

          <!-- Tech -->
          <div class="p-6 rounded-2xl border border-line-200 bg-surface-0 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-semibold text-accent uppercase tracking-wider">{dict.guideChooseTemplate.nicheTechCategory}</span>
              <a href={getLocalizedUrl('/templates/tech', locale)} class="text-xs font-semibold text-ink-950 hover:text-accent">{dict.guideChooseTemplate.nicheTechBrowse}</a>
            </div>
            <h3 class="text-lg font-bold text-ink-950">{dict.guideChooseTemplate.nicheTechTitle}</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              {dict.guideChooseTemplate.nicheTechDesc}
            </p>
          </div>

          <!-- Podcast -->
          <div class="p-6 rounded-2xl border border-line-200 bg-surface-0 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-semibold text-accent uppercase tracking-wider">{dict.guideChooseTemplate.nichePodcastCategory}</span>
              <a href={getLocalizedUrl('/templates/podcast', locale)} class="text-xs font-semibold text-ink-950 hover:text-accent">{dict.guideChooseTemplate.nichePodcastBrowse}</a>
            </div>
            <h3 class="text-lg font-bold text-ink-950">{dict.guideChooseTemplate.nichePodcastTitle}</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              {dict.guideChooseTemplate.nichePodcastDesc}
            </p>
          </div>

          <!-- Business -->
          <div class="p-6 rounded-2xl border border-line-200 bg-surface-0 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-semibold text-accent uppercase tracking-wider">{dict.guideChooseTemplate.nicheBusinessCategory}</span>
              <a href={getLocalizedUrl('/templates/business', locale)} class="text-xs font-semibold text-ink-950 hover:text-accent">{dict.guideChooseTemplate.nicheBusinessBrowse}</a>
            </div>
            <h3 class="text-lg font-bold text-ink-950">{dict.guideChooseTemplate.nicheBusinessTitle}</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              {dict.guideChooseTemplate.nicheBusinessDesc}
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Customization Playbook -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            {dict.guideChooseTemplate.s3Kicker}
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            {dict.guideChooseTemplate.s3Title}
          </h2>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            {dict.guideChooseTemplate.s3Desc}
          </p>
        </div>

        <div class="space-y-4">
          <div class="p-5 rounded-2xl border border-line-200 bg-surface-0 space-y-2">
            <h3 class="text-sm font-bold text-ink-950">{dict.guideChooseTemplate.step1Title}</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              {dict.guideChooseTemplate.step1Desc}
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-line-200 bg-surface-0 space-y-2">
            <h3 class="text-sm font-bold text-ink-950">{dict.guideChooseTemplate.step2Title}</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              {dict.guideChooseTemplate.step2Desc}
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-line-200 bg-surface-0 space-y-2">
            <h3 class="text-sm font-bold text-ink-950">{dict.guideChooseTemplate.step3Title}</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              {dict.guideChooseTemplate.step3Desc}
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-line-200 bg-surface-0 space-y-2">
            <h3 class="text-sm font-bold text-ink-950">{dict.guideChooseTemplate.step4Title}</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              {dict.guideChooseTemplate.step4Desc}
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-line-200 bg-surface-0 space-y-2">
            <h3 class="text-sm font-bold text-ink-950">{dict.guideChooseTemplate.step5Title}</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              {dict.guideChooseTemplate.step5Desc.replace('{width}', String(CANVAS.width)).replace('{height}', String(CANVAS.height))}
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Companion Guide Cross-Link -->
      <section class="p-6 sm:p-8 rounded-2xl border border-line-200 bg-surface-50 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="space-y-2">
          <span class="text-xs font-mono uppercase tracking-wider font-semibold text-accent">{dict.guideChooseTemplate.companionKicker}</span>
          <h2 class="text-xl font-bold text-ink-950">{dict.guideChooseTemplate.companionTitle}</h2>
          <p class="text-xs sm:text-sm text-ink-600 measure-prose">
            {dict.guideChooseTemplate.companionDesc}
          </p>
        </div>
        <a
          href={getLocalizedUrl('/guides/how-to-make-a-youtube-banner', locale)}
          class="h-10 px-5 rounded-full bg-ink-950 text-surface-0 hover:bg-ink-800 text-xs font-medium inline-flex items-center gap-1.5 transition-all shadow-xs active:scale-[0.98] shrink-0"
        >
          <span>{dict.guideChooseTemplate.companionButton}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </section>

      <!-- Section 5: FAQs -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            {dict.guideChooseTemplate.faqKicker}
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            {dict.guideChooseTemplate.faqHeading}
          </h2>
        </div>
        <FaqAccordion faqs={faqs} />
      </section>

      <!-- Section 6: Next Steps / Internal Links Grid -->
      <section class="border-t border-line-200 pt-12 space-y-6">
        <h2 class="text-base font-bold text-ink-950">{dict.guideChooseTemplate.resourcesHeading}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
          <a
            href={getLocalizedUrl('/templates', locale)}
            class="p-4 rounded-xl border border-line-200 bg-surface-0 hover:border-ink-400 hover:shadow-raised transition-all active:scale-[0.98] space-y-1 block"
          >
            <span class="text-xs font-bold text-ink-950 block">{dict.guideChooseTemplate.cardTemplatesTitle}</span>
            <span class="text-xs text-ink-600 block">{dict.guideChooseTemplate.cardTemplatesDesc}</span>
          </a>
          <a
            href={getLocalizedUrl('/tools/youtube-banner-maker', locale)}
            class="p-4 rounded-xl border border-line-200 bg-surface-0 hover:border-ink-400 hover:shadow-raised transition-all active:scale-[0.98] space-y-1 block"
          >
            <span class="text-xs font-bold text-ink-950 block">{dict.guideChooseTemplate.cardMakerTitle}</span>
            <span class="text-xs text-ink-600 block">{dict.guideChooseTemplate.cardMakerDesc}</span>
          </a>
          <a
            href={getLocalizedUrl('/tools/youtube-banner-checker', locale)}
            class="p-4 rounded-xl border border-line-200 bg-surface-0 hover:border-ink-400 hover:shadow-raised transition-all active:scale-[0.98] space-y-1 block"
          >
            <span class="text-xs font-bold text-ink-950 block">{dict.guideChooseTemplate.cardCheckerTitle}</span>
            <span class="text-xs text-ink-600 block">{dict.guideChooseTemplate.cardCheckerDesc}</span>
          </a>
          <a
            href={getLocalizedUrl('/guides/youtube-banner-size', locale)}
            class="p-4 rounded-xl border border-line-200 bg-surface-0 hover:border-ink-400 hover:shadow-raised transition-all active:scale-[0.98] space-y-1 block"
          >
            <span class="text-xs font-bold text-ink-950 block">{dict.guideChooseTemplate.cardSizeTitle}</span>
            <span class="text-xs text-ink-600 block">{dict.guideChooseTemplate.cardSizeDesc}</span>
          </a>
        </div>
      </section>

    </div>
  </main>

  <Footer currentPath={path} locale={locale} />
</BaseLayout>
