---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getBreadcrumbSchema, getFAQSchema, getTechArticleSchema } from '../../../lib/seo';
import {
  TARGET_LOCALES,
  LOCALE_CONFIG,
  getStaticPageSeo,
  getTranslations,
  getLocalizedUrl,
  type Locale,
} from '../../../i18n';

export async function getStaticPaths() {
  return TARGET_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const path = `/${locale}/guides/youtube-banner-background`;
const seo = getStaticPageSeo('/guides/youtube-banner-background', locale);
const dict = getTranslations(locale);

const faqs = [
  {
    question: dict.guideBgPage.faq1Q,
    answer: dict.guideBgPage.faq1A,
  },
  {
    question: dict.guideBgPage.faq2Q,
    answer: dict.guideBgPage.faq2A,
  },
  {
    question: dict.guideBgPage.faq3Q,
    answer: dict.guideBgPage.faq3A,
  },
  {
    question: dict.guideBgPage.faq4Q,
    answer: dict.guideBgPage.faq4A,
  },
];

const breadcrumbs = [
  { name: 'Home', url: getLocalizedUrl('/', locale) },
  { name: 'Guides', url: getLocalizedUrl('/guides/youtube-banner-size', locale) },
  { name: dict.guideBgPage.title, url: path },
];

const jsonLd = [
  getBreadcrumbSchema(breadcrumbs),
  getTechArticleSchema({
    title: seo.title,
    description: seo.desc,
    path,
    datePublished: '2026-03-01T00:00:00Z',
    dateModified: '2026-09-07T00:00:00Z',
    inLanguage: LOCALE_CONFIG[locale]?.htmlLang || 'en-US',
  }),
  getFAQSchema(faqs),
];
---

<BaseLayout 
  title={seo.title} 
  description={seo.desc} 
  path={path}
  locale={locale}
  jsonLd={jsonLd}
>
  <Header currentPath={path} locale={locale} />
  
  <main class="w-full flex flex-col min-h-screen bg-surface-0 pb-20">
    <article class="max-w-4xl mx-auto px-4 sm:px-6 w-full pt-16 sm:pt-24 flex flex-col gap-12 sm:gap-16">
      
      <!-- Hero Header -->
      <header class="flex flex-col items-start gap-4">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-accent/10 border border-accent/20">
          <span class="w-2 h-2 rounded-full bg-accent"></span>
          <span class="text-xs font-bold text-accent tracking-wide uppercase">{dict.guideBgPage.badge}</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink-950 leading-[1.1]">
          {dict.guideBgPage.title}
        </h1>
        <p class="text-lg sm:text-xl text-ink-600 max-w-2xl leading-relaxed mt-2">
          {dict.guideBgPage.subtitle}
        </p>
      </header>

      <AdSlot slotId="guide-top" class="my-2" />

      <!-- Content -->
      <div class="flex flex-col gap-10">
        
        <!-- Section 1 -->
        <section class="flex flex-col gap-4">
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            {dict.guideBgPage.section1Title}
          </h2>
          <div class="prose prose-ink max-w-none">
            <p class="text-ink-600 leading-relaxed">
              {dict.guideBgPage.section1P1}
            </p>
            <p class="text-ink-600 leading-relaxed mt-4">
              {dict.guideBgPage.section1P2}
            </p>
          </div>
        </section>

        <!-- Section 2 -->
        <section class="flex flex-col gap-4">
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            {dict.guideBgPage.section2Title}
          </h2>
          <div class="prose prose-ink max-w-none">
            <p class="text-ink-600 leading-relaxed">
              {dict.guideBgPage.section2P1}
            </p>
            <ul class="list-disc pl-5 mt-4 space-y-2 text-ink-600">
              <li><strong>{dict.guideBgPage.idea1Title}:</strong> {dict.guideBgPage.idea1Text}</li>
              <li><strong>{dict.guideBgPage.idea2Title}:</strong> {dict.guideBgPage.idea2Text}</li>
              <li><strong>{dict.guideBgPage.idea3Title}:</strong> {dict.guideBgPage.idea3Text}</li>
            </ul>
          </div>
        </section>

        <!-- CTA -->
        <section class="bg-surface-50 border border-line-200 rounded-2xl p-6 sm:p-8 flex flex-col gap-5 text-center items-center mt-4 shadow-sm relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-surface-0/50 to-surface-50/50 pointer-events-none"></div>
          <h3 class="text-xl font-bold text-ink-950 relative z-10">{dict.guideBgPage.ctaTitle}</h3>
          <p class="text-ink-600 max-w-lg relative z-10">
            {dict.guideBgPage.ctaDesc}
          </p>
          <a href={getLocalizedUrl('/tools/youtube-banner-maker', locale)} class="relative z-10 h-12 px-8 rounded-full bg-accent text-white font-semibold flex items-center justify-center hover:bg-accent-600 active:scale-[0.98] transition-all shadow-md mt-2">
            {dict.guideBgPage.ctaButton}
          </a>
        </section>
        
        <AdSlot slotId="guide-mid" class="my-4" />

      </div>

      <!-- FAQ Section -->
      <section class="flex flex-col gap-6 pt-4 border-t border-line-200">
        <div class="flex flex-col gap-2">
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            {dict.guideBgPage.faqTitle}
          </h2>
          <p class="text-ink-600">
            {dict.guideBgPage.faqDesc}
          </p>
        </div>
        <FaqAccordion faqs={faqs} />
      </section>

    </article>
  </main>
  
  <Footer currentPath={path} locale={locale} />
</BaseLayout>
