---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SpecTable from '../../../components/SpecTable.astro';
import DeviceCropTable from '../../../components/DeviceCropTable.astro';
import { getBreadcrumbSchema, getFAQSchema, getTechArticleSchema } from '../../../lib/seo';
import { CANVAS, SAFE_PX, MAX_UPLOAD_BYTES } from '../../../lib/spec';
import {
  TARGET_LOCALES,
  getStaticPageSeo,
  getTranslations,
  getLocalizedUrl,
  type Locale,
} from '../../../i18n';

export async function getStaticPaths() {
  return TARGET_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const path = `/${locale}/guides/youtube-banner-size`;
const seo = getStaticPageSeo('/guides/youtube-banner-size', locale);
const dict = getTranslations(locale);
const maxUploadMb = Math.round(MAX_UPLOAD_BYTES / (1024 * 1024));

const faqs = [
  {
    question: dict.guideSize.fullCanvas,
    answer: `${dict.guideSize.fullCanvas}: ${CANVAS.width} × ${CANVAS.height} px (16:9). ${dict.guideSize.minUpload}: 2048 × 1152 px. ${dict.guideSize.maxFileSize}: ${maxUploadMb} MB.`,
  },
  {
    question: dict.guideSize.safeArea,
    answer: `${dict.guideSize.safeArea}: ${SAFE_PX.full.width} × ${SAFE_PX.full.height} px.`,
  },
];

const jsonLd = [
  getTechArticleSchema({
    title: seo.title,
    description: seo.desc,
    path,
    datePublished: '2026-01-15',
    dateModified: '2026-03-01',
  }),
  getBreadcrumbSchema([
    { name: 'Home', url: getLocalizedUrl('/', locale) },
    { name: dict.guideSize.title, url: path },
  ]),
  getFAQSchema(faqs),
];
---

<BaseLayout
  title={seo.title}
  description={seo.desc}
  path={path}
  locale={locale}
  jsonLd={jsonLd}
>
  <Header currentPath={path} locale={locale} />

  <main id="main-content" class="flex-1">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
      
      <!-- Header -->
      <header class="space-y-4 border-b border-line-200 pb-10">
        <nav aria-label="Breadcrumb" class="text-xs font-mono text-ink-500 flex items-center gap-2">
          <a href={getLocalizedUrl('/', locale)} class="hover:text-ink-950 transition-colors">Home</a>
          <span class="text-line-200">/</span>
          <span class="text-ink-800 font-medium">{dict.nav.sizeGuide}</span>
        </nav>
        <span class="inline-block text-xs font-mono uppercase tracking-wider font-semibold text-accent">
          {dict.footer.colGuides}
        </span>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink-950">
          {dict.guideSize.title}
        </h1>
        <p class="text-base sm:text-lg text-ink-600 leading-relaxed measure-prose">
          {dict.guideSize.subtitle}
        </p>
      </header>

      <!-- Quick Answer Section -->
      <section class="space-y-4">
        <div class="p-6 rounded-2xl bg-accent/5 border border-accent/20 space-y-3">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-accent">
            {dict.guideSize.quickAnswerTitle}
          </span>
          <p class="text-lg font-semibold text-ink-950">
            {CANVAS.width} × {CANVAS.height} px (16:9)
          </p>
          <p class="text-xs text-ink-600 leading-relaxed measure-prose">
            {dict.home.metaDesc}
          </p>
        </div>
      </section>

      <!-- Full Spec Table -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            {dict.home.specsTitle}
          </h2>
          <p class="text-xs text-ink-600 leading-relaxed">
            {dict.home.specsDesc}
          </p>
        </div>
        <SpecTable />
      </section>

      <!-- Device Crops Table -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            {dict.home.simHeading}
          </h2>
          <p class="text-xs text-ink-600 leading-relaxed">
            {dict.home.simSub}
          </p>
        </div>
        <DeviceCropTable />
      </section>

      <!-- Action Box -->
      <section class="p-6 rounded-2xl border border-line-200 bg-surface-50 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <h3 class="text-sm font-bold text-ink-950">{dict.home.ctaFix}</h3>
          <p class="text-xs text-ink-600">{dict.tools.resizer.intro}</p>
        </div>
        <a
          href={getLocalizedUrl('/tools/youtube-banner-resizer', locale)}
          class="h-10 px-5 rounded-lg bg-ink-950 text-surface-0 hover:bg-ink-800 text-xs font-semibold inline-flex items-center gap-1.5 transition-colors shrink-0 shadow-xs"
        >
          <span>{dict.common.launchResizer}</span>
          <span aria-hidden="true">→</span>
        </a>
      </section>

    </div>
  </main>

  <Footer currentPath={path} locale={locale} />
</BaseLayout>
