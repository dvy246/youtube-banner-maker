---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import { getBreadcrumbSchema, getFAQSchema, getTechArticleSchema, getHowToSchema } from '../../../lib/seo';
import { CANVAS, SAFE_PX, MAX_UPLOAD_BYTES } from '../../../lib/spec';
import {
  TARGET_LOCALES,
  LOCALE_CONFIG,
  getStaticPageSeo,
  getTranslations,
  getLocalizedUrl,
  type Locale,
} from '../../../i18n';

export async function getStaticPaths() {
  return TARGET_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const path = `/${locale}/guides/how-to-make-a-youtube-banner`;
const seo = getStaticPageSeo('/guides/how-to-make-a-youtube-banner', locale);
const dict = getTranslations(locale);
const maxUploadMb = Math.round(MAX_UPLOAD_BYTES / (1024 * 1024));

const faqs = [
  {
    question: dict.guideHowToMake.faq1Q,
    answer: dict.guideHowToMake.faq1A,
  },
  {
    question: dict.guideHowToMake.faq2Q,
    answer: dict.guideHowToMake.faq2A,
  },
  {
    question: dict.guideHowToMake.faq3Q,
    answer: dict.guideHowToMake.faq3A,
  },
  {
    question: dict.guideHowToMake.faq4Q,
    answer: dict.guideHowToMake.faq4A,
  },
  {
    question: dict.guideHowToMake.faq5Q,
    answer: dict.guideHowToMake.faq5A,
  },
];

const howToSteps = [
  {
    name: dict.guideHowToMake.step1Name,
    text: dict.guideHowToMake.step1P1,
  },
  {
    name: dict.guideHowToMake.step2Name.replace('{width}', String(CANVAS.width)).replace('{height}', String(CANVAS.height)),
    text: dict.guideHowToMake.step2P1
      .replace('{width}', String(CANVAS.width))
      .replace('{height}', String(CANVAS.height))
      .replace('{safeWidth}', String(SAFE_PX.full.width))
      .replace('{safeHeight}', String(SAFE_PX.full.height)),
  },
  {
    name: dict.guideHowToMake.step3Name,
    text: dict.guideHowToMake.step3P1,
  },
  {
    name: dict.guideHowToMake.step4Name,
    text: dict.guideHowToMake.step4P1,
  },
  {
    name: dict.guideHowToMake.step5Name,
    text: dict.guideHowToMake.step5P1,
  },
  {
    name: dict.guideHowToMake.step6Name,
    text: dict.guideHowToMake.step6P1,
  },
];

const breadcrumbs = [
  { name: dict.common.home, url: getLocalizedUrl('/', locale) },
  { name: dict.footer.colGuides, url: getLocalizedUrl('/guides/youtube-banner-size', locale) },
  { name: dict.nav.howToMake, url: path },
];

const jsonLd = [
  getBreadcrumbSchema(breadcrumbs),
  getTechArticleSchema({
    title: seo.title,
    description: seo.desc,
    path,
    datePublished: '2026-03-01T00:00:00Z',
    dateModified: '2026-09-07T00:00:00Z',
    inLanguage: LOCALE_CONFIG[locale]?.htmlLang || 'en-US',
  }),
  getHowToSchema({
    name: dict.guideHowToMake.title,
    description: seo.desc,
    path,
    steps: howToSteps,
  }),
  getFAQSchema(faqs),
];
---

<BaseLayout
  title={seo.title}
  description={seo.desc}
  path={path}
  locale={locale}
  jsonLd={jsonLd}
>
  <Header currentPath={path} locale={locale} />

  <main id="main-content" class="flex-1">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
      
      <!-- Hero / Header -->
      <header class="space-y-6 border-b border-line-200 pb-10">
        <nav aria-label="Breadcrumb" class="text-xs font-mono text-ink-500 flex items-center gap-2">
          <a href={getLocalizedUrl('/', locale)} class="hover:text-ink-950 transition-colors">{dict.common.home}</a>
          <span class="text-line-200">/</span>
          <a href={getLocalizedUrl('/guides/youtube-banner-size', locale)} class="hover:text-ink-950 transition-colors">{dict.footer.colGuides}</a>
          <span class="text-line-200">/</span>
          <span class="text-ink-800 font-medium">{dict.nav.howToMake}</span>
        </nav>

        <div class="space-y-3">
          <span class="inline-block text-xs font-mono uppercase tracking-wider font-semibold text-accent">
            {dict.guideHowToMake.kicker}
          </span>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink-950">
            {dict.guideHowToMake.title}
          </h1>
          <p class="text-base sm:text-lg text-ink-600 leading-relaxed measure-prose">
            {dict.guideHowToMake.subtitle}
          </p>
        </div>

        <!-- E-E-A-T Author & Citation Byline -->
        <div class="flex flex-wrap items-center gap-3 text-xs text-ink-600 border-t border-line-200 pt-4">
          <span>{dict.guideHowToMake.byAuthor}</span>
          <span>·</span>
          <span>{dict.guideHowToMake.verifiedAgainst} <a href="https://support.google.com/youtube/answer/2657964" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent font-medium">{dict.guideHowToMake.officialSpecs}</a></span>
          <span>·</span>
          <span>{dict.guideHowToMake.updatedDate}</span>
          <span>·</span>
          <span>{dict.common.privacyBadge}</span>
        </div>

        <!-- Direct Answer Card -->
        <div class="p-6 rounded-2xl border border-accent/20 bg-surface-50 space-y-4">
          <div class="space-y-2">
            <span class="text-xs font-mono uppercase tracking-wider font-bold text-accent">
              {dict.guideHowToMake.directAnswerLabel}
            </span>
            <p class="text-base sm:text-lg text-ink-950 font-medium leading-snug">
              {dict.guideHowToMake.directAnswerText}
            </p>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-xs border-t border-line-200">
            <div>
              <span class="text-ink-500 block">{dict.guideHowToMake.metricCanvas}</span>
              <strong class="font-mono text-ink-950 tabular-nums">{CANVAS.width} × {CANVAS.height} px</strong>
            </div>
            <div>
              <span class="text-ink-500 block">{dict.guideHowToMake.metricSafe}</span>
              <strong class="font-mono text-ink-950 tabular-nums">{SAFE_PX.full.width} × {SAFE_PX.full.height} px</strong>
            </div>
            <div>
              <span class="text-ink-500 block">{dict.guideHowToMake.metricAspect}</span>
              <strong class="font-mono text-ink-950">{dict.guideHowToMake.metricAspectVal}</strong>
            </div>
            <div>
              <span class="text-ink-500 block">{dict.guideHowToMake.metricSize}</span>
              <strong class="font-mono text-ink-950 tabular-nums">&le; {maxUploadMb} MB sRGB</strong>
            </div>
          </div>
        </div>
      </header>

      <!-- Quick Action Jumpbox -->
      <section class="space-y-4">
        <h2 class="text-sm font-mono uppercase tracking-wider text-ink-500 font-semibold">
          {dict.guideHowToMake.jumpboxHeading}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a
            href={getLocalizedUrl('/tools/youtube-banner-maker', locale)}
            class="p-5 rounded-2xl border border-line-200 bg-surface-0 hover:border-accent hover:shadow-overlay transition-all duration-150 active:scale-[0.98] group flex flex-col justify-between space-y-3"
          >
            <div class="space-y-1.5">
              <span class="text-[11px] font-mono text-accent font-semibold uppercase">{dict.guideHowToMake.jumpboxPath1Tag}</span>
              <h3 class="text-base font-bold text-ink-950 group-hover:text-accent transition-colors">{dict.guideHowToMake.jumpboxPath1Title}</h3>
              <p class="text-xs text-ink-600 leading-relaxed">
                {dict.guideHowToMake.jumpboxPath1Desc}
              </p>
            </div>
            <span class="text-xs font-semibold text-accent inline-flex items-center gap-1">
              {dict.guideHowToMake.jumpboxPath1Cta}
            </span>
          </a>

          <a
            href={getLocalizedUrl('/tools/youtube-banner-resizer', locale)}
            class="p-5 rounded-2xl border border-line-200 bg-surface-0 hover:border-accent hover:shadow-overlay transition-all duration-150 active:scale-[0.98] group flex flex-col justify-between space-y-3"
          >
            <div class="space-y-1.5">
              <span class="text-[11px] font-mono text-accent font-semibold uppercase">{dict.guideHowToMake.jumpboxPath2Tag}</span>
              <h3 class="text-base font-bold text-ink-950 group-hover:text-accent transition-colors">{dict.guideHowToMake.jumpboxPath2Title}</h3>
              <p class="text-xs text-ink-600 leading-relaxed">
                {dict.guideHowToMake.jumpboxPath2Desc.replace('{width}', String(CANVAS.width)).replace('{height}', String(CANVAS.height))}
              </p>
            </div>
            <span class="text-xs font-semibold text-accent inline-flex items-center gap-1">
              {dict.guideHowToMake.jumpboxPath2Cta}
            </span>
          </a>

          <a
            href={getLocalizedUrl('/tools/youtube-banner-checker', locale)}
            class="p-5 rounded-2xl border border-line-200 bg-surface-0 hover:border-accent hover:shadow-overlay transition-all duration-150 active:scale-[0.98] group flex flex-col justify-between space-y-3"
          >
            <div class="space-y-1.5">
              <span class="text-[11px] font-mono text-accent font-semibold uppercase">{dict.guideHowToMake.jumpboxPath3Tag}</span>
              <h3 class="text-base font-bold text-ink-950 group-hover:text-accent transition-colors">{dict.guideHowToMake.jumpboxPath3Title}</h3>
              <p class="text-xs text-ink-600 leading-relaxed">
                {dict.guideHowToMake.jumpboxPath3Desc}
              </p>
            </div>
            <span class="text-xs font-semibold text-accent inline-flex items-center gap-1">
              {dict.guideHowToMake.jumpboxPath3Cta}
            </span>
          </a>
        </div>
      </section>

      <!-- Section 1: The Core Mistake -->
      <section class="space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            {dict.guideHowToMake.s1Kicker}
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            {dict.guideHowToMake.s1Title}
          </h2>
        </div>
        <p class="text-sm text-ink-600 leading-relaxed measure-prose">
          {dict.guideHowToMake.s1P1}
        </p>
        <p class="text-sm text-ink-600 leading-relaxed measure-prose">
          {dict.guideHowToMake.s1P2}
        </p>

        <!-- Comparison Table -->
        <div class="border border-line-200 rounded-2xl overflow-hidden bg-surface-0">
          <div class="px-6 py-4 bg-surface-50 border-b border-line-200">
            <h3 class="text-sm font-semibold text-ink-950">{dict.guideHowToMake.tableHeading}</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-xs text-left">
              <thead class="border-b border-line-200 bg-surface-50/50 text-ink-600 font-mono uppercase tracking-wider">
                <tr>
                  <th class="p-3.5 sm:p-4">{dict.guideHowToMake.colDimension}</th>
                  <th class="p-3.5 sm:p-4 text-danger">{dict.guideHowToMake.colAmateur}</th>
                  <th class="p-3.5 sm:p-4 text-success">{dict.guideHowToMake.colPro}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line-100 text-ink-800">
                <tr>
                  <td class="p-3.5 sm:p-4 font-medium">{dict.guideHowToMake.row1Dimension}</td>
                  <td class="p-3.5 sm:p-4 text-ink-600">{dict.guideHowToMake.row1Amateur}</td>
                  <td class="p-3.5 sm:p-4 font-semibold text-ink-950">{dict.guideHowToMake.row1Pro.replace('{safeWidth}', String(SAFE_PX.full.width)).replace('{safeHeight}', String(SAFE_PX.full.height))}</td>
                </tr>
                <tr>
                  <td class="p-3.5 sm:p-4 font-medium">{dict.guideHowToMake.row2Dimension}</td>
                  <td class="p-3.5 sm:p-4 text-ink-600">{dict.guideHowToMake.row2Amateur}</td>
                  <td class="p-3.5 sm:p-4 font-semibold text-ink-950">{dict.guideHowToMake.row2Pro}</td>
                </tr>
                <tr>
                  <td class="p-3.5 sm:p-4 font-medium">{dict.guideHowToMake.row3Dimension}</td>
                  <td class="p-3.5 sm:p-4 text-ink-600">{dict.guideHowToMake.row3Amateur}</td>
                  <td class="p-3.5 sm:p-4 font-semibold text-ink-950">{dict.guideHowToMake.row3Pro}</td>
                </tr>
                <tr>
                  <td class="p-3.5 sm:p-4 font-medium">{dict.guideHowToMake.row4Dimension}</td>
                  <td class="p-3.5 sm:p-4 text-ink-600">{dict.guideHowToMake.row4Amateur}</td>
                  <td class="p-3.5 sm:p-4 font-semibold text-ink-950">{dict.guideHowToMake.row4Pro}</td>
                </tr>
                <tr>
                  <td class="p-3.5 sm:p-4 font-medium">{dict.guideHowToMake.row5Dimension}</td>
                  <td class="p-3.5 sm:p-4 text-ink-600">{dict.guideHowToMake.row5Amateur}</td>
                  <td class="p-3.5 sm:p-4 font-semibold text-ink-950">{dict.guideHowToMake.row5Pro.replace('{maxUploadMb}', String(maxUploadMb))}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Section 2: 6-Step Masterclass -->
      <section class="space-y-10 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            {dict.guideHowToMake.s2Kicker}
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950">
            {dict.guideHowToMake.s2Title}
          </h2>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            {dict.guideHowToMake.s2Desc}
          </p>
        </div>

        <!-- Step 1 -->
        <div class="p-6 sm:p-8 rounded-2xl border border-line-200 bg-surface-0 space-y-4">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-ink-950 text-surface-0 flex items-center justify-center font-mono font-bold text-xs">
              01
            </span>
            <h3 class="text-lg font-bold text-ink-950">
              {dict.guideHowToMake.step1Title}
            </h3>
          </div>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            {dict.guideHowToMake.step1Desc}
          </p>
          <div class="p-4 rounded-xl bg-surface-50 border border-line-200 space-y-2">
            <span class="text-xs font-mono font-semibold text-accent uppercase">{dict.guideHowToMake.step1FormulaTitle}</span>
            <p class="text-sm font-mono text-ink-950">
              {dict.guideHowToMake.step1Formula}
            </p>
            <p class="text-xs text-ink-600">
              {dict.guideHowToMake.step1FormulaExample}
            </p>
          </div>
          <p class="text-xs text-ink-500 measure-prose">
            {dict.guideHowToMake.step1Hint}
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 sm:p-8 rounded-2xl border border-line-200 bg-surface-0 space-y-4">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-ink-950 text-surface-0 flex items-center justify-center font-mono font-bold text-xs">
              02
            </span>
            <h3 class="text-lg font-bold text-ink-950">
              {dict.guideHowToMake.step2Title.replace('{width}', String(CANVAS.width)).replace('{height}', String(CANVAS.height))}
            </h3>
          </div>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            {dict.guideHowToMake.step2Desc1.replace('{width}', String(CANVAS.width)).replace('{height}', String(CANVAS.height))}
          </p>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            {dict.guideHowToMake.step2Desc2.replace('{safeWidth}', String(SAFE_PX.full.width)).replace('{safeHeight}', String(SAFE_PX.full.height))}
          </p>
          <div class="pt-2">
            <a
              href={getLocalizedUrl('/guides/youtube-banner-safe-area', locale)}
              class="inline-flex items-center gap-1 text-xs font-semibold text-accent hover:underline"
            >
              <span>{dict.guideHowToMake.step2SafeBreakdownLink}</span>
            </a>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="p-6 sm:p-8 rounded-2xl border border-line-200 bg-surface-0 space-y-4">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-ink-950 text-surface-0 flex items-center justify-center font-mono font-bold text-xs">
              03
            </span>
            <h3 class="text-lg font-bold text-ink-950">
              {dict.guideHowToMake.step3Title}
            </h3>
          </div>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            {dict.guideHowToMake.step3Desc}
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-xl border border-line-200 bg-surface-50 space-y-1.5">
              <span class="text-xs font-mono font-semibold text-accent uppercase tracking-wider">{dict.guideHowToMake.archetypeCenterTitle}</span>
              <p class="text-xs text-ink-600 leading-relaxed">
                {dict.guideHowToMake.archetypeCenterDesc}
              </p>
            </div>
            <div class="p-4 rounded-xl border border-line-200 bg-surface-50 space-y-1.5">
              <span class="text-xs font-mono font-semibold text-accent uppercase tracking-wider">{dict.guideHowToMake.archetypeLeftTitle}</span>
              <p class="text-xs text-ink-600 leading-relaxed">
                {dict.guideHowToMake.archetypeLeftDesc}
              </p>
            </div>
            <div class="p-4 rounded-xl border border-line-200 bg-surface-50 space-y-1.5">
              <span class="text-xs font-mono font-semibold text-accent uppercase tracking-wider">{dict.guideHowToMake.archetypeRightTitle}</span>
              <p class="text-xs text-ink-600 leading-relaxed">
                {dict.guideHowToMake.archetypeRightDesc}
              </p>
            </div>
            <div class="p-4 rounded-xl border border-line-200 bg-surface-50 space-y-1.5">
              <span class="text-xs font-mono font-semibold text-accent uppercase tracking-wider">{dict.guideHowToMake.archetypeStackedTitle}</span>
              <p class="text-xs text-ink-600 leading-relaxed">
                {dict.guideHowToMake.archetypeStackedDesc}
              </p>
            </div>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="p-6 sm:p-8 rounded-2xl border border-line-200 bg-surface-0 space-y-4">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-ink-950 text-surface-0 flex items-center justify-center font-mono font-bold text-xs">
              04
            </span>
            <h3 class="text-lg font-bold text-ink-950">
              {dict.guideHowToMake.step4Title}
            </h3>
          </div>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            {dict.guideHowToMake.step4Desc1}
          </p>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            {dict.guideHowToMake.step4Desc2}
          </p>
          <ul class="space-y-2 text-xs sm:text-sm text-ink-800 list-disc pl-5 measure-prose">
            <li>{dict.guideHowToMake.safeguard1}</li>
            <li>{dict.guideHowToMake.safeguard2}</li>
          </ul>
        </div>

        <!-- Step 5 -->
        <div class="p-6 sm:p-8 rounded-2xl border border-line-200 bg-surface-0 space-y-4">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-ink-950 text-surface-0 flex items-center justify-center font-mono font-bold text-xs">
              05
            </span>
            <h3 class="text-lg font-bold text-ink-950">
              {dict.guideHowToMake.step5Title}
            </h3>
          </div>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            {dict.guideHowToMake.step5Desc1}
          </p>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            {dict.guideHowToMake.step5Desc2}
          </p>
        </div>

        <!-- Step 6 -->
        <div class="p-6 sm:p-8 rounded-2xl border border-line-200 bg-surface-0 space-y-4">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-ink-950 text-surface-0 flex items-center justify-center font-mono font-bold text-xs">
              06
            </span>
            <h3 class="text-lg font-bold text-ink-950">
              {dict.guideHowToMake.step6Title}
            </h3>
          </div>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            {dict.guideHowToMake.step6Desc}
          </p>
          <div class="p-4 rounded-xl bg-surface-50 border border-line-200 space-y-2">
            <span class="text-xs font-mono font-semibold text-ink-950">{dict.guideHowToMake.publishHeading}</span>
            <ol class="list-decimal pl-5 text-xs text-ink-700 space-y-1">
              <li>{dict.guideHowToMake.publishStep1}</li>
              <li>{dict.guideHowToMake.publishStep2}</li>
              <li>{dict.guideHowToMake.publishStep3}</li>
              <li>{dict.guideHowToMake.publishStep4}</li>
              <li>{dict.guideHowToMake.publishStep5}</li>
              <li>{dict.guideHowToMake.publishStep6}</li>
            </ol>
          </div>
        </div>
      </section>

      <!-- Section 3: Feature Spotlight -->
      <section class="space-y-6 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            {dict.guideHowToMake.s3Kicker}
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            {dict.guideHowToMake.s3Title}
          </h2>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            {dict.guideHowToMake.s3Desc}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
          <div class="p-6 rounded-2xl border border-line-200 bg-surface-0 space-y-3">
            <div class="w-8 h-8 rounded-lg bg-surface-100 flex items-center justify-center text-accent font-bold font-mono text-sm">
              01
            </div>
            <h3 class="text-base font-bold text-ink-950">{dict.guideHowToMake.pillar1Title}</h3>
            <p class="text-xs text-ink-600 leading-relaxed">
              {dict.guideHowToMake.pillar1Desc}
            </p>
          </div>

          <div class="p-6 rounded-2xl border border-line-200 bg-surface-0 space-y-3">
            <div class="w-8 h-8 rounded-lg bg-surface-100 flex items-center justify-center text-accent font-bold font-mono text-sm">
              02
            </div>
