---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import { getBreadcrumbSchema, getFAQSchema, getTechArticleSchema, getHowToSchema } from '../../../lib/seo';
import { CANVAS, SAFE_PX, MAX_UPLOAD_BYTES } from '../../../lib/spec';
import {
  TARGET_LOCALES,
  getStaticPageSeo,
  getTranslations,
  getLocalizedUrl,
  type Locale,
} from '../../../i18n';

export async function getStaticPaths() {
  return TARGET_LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const path = `/${locale}/guides/how-to-make-a-youtube-banner`;
const seo = getStaticPageSeo('/guides/how-to-make-a-youtube-banner', locale);
const dict = getTranslations(locale);
const maxUploadMb = Math.round(MAX_UPLOAD_BYTES / (1024 * 1024));

const faqs = [
  {
    question: 'How do I make a YouTube banner for free without software?',
    answer: `You can create a free YouTube banner directly in your browser using our local HTML5 YouTube Banner Maker. Select a layout preset, customize your channel title and tagline within the centered ${SAFE_PX.full.width} × ${SAFE_PX.full.height} px mobile safe area, and download a ready-to-upload ${CANVAS.width} × ${CANVAS.height} px PNG file with zero watermarks or registration.`,
  },
  {
    question: 'What is the most critical design rule for a YouTube banner?',
    answer: `The single most critical rule is anchoring all text, logos, faces, and taglines inside the centered ${SAFE_PX.full.width} × ${SAFE_PX.full.height} pixel mobile safe zone. Because over 75% of YouTube channel visits occur on mobile smartphones, any graphics placed outside this central rectangle get cropped away on smaller screens.`,
  },
  {
    question: 'Should I design my YouTube banner in 1920x1080 or 2560x1440?',
    answer: `Always build your canvas at ${CANVAS.width} × ${CANVAS.height} pixels (16:9 ratio). Designing at 1920×1080 will trigger an upload rejection in YouTube Studio because the absolute minimum supported width is 2048 pixels. Starting at ${CANVAS.width} × ${CANVAS.height} preserves clarity across 4K smart TVs and high-density retina laptops.`,
  },
  {
    question: 'How do I keep my banner text readable against busy photo backgrounds?',
    answer: `Use our built-in Contrast Guard ambient scrim or the 1-click Aero Plate frosted glass backplate. These techniques place a subtle semi-transparent vignette or frosted surface behind your typography, ensuring sharp contrast and instant readability regardless of how vibrant or detailed your background image is.`,
  },
  {
    question: 'How do I upload my completed banner to YouTube Studio?',
    answer: `Open YouTube Studio on a computer browser, click "Customization" in the left sidebar, navigate to the "Branding" tab, and select "Change" or "Upload" under Banner Image. Review the crop preview window—which should align with your safe-area layout—and click "Publish" in the top-right corner.`,
  },
];

const howToSteps = [
  {
    name: 'Establish Your Channel Positioning & 3-Second Value Proposition',
    text: 'Formulate a concise tagline combining your target audience, content focus, and upload cadence (under 8 words) to communicate channel value instantly to mobile visitors.',
  },
  {
    name: `Set Up the ${CANVAS.width} × ${CANVAS.height} Canvas & Mobile Safe Zone`,
    text: `Construct a 16:9 canvas at ${CANVAS.width} × ${CANVAS.height} pixels. Center all critical branding elements inside the ${SAFE_PX.full.width} × ${SAFE_PX.full.height} pixel mobile safe rectangle.`,
  },
  {
    name: 'Select a Certified Safe-Snap Layout Archetype',
    text: 'Choose an established compositional structure such as True Center for symmetry, Split-Left or Split-Right for creator portrait pairings, or Stacked for multi-line typography.',
  },
  {
    name: 'Apply Typography Hierarchy & Contrast Defense',
    text: 'Use heavy geometric or display sans-serif typography. Activate the Contrast Guard radial scrim slider or the Aero Plate frosted glass backplate to preserve legibility against background textures.',
  },
  {
    name: 'Embed Vector Social Badges & Generate Matching Avatar',
    text: 'Position official vector brand badges within the safe area and export a coordinated 800×800 pixel channel profile avatar matching the banner color palette.',
  },
  {
    name: 'Test Cross-Device Viewports & Publish via YouTube Studio',
    text: `Inspect the artwork in the YouTube Banner Checker across mobile, tablet, desktop, and TV viewports, then upload the sRGB PNG file directly into YouTube Studio Customization.`,
  },
];

const breadcrumbs = [
  { name: 'Home', url: getLocalizedUrl('/', locale) },
  { name: 'Guides', url: getLocalizedUrl('/guides/youtube-banner-size', locale) },
  { name: dict.nav.howToMake, url: path },
];

const jsonLd = [
  getBreadcrumbSchema(breadcrumbs),
  getTechArticleSchema({
    title: seo.title,
    description: seo.desc,
    path,
    datePublished: '2026-03-01T00:00:00Z',
    dateModified: '2026-09-07T00:00:00Z',
  }),
  getHowToSchema({
    name: 'How to Make a YouTube Banner',
    description: seo.desc,
    path,
    steps: howToSteps,
  }),
  getFAQSchema(faqs),
];
---

<BaseLayout
  title={seo.title}
  description={seo.desc}
  path={path}
  locale={locale}
  jsonLd={jsonLd}
>
  <Header currentPath={path} locale={locale} />

  <main id="main-content" class="flex-1">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
      
      <!-- Hero / Header -->
      <header class="space-y-6 border-b border-line-200 pb-10">
        <nav aria-label="Breadcrumb" class="text-xs font-mono text-ink-500 flex items-center gap-2">
          <a href={getLocalizedUrl('/', locale)} class="hover:text-ink-950 transition-colors">Home</a>
          <span class="text-line-200">/</span>
          <a href={getLocalizedUrl('/guides/youtube-banner-size', locale)} class="hover:text-ink-950 transition-colors">Guides</a>
          <span class="text-line-200">/</span>
          <span class="text-ink-800 font-medium">{dict.nav.howToMake}</span>
        </nav>

        <div class="space-y-3">
          <span class="inline-block text-xs font-mono uppercase tracking-wider font-semibold text-accent">
            CREATOR MASTERCLASS · 2026 EDITION
          </span>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink-950">
            How to Make a YouTube Banner: Step-by-Step Creator Guide
          </h1>
          <p class="text-base sm:text-lg text-ink-600 leading-relaxed measure-prose">
            A comprehensive, battle-tested design framework to build, compose, and export channel art that looks sharp on 4K TVs, desktop monitors, and mobile smartphones without getting cropped.
          </p>
        </div>

        <!-- E-E-A-T Author & Citation Byline -->
        <div class="flex flex-wrap items-center gap-3 text-xs text-ink-600 border-t border-line-200 pt-4">
          <span>By <strong>YouTubeBannerMaker Editorial & Operations Team</strong></span>
          <span>·</span>
          <span>Verified against <a href="https://support.google.com/youtube/answer/2657964" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent font-medium">Official YouTube Studio Specifications</a></span>
          <span>·</span>
          <span>Updated September 2026</span>
          <span>·</span>
          <span>100% Client-Side Privacy</span>
        </div>

        <!-- Direct Answer Card -->
        <div class="p-6 rounded-2xl border border-accent/20 bg-surface-50 space-y-4">
          <div class="space-y-2">
            <span class="text-xs font-mono uppercase tracking-wider font-bold text-accent">
              Direct Summary: How to Make a YouTube Banner
            </span>
            <p class="text-base sm:text-lg text-ink-950 font-medium leading-snug">
              To make an effective YouTube banner, set your canvas to <strong>{CANVAS.width} × {CANVAS.height} pixels</strong> (16:9 ratio) and concentrate your channel name, value proposition, and key portraits inside the central <strong>{SAFE_PX.full.width} × {SAFE_PX.full.height} pixel</strong> mobile safe area. Export an sRGB PNG or JPEG under {maxUploadMb} MB and upload through YouTube Studio Branding.
            </p>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-xs border-t border-line-200">
            <div>
              <span class="text-ink-500 block">Full Canvas</span>
              <strong class="font-mono text-ink-950 tabular-nums">{CANVAS.width} × {CANVAS.height} px</strong>
            </div>
            <div>
              <span class="text-ink-500 block">Mobile Safe Zone</span>
              <strong class="font-mono text-ink-950 tabular-nums">{SAFE_PX.full.width} × {SAFE_PX.full.height} px</strong>
            </div>
            <div>
              <span class="text-ink-500 block">Aspect Ratio</span>
              <strong class="font-mono text-ink-950">16:9 Landscape</strong>
            </div>
            <div>
              <span class="text-ink-500 block">Max File Size</span>
              <strong class="font-mono text-ink-950 tabular-nums">&le; {maxUploadMb} MB sRGB</strong>
            </div>
          </div>
        </div>
      </header>

      <!-- Quick Action Jumpbox -->
      <section class="space-y-4">
        <h2 class="text-sm font-mono uppercase tracking-wider text-ink-500 font-semibold">
          Select Your Creation Path
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a
            href={getLocalizedUrl('/tools/youtube-banner-maker', locale)}
            class="p-5 rounded-2xl border border-line-200 bg-surface-0 hover:border-accent hover:shadow-overlay transition-all duration-150 active:scale-[0.98] group flex flex-col justify-between space-y-3"
          >
            <div class="space-y-1.5">
              <span class="text-[11px] font-mono text-accent font-semibold uppercase">01 · Build From Scratch</span>
              <h3 class="text-base font-bold text-ink-950 group-hover:text-accent transition-colors">YouTube Banner Maker &rarr;</h3>
              <p class="text-xs text-ink-600 leading-relaxed">
                Use our free browser generator with Safe-Snap layout presets, theme harmonizers, and vector badges.
              </p>
            </div>
            <span class="text-xs font-semibold text-accent inline-flex items-center gap-1">
              Launch Studio Free &rarr;
            </span>
          </a>

          <a
            href={getLocalizedUrl('/tools/youtube-banner-resizer', locale)}
            class="p-5 rounded-2xl border border-line-200 bg-surface-0 hover:border-accent hover:shadow-overlay transition-all duration-150 active:scale-[0.98] group flex flex-col justify-between space-y-3"
          >
            <div class="space-y-1.5">
              <span class="text-[11px] font-mono text-accent font-semibold uppercase">02 · Fit Existing Photo</span>
              <h3 class="text-base font-bold text-ink-950 group-hover:text-accent transition-colors">Banner Resizer &rarr;</h3>
              <p class="text-xs text-ink-600 leading-relaxed">
                Upscale and reposition your existing photography or artwork to the official {CANVAS.width}&times;{CANVAS.height} canvas.
              </p>
            </div>
            <span class="text-xs font-semibold text-accent inline-flex items-center gap-1">
              Resize Image Free &rarr;
            </span>
          </a>

          <a
            href={getLocalizedUrl('/tools/youtube-banner-checker', locale)}
            class="p-5 rounded-2xl border border-line-200 bg-surface-0 hover:border-accent hover:shadow-overlay transition-all duration-150 active:scale-[0.98] group flex flex-col justify-between space-y-3"
          >
            <div class="space-y-1.5">
              <span class="text-[11px] font-mono text-accent font-semibold uppercase">03 · Pre-Flight Audit</span>
              <h3 class="text-base font-bold text-ink-950 group-hover:text-accent transition-colors">Safe Area Checker &rarr;</h3>
              <p class="text-xs text-ink-600 leading-relaxed">
                Upload your graphic to test real-time overlays across TV, desktop, tablet, and mobile displays.
              </p>
            </div>
            <span class="text-xs font-semibold text-accent inline-flex items-center gap-1">
              Test Existing Art &rarr;
            </span>
          </a>
        </div>
      </section>

      <!-- Section 1: The Core Mistake -->
      <section class="space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            01 · The Creator Reality Check
          </span>
          <h2 class="text-2xl font-bold tracking-tight text-ink-950">
            Why 80% of Channel Banners Fail on Mobile Devices
          </h2>
        </div>
        <p class="text-sm text-ink-600 leading-relaxed measure-prose">
          Most creators design channel art on a wide desktop screen. They position logos in the top corner, spread social handles across the edges, and add taglines along the bottom.
        </p>
        <p class="text-sm text-ink-600 leading-relaxed measure-prose">
          When a mobile viewer visits the channel, YouTube's layout engine slices away the top, bottom, and side margins. The result: half of the channel name is cut off, social handles disappear completely, and the banner looks broken. Over 75% of YouTube traffic occurs on mobile devices, making mobile framing the primary design constraint.
        </p>

        <!-- Comparison Table -->
        <div class="border border-line-200 rounded-2xl overflow-hidden bg-surface-0">
          <div class="px-6 py-4 bg-surface-50 border-b border-line-200">
            <h3 class="text-sm font-semibold text-ink-950">Amateur vs. Production-Grade Channel Art</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-xs text-left">
              <thead class="border-b border-line-200 bg-surface-50/50 text-ink-600 font-mono uppercase tracking-wider">
                <tr>
                  <th class="p-3.5 sm:p-4">Design Dimension</th>
                  <th class="p-3.5 sm:p-4 text-danger">Amateur Pattern</th>
                  <th class="p-3.5 sm:p-4 text-success">High-Performing Pro Banner</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line-100 text-ink-800">
                <tr>
                  <td class="p-3.5 sm:p-4 font-medium">Text Placement</td>
                  <td class="p-3.5 sm:p-4 text-ink-600">Scattered to outer edges and corners</td>
                  <td class="p-3.5 sm:p-4 font-semibold text-ink-950">Strictly centered in the {SAFE_PX.full.width} &times; {SAFE_PX.full.height} px safe area</td>
                </tr>
                <tr>
                  <td class="p-3.5 sm:p-4 font-medium">Value Proposition</td>
                  <td class="p-3.5 sm:p-4 text-ink-600">Vague slogans ("Welcome to my life!")</td>
                  <td class="p-3.5 sm:p-4 font-semibold text-ink-950">Concrete promise + upload schedule (&lt;8 words)</td>
                </tr>
                <tr>
                  <td class="p-3.5 sm:p-4 font-medium">Background Contrast</td>
                  <td class="p-3.5 sm:p-4 text-ink-600">Thin white text over busy photo clutter</td>
                  <td class="p-3.5 sm:p-4 font-semibold text-ink-950">Protected with Contrast Guard scrim or Aero Plate frosted glass</td>
                </tr>
                <tr>
                  <td class="p-3.5 sm:p-4 font-medium">Profile Icon Synergy</td>
                  <td class="p-3.5 sm:p-4 text-ink-600">Uncoordinated colors, avatar clashes with banner</td>
                  <td class="p-3.5 sm:p-4 font-semibold text-ink-950">Coordinated 800&times;800 avatar matching the banner palette</td>
                </tr>
                <tr>
                  <td class="p-3.5 sm:p-4 font-medium">Export Gamut</td>
                  <td class="p-3.5 sm:p-4 text-ink-600">Display P3 or CMYK (causes muted color shifts)</td>
                  <td class="p-3.5 sm:p-4 font-semibold text-ink-950">Standard sRGB PNG export (&le; {maxUploadMb} MB)</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Section 2: 6-Step Masterclass -->
      <section class="space-y-10 border-t border-line-200 pt-12">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent">
            02 · Step-by-Step Playbook
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-950">
            The 6-Step Masterclass to Make a YouTube Banner
          </h2>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            Follow this sequential workflow to design channel art that communicates value instantly and renders across every viewing device.
          </p>
        </div>

        <!-- Step 1 -->
        <div class="p-6 sm:p-8 rounded-2xl border border-line-200 bg-surface-0 space-y-4">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-ink-950 text-surface-0 flex items-center justify-center font-mono font-bold text-xs">
              01
            </span>
            <h3 class="text-lg font-bold text-ink-950">
              Define Your Channel Hook & 3-Second Value Proposition
            </h3>
          </div>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            When a viewer lands on your channel page, you have roughly three seconds before they navigate away. Your banner must answer two fundamental questions: <em>Who is this channel for?</em> and <em>What will I gain by subscribing?</em>
          </p>
          <div class="p-4 rounded-xl bg-surface-50 border border-line-200 space-y-2">
            <span class="text-xs font-mono font-semibold text-accent uppercase">The High-Converting Formula</span>
            <p class="text-sm font-mono text-ink-950">
              [Who You Help] + [Specific Result or Topic] &bull; [Upload Cadence]
            </p>
            <p class="text-xs text-ink-600">
              Example: <em>"Actionable Frontend Architecture for Full-Stack Devs &bull; New Videos Every Tuesday"</em>
            </p>
          </div>
          <p class="text-xs text-ink-500 measure-prose">
            Keep your total tagline under eight words. Wordy paragraphs cannot be parsed on a 375-pixel smartphone screen.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 sm:p-8 rounded-2xl border border-line-200 bg-surface-0 space-y-4">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-ink-950 text-surface-0 flex items-center justify-center font-mono font-bold text-xs">
              02
            </span>
            <h3 class="text-lg font-bold text-ink-950">
              Establish the {CANVAS.width} &times; {CANVAS.height} Canvas & Mobile Safe Zone
            </h3>
          </div>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            Never create a YouTube banner at 1920&times;1080 or 1024&times;576. YouTube Studio requires an absolute minimum width of 2048 pixels and recommends exactly <strong>{CANVAS.width} &times; {CANVAS.height} pixels</strong> with a 16:9 ratio.
          </p>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            Within this full canvas, construct a centered bounding box measuring <strong>{SAFE_PX.full.width} &times; {SAFE_PX.full.height} pixels</strong>. This safe area is mathematically centered: 507 pixels from the left and right margins, and 508.5 pixels from the top and bottom margins. All essential branding must stay within this box.
          </p>
          <div class="pt-2">
            <a
              href={getLocalizedUrl('/guides/youtube-banner-safe-area', locale)}
              class="inline-flex items-center gap-1 text-xs font-semibold text-accent hover:underline"
            >
              <span>Explore the complete safe area mathematical breakdown &rarr;</span>
            </a>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="p-6 sm:p-8 rounded-2xl border border-line-200 bg-surface-0 space-y-4">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-ink-950 text-surface-0 flex items-center justify-center font-mono font-bold text-xs">
              03
            </span>
            <h3 class="text-lg font-bold text-ink-950">
              Select a Certified Safe-Snap Layout Archetype
            </h3>
          </div>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            Instead of manually guessing where elements should sit, use one of the four verified layout archetypes built into our <a href={getLocalizedUrl('/tools/youtube-banner-maker', locale)} class="underline text-accent font-medium">YouTube Banner Maker</a>. Each archetype is mathematically constrained within the safe boundary:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-xl border border-line-200 bg-surface-50 space-y-1.5">
              <span class="text-xs font-mono font-semibold text-accent uppercase tracking-wider">&bull; True Center</span>
              <p class="text-xs text-ink-600 leading-relaxed">
                Symmetrical alignment with the channel title anchored at absolute dead center, tagline beneath, and badges centered below. Ideal for tech, minimalist, and educational channels.
              </p>
            </div>
            <div class="p-4 rounded-xl border border-line-200 bg-surface-50 space-y-1.5">
              <span class="text-xs font-mono font-semibold text-accent uppercase tracking-wider">&bull; Split-Left</span>
              <p class="text-xs text-ink-600 leading-relaxed">
                Creator portrait or channel monogram anchored on the left safe boundary, with high-contrast text and social handles stacked on the right.
              </p>
            </div>
            <div class="p-4 rounded-xl border border-line-200 bg-surface-50 space-y-1.5">
              <span class="text-xs font-mono font-semibold text-accent uppercase tracking-wider">&bull; Split-Right</span>
              <p class="text-xs text-ink-600 leading-relaxed">
                Title and upload schedule aligned to the left, with the primary mascot, logo, or cutout positioned on the right safe perimeter. Popular for gaming and lifestyle vloggers.
              </p>
            </div>
            <div class="p-4 rounded-xl border border-line-200 bg-surface-50 space-y-1.5">
              <span class="text-xs font-mono font-semibold text-accent uppercase tracking-wider">&bull; Stacked</span>
              <p class="text-xs text-ink-600 leading-relaxed">
                Clean vertical hierarchy featuring an overarching category kicker, bold channel name, explanatory sub-headline, and horizontal badge strip.
              </p>
            </div>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="p-6 sm:p-8 rounded-2xl border border-line-200 bg-surface-0 space-y-4">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-ink-950 text-surface-0 flex items-center justify-center font-mono font-bold text-xs">
              04
            </span>
            <h3 class="text-lg font-bold text-ink-950">
              Apply Typography Hierarchy & Contrast Defense
            </h3>
          </div>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            The most common design failure on YouTube is low contrast: placing white sans-serif text directly over an intricate photo, gaming screenshot, or gradient background.
          </p>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            To solve this, our studio incorporates two non-destructive contrast safeguards:
          </p>
          <ul class="space-y-2 text-xs sm:text-sm text-ink-800 list-disc pl-5 measure-prose">
            <li>
              <strong>Studio Scrim Slider:</strong> Adds a calibrated radial vignette centered behind the safe zone, darkening peripheral noise while keeping background photography visible.
            </li>
            <li>
              <strong>Aero Plate Frosted Glass:</strong> Renders a subtle backdrop plate behind your typography with a soft border, ensuring high contrast regardless of how bright the underlying imagery is.
            </li>
          </ul>
        </div>

        <!-- Step 5 -->
        <div class="p-6 sm:p-8 rounded-2xl border border-line-200 bg-surface-0 space-y-4">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-ink-950 text-surface-0 flex items-center justify-center font-mono font-bold text-xs">
              05
            </span>
            <h3 class="text-lg font-bold text-ink-950">
              Embed Vector Social Badges & Export Matching 800&times;800 Avatar
            </h3>
          </div>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            Avoid typing messy URLs like <code>instagram.com/mychannel</code>. Viewers cannot click links on a YouTube banner image. Instead, embed clean vector brand icons (YouTube, X, Instagram, TikTok, Discord, Twitch, or Spotify) with your clean handle.
          </p>
          <p class="text-sm text-ink-600 leading-relaxed measure-prose">
            Additionally, your banner and channel avatar must share a visual language. In our <a href={getLocalizedUrl('/tools/youtube-banner-maker', locale)} class="underline text-accent font-medium">YouTube Banner Maker</a>, clicking <strong>"Download 800&times;800 Avatar"</strong> extracts your active color palette, typography styling, and portrait into a matching profile image ready for immediate YouTube Studio upload.
          </p>
        </div>

        <!-- Step 6 -->
        <div class="p-6 sm:p-8 rounded-2xl border border-line-200 bg-surface-0 space-y-4">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-ink-950 text-surface-0 flex items-center justify-center font-mono font-bold text-xs">
              06
            </span>
            <h3 class="text-lg font-bold text-ink-950">
